/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.clarity.ms; img-src 'self' data: https://*.supabase.co https://*.google-analytics.com https://*.clarity.ms; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Link: </llms.txt>; rel="describedby"; type="text/plain"

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Dessins : adresse versionnée par leur contenu (?v=…, lib/fichiers-dessins.ts), cache sans limite
/dessins/*
  Cache-Control: public, max-age=31536000, immutable

# Photos d'illustration : noms stables, cache d'un jour puis revalidation en arrière-plan
/photos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Fichiers pour les assistants IA (docs/decouvrabilite-agents.md)
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/AGENTS.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# Version publiée, relue par le back-office après chaque publication : jamais en cache, jamais indexée
/version.json
  X-Robots-Tag: noindex
  Cache-Control: no-store

/sitemap.xml
  Cache-Control: public, max-age=3600
