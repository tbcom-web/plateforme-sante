  .pied { content-visibility: auto; contain-intrinsic-size: auto 1570px; }
  @media (min-width: 860px) { .pied { contain-intrinsic-size: auto 940px; } }

  /* ———— Registre pédagogique (modèle Simple et pédagogique, jetons.registre) ————
