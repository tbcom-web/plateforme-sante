---
// Gabarit commun à toutes les pages d'un site praticien.
// La présentation suit la fiche du modèle (site.modele) ; tout ce qui sert le SEO est produit ici, quel que soit le modèle.
import { cssEffets, cssFormes, formeDesCartes, jeuEffets } from '@plateforme/core';
import '@fontsource-variable/inter';
// Fraunces : axes graisse + taille optique (droit) et graisse + « wonk » (italique des mots en retrait), soit
// 110 Ko au lieu de 270 Ko pour la version complète ; l'axe SOFT n'est pas chargé (mobile d'abord).
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/wonk-italic.css';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/nunito';
import '@fontsource-variable/geist';
import '@fontsource-variable/public-sans';
// Gabarit « revue » : Bodoni Moda (titres) et Newsreader (texte), droit et italique (mots en retrait, légendes)
import '@fontsource-variable/bodoni-moda/wght.css';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
// Fichiers latins préchargés (texte, titres et leur italique, mono des données), tous visibles dès le haut de
// page : le texte s'affiche tout de suite dans la bonne police, sans décalage quand une police arrive en retard.
import policeInter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import policeFraunces from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import policeManrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import policeSchibsted from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import policeInstrument from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import policeFrauncesItalique from '@fontsource-variable/fraunces/files/fraunces-latin-wonk-italic.woff2?url';
import policeInstrumentItalique from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import policeNunito from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import policeMono from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import policeGeist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import policePublicSans from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import policeBodoni from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url';
import policeBodoniItalique from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-italic.woff2?url';
import policeNewsreader from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import policeNewsreaderItalique from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import Coquille from '../components/gabarits/Coquille.astro';
import Icone from '../components/Icone.astro';
import Logo from '../components/Logo.astro';
import Consent from '../components/Consent.astro';
import EditionApercu from '../components/EditionApercu.astro';
import { APERCU } from '../lib/edition';
import Empreintes from '../components/dessins/Empreintes.astro';
import Dessin from '../components/dessins/Dessin.astro';
import { CONTOUR } from '../components/animations/pied';
import { site, absUrl } from '../lib/site';
import { feuilleCharte, variablesTheme, variablesGabarit, gabaritModele, POLICES, POLICE_MONO, NEUTRES, TRAIT, CSS_TEINTE_GAMME, CSS_TRAME_GAMME } from '@plateforme/core';
import { businessSchema, personSchemas, websiteSchema, pageSchema, breadcrumbSchema } from '../lib/schema';
import { aUneVersionMarkdown, cheminMarkdown } from '../lib/agents';
import { navigation, entreeActive } from '../lib/navigation';
import { motLePlusLong } from '../lib/typo.mjs';
import { photoAccueil, pedagogique, dessinSpecialite } from '../lib/visuels';
import {
  titreMetierAffiche, telLien, itineraire, lienRdv, libelleRdv, titreCabinet, praticiens, lieu, adresseLieu,
  rdvEnLigne, viaPlateforme, localisation, aTelephone, aAdresse, phraseRdv, libelleContact, contactRdv, lienContact,
} from '../lib/textes';

interface Props {
  title: string;
  description: string;
  path: string;
  schemas?: object[];
  noindex?: boolean;
  /** Page à visuel plein écran : l'en-tête peut être transparent (selon le modèle) */
  immersif?: boolean;
  /** Image de partage (og:image) ; par défaut la photo d'accueil */
  image?: { src: string; alt?: string; largeur?: number; hauteur?: number };
  /** Page d'article : og:type article et date de publication */
  article?: { date: string; theme: string };
}

const { title, description, path, schemas = [], noindex = false, immersif = false, image, article } = Astro.props;
const partage = image ?? { src: photoAccueil };
const canonical = absUrl(path);
const m = site.modele;
// Gabarit de mise en page (modeles.ts, GABARITS) : « classique » = rendu historique ; les autres passent par la coquille
// (components/gabarits/Coquille.astro), sans police mono (aucune lecture de données) et avec leurs couleurs --g-* (gabarits.ts).
const gabarit = gabaritModele(m);
const nouveau = gabarit !== 'classique';
const sansMono = pedagogique || nouveau;
// Polices de secours ajustées (size-adjust, ascent/descent-override) : tant qu'une police n'est pas arrivée,
// le texte s'affiche dans une police système recalée sur ses métriques (largeur moyenne, hauteurs), pour
// que la recomposition à l'arrivée de la vraie police ne décale presque rien. Valeurs calculées sur les
// fichiers latins (@capsizecss/unpack) : largeur moyenne de la police ÷ celle de la police système, puis
// recalées sur la largeur mesurée des titres (Fraunces en taille optique 144, Manrope et Schibsted en graisse de titre).
const SANS = { normal: "local('Arial'), local('ArialMT'), local('Helvetica'), local('Liberation Sans'), local('Roboto')", gras: "local('Arial Bold'), local('Arial-BoldMT'), local('Helvetica Bold'), local('Liberation Sans Bold'), local('Roboto Bold')" };
const SERIF = { normal: "local('Times New Roman'), local('TimesNewRomanPSMT'), local('Times'), local('Liberation Serif'), local('Noto Serif')", gras: "local('Times New Roman Bold'), local('TimesNewRomanPS-BoldMT'), local('Times Bold'), local('Liberation Serif Bold')", italique: "local('Times New Roman Italic'), local('TimesNewRomanPS-ItalicMT'), local('Times Italic'), local('Liberation Serif Italic')" };
const MONO = { normal: "local('Courier New'), local('CourierNewPSMT'), local('Courier'), local('Liberation Mono')", gras: "local('Courier New Bold'), local('CourierNewPS-BoldMT'), local('Liberation Mono Bold')" };
type Repli = { sources: { normal: string; gras: string; italique?: string }; taille: number; haut: number; bas: number; italique?: { taille: number; haut: number; bas: number } };
const REPLIS: Record<string, Repli> = {
  'Inter Variable': { sources: SANS, taille: 107.12, haut: 90.44, bas: 22.52 },
  'Manrope Variable': { sources: SANS, taille: 102, haut: 104.5, bas: 29.4 },
  'Schibsted Grotesk Variable': { sources: SANS, taille: 103.5, haut: 94.4, bas: 24.9 },
  'Fraunces Variable': { sources: SERIF, taille: 92, haut: 106.3, bas: 27.7, italique: { taille: 90, haut: 108.7, bas: 28.3 } },
  'Instrument Serif': { sources: SERIF, taille: 83.94, haut: 117.94, bas: 36.93, italique: { taille: 87.95, haut: 112.56, bas: 35.25 } },
  'Nunito Variable': { sources: SANS, taille: 97.8, haut: 103.4, bas: 36.1 },
  'JetBrains Mono Variable': { sources: MONO, taille: 100, haut: 102, bas: 30 },
  // Gabarits tableau et village (mêmes calculs : @capsizecss/unpack sur les fichiers latins)
  'Geist Variable': { sources: SANS, taille: 104.76, haut: 95.93, bas: 28.16 },
  'Public Sans Variable': { sources: SANS, taille: 102.18, haut: 92.97, bas: 22.02 },
  // Gabarit revue (même calcul, repli Times New Roman et son italique)
  'Bodoni Moda Variable': { sources: SERIF, taille: 114.22, haut: 98.5, bas: 35.02, italique: { taille: 106.93, haut: 105.21, bas: 37.41 } },
  'Newsreader Variable': { sources: SERIF, taille: 105.48, haut: 69.68, bas: 25.12, italique: { taille: 98.48, haut: 74.63, bas: 26.91 } },
};
/** Première famille d'une pile : « 'Inter Variable', system-ui » → « Inter Variable ». */
const famille = (pile: string) => pile.match(/'([^']+)'/)?.[1] ?? '';
/** Pile de polices avec la police de secours ajustée juste après la police de la marque. */
const avecRepli = (pile: string) => (REPLIS[famille(pile)] ? pile.replace(/^('[^']+')/, `$1, '${famille(pile)} repli'`) : pile);
const face = (nom: string, src: string, f: { taille: number; haut: number; bas: number }, poids: string, style = 'normal') =>
  `@font-face{font-family:'${nom} repli';src:${src};font-weight:${poids};font-style:${style};font-display:swap;size-adjust:${f.taille}%;ascent-override:${f.haut}%;descent-override:${f.bas}%;line-gap-override:0%}`;
// Registre pédagogique : aucune lecture de données, donc pas de police mono (les rares éléments d'interface en mono —
// fil d'Ariane, « via Doctolib » — prennent la police du texte) : un fichier de police de moins sur mobile.
const piles = sansMono ? [POLICES[m.jetons.policeTexte], POLICES[m.jetons.policeTitres]] : [POLICES[m.jetons.policeTexte], POLICES[m.jetons.policeTitres], POLICE_MONO];
const policesRepli = [...new Set(piles.map(famille))]
  .filter((nom) => REPLIS[nom])
  .map((nom) => {
    const r = REPLIS[nom];
    return [
      face(nom, r.sources.normal, r, '100 549'),
      face(nom, r.sources.gras, r, '550 1000'),
      r.italique && r.sources.italique ? face(nom, r.sources.italique, r.italique, '100 1000', 'italic') : '',
    ].join('');
  })
  .join('');
const transparent = immersif && m.entete === 'transparent';
// Couches 4 et 5 de la charte : gamme (ou couleur libre du cabinet) et jetons du modèle. Les invariants
// (couche 1) sont injectés une seule fois dans l’en-tête du document par feuilleCharte().
const couleurs = [
  ...Object.entries(variablesTheme(m, site.theme)).map(([k, v]) => `${k}:${v}`),
  `--rayon:${m.jetons.rayon}px`,
  `--rayon-grand:${Math.round(m.jetons.rayon * 1.3)}px`,
  `--graisse-titres:${m.jetons.graisseTitres}`,
  `--police-titres:${avecRepli(POLICES[m.jetons.policeTitres])}`,
  `--police-texte:${avecRepli(POLICES[m.jetons.policeTexte])}`,
  `--police-mono:${sansMono ? 'var(--police-texte)' : avecRepli(POLICE_MONO)}`,
  `--rayon-bouton:${{ pilule: '999px', arrondi: '12px', carre: '2px' }[m.jetons.boutons]}`,
  `--voile:${m.accueil.voile / 100}`,
  ...Object.entries(variablesGabarit(m, site.theme)).map(([k, v]) => `${k}:${v}`),
].join(';');
const FICHIERS_POLICES = { inter: policeInter, fraunces: policeFraunces, manrope: policeManrope, schibsted: policeSchibsted, instrument: policeInstrument, nunito: policeNunito, geist: policeGeist, publicsans: policePublicSans, bodoni: policeBodoni, newsreader: policeNewsreader } as const;
// Italique des titres (mots en retrait « .pale » du titre principal) : seulement pour les titres à empattements.
const ITALIQUES: Partial<Record<keyof typeof FICHIERS_POLICES, string>> = { fraunces: policeFrauncesItalique, instrument: policeInstrumentItalique, bodoni: policeBodoniItalique };
// Italique du texte (gabarit revue : chapô et légendes en italique dès le premier écran)
const ITALIQUES_TEXTE: Partial<Record<keyof typeof FICHIERS_POLICES, string>> = { newsreader: policeNewsreaderItalique };
const prechargees = [...new Set([FICHIERS_POLICES[m.jetons.policeTexte], FICHIERS_POLICES[m.jetons.policeTitres], ITALIQUES[m.jetons.policeTitres], ITALIQUES_TEXTE[m.jetons.policeTexte], sansMono ? '' : policeMono].filter(Boolean))];
// Chargement des mêmes polices lancé dès le début du corps de page : un fichier préchargé n'est appliqué
// qu'après décodage, et la première mise en page se ferait sinon avec la police de secours (le texte se
// recompose ensuite et décale la page).
const policesAvantAffichage = [
  `400 1em "${famille(POLICES[m.jetons.policeTexte])}"`,
  `${m.jetons.graisseTitres} 1em "${famille(POLICES[m.jetons.policeTitres])}"`,
  ...(ITALIQUES[m.jetons.policeTitres] ? [`italic ${m.jetons.graisseTitres} 1em "${famille(POLICES[m.jetons.policeTitres])}"`] : []),
  ...(ITALIQUES_TEXTE[m.jetons.policeTexte] ? [`italic 400 1em "${famille(POLICES[m.jetons.policeTexte])}"`] : []),
  ...(sansMono ? [] : [`400 1em "${famille(POLICE_MONO)}"`]),
];
const motif = m.jetons.motif ?? 'plan';
// Motif « courbes de niveau » : contours imbriqués d'une semelle couchée, en filigrane (image SVG en ligne,
// filet de la charte à l'encre de la charte).
const courbes = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='-6 -6 234 104' fill='none' stroke='${NEUTRES.encre}' stroke-opacity='0.11'><g transform='translate(0 92) rotate(-90)'>${
  [1, 0.86, 0.72, 0.58, 0.45, 0.33, 0.22, 0.12].map((e) => `<path d='${CONTOUR}' transform='translate(${(47 * (1 - e)).toFixed(1)} ${(130 * (1 - e)).toFixed(1)}) scale(${e})' stroke-width='${(TRAIT.filet / e).toFixed(2)}'/>`).join('')
}</g></svg>`;
const style = motif === 'courbes' ? `${couleurs};--courbes:url("data:image/svg+xml,${encodeURIComponent(courbes)}")` : couleurs;
// Page ordinaire : nœud WebPage (date de mise à jour) sauf si la page fournit déjà le sien (soin, article).
const typeDe = (s: object) => (s as { '@type'?: string })['@type'] ?? '';
const typePage = schemas.some((s) => ['MedicalWebPage', 'Article', 'WebPage', 'FAQPage'].includes(typeDe(s)));
// Fil d'Ariane : l'accueil (sans fil visible) en a un d'un seul élément, pour situer la page dans le site.
const allSchemas = [
  businessSchema(),
  ...personSchemas(),
  websiteSchema(),
  ...(typePage || noindex ? [] : [pageSchema(title, description, path)]),
  ...schemas,
  ...(noindex || schemas.some((s) => typeDe(s) === 'BreadcrumbList') ? [] : [breadcrumbSchema([{ name: 'Accueil', path: '/' }])]),
];
// Version Markdown de la page pour les assistants IA (/index.md, /soins/x.md…), si elle existe.
const versionMarkdown = !noindex && aUneVersionMarkdown(path) ? cheminMarkdown(path) : null;
const courant = Astro.url.pathname;
// Plus long mot insécable du titre de la page (pédicurie-podologie, noms et villes composés) : les titres se réduisent sur
// petit écran pour qu'il tienne sur une ligne, sans césure ni débordement (lib/typo.mjs, règle --mot-long ci-dessous).
const motLong = Math.min(26, Math.max(12, motLePlusLong(title) + 1));
// Menus calculés par le core (lib/navigation.ts, construireNavigation) : thèmes principaux du praticien, Soins, Le cabinet,
// Infos pratiques ; sur téléphone (tiroir), 3 entrées au plus avec l'Accueil et le bouton de rendez-vous.
const liens = navigation.menu.map((l) => ({ href: l.href, label: l.libelle, cle: l.cle }));
const liensMobile = navigation.menuMobile.map((l) => ({ href: l.href, label: l.libelle }));
const liensPied = navigation.pied.filter((l) => l.cle !== 'accueil').map((l) => ({ href: l.href, label: l.libelle }));
// Entrée active de chaque menu (rubrique de la page courante : thème, Soins, Le cabinet, Infos pratiques), aria-current="page"
const actifMenu = entreeActive(liens, courant);
const actifMobile = entreeActive([{ href: '/' }, ...liensMobile], courant);
const actifPied = entreeActive(liensPied, courant);
const rdvGeneral = site.praticiens.length > 1 && rdvEnLigne ? '/le-cabinet#praticiens' : null;
// Mention « via Doctolib » seulement sur les boutons qui quittent le site (pas vers la liste des praticiens).
const via = rdvGeneral ? '' : viaPlateforme;
// Appel du pied de page : un mot (« Rendez-vous »), la façon de le prendre, puis le bouton. Le logo et le nom du cabinet ne sont
// pas répétés (l'en-tête les porte déjà), et un même texte n'apparaît jamais deux fois : sans lien en ligne ni téléphone, le
// repli « Prise de rendez-vous au cabinet » n'est que sur le bouton (retour de Paul, 2026-10-06).
const precisionRdvBrute = rdvEnLigne ? `En ligne sur ${site.rdv.plateforme}, 24h/24` : aTelephone ? `Au ${site.cabinet.telephone}` : phraseRdv;
const precisionRdv = precisionRdvBrute === libelleRdv ? '' : precisionRdvBrute;
// Jeu d'effets d'une recette du studio (packages/core/src/effets.ts) : CSS seul, en ligne, seulement celui du site.
const effets = jeuEffets(site.theme.effets)?.id ?? '';
// Forme des cartes de soins et de sujets (formes.ts, variante « soins-forme ») : CSS seul, en ligne
const forme = formeDesCartes(site.modele);
---
<!doctype html>
<html lang="fr" style={`${style};--mot-long:${motLong}`} data-modele={m.id} data-titres={m.jetons.policeTitres} data-pied={m.pied} data-images={m.jetons.images} data-motif={motif} data-registre={pedagogique ? 'pedagogique' : 'releve'} data-teinte={m.jetons.teinte} data-trame={m.jetons.teinte === 'gamme' ? undefined : 'gamme'} data-gabarit={nouveau ? gabarit : undefined} data-effets={effets || undefined} data-forme={forme !== 'gabarit' ? forme : undefined} class:list={[{ 'entete-transparent': transparent, 'sans-animations': m.animations === 'aucune' }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.demo || noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />}
    <meta name="theme-color" content={site.theme.couleur} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {prechargees.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.cabinet.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absUrl(partage.src)} />
    {partage.largeur && <meta property="og:image:width" content={String(partage.largeur)} />}
    {partage.hauteur && <meta property="og:image:height" content={String(partage.hauteur)} />}
    {partage.alt && <meta property="og:image:alt" content={partage.alt} />}
    {article && <meta property="article:published_time" content={article.date} />}
    {article && <meta property="article:section" content={article.theme} />}
    <meta name="twitter:card" content="summary_large_image" />
    {versionMarkdown && <link rel="alternate" type="text/markdown" href={versionMarkdown} title="Version Markdown de la page" />}
    <link rel="describedby" type="text/plain" href="/llms.txt" title="Résumé pour les assistants IA" />
    <Fragment set:html={`<style>${feuilleCharte()}${m.jetons.teinte === 'gamme' ? CSS_TEINTE_GAMME : CSS_TRAME_GAMME}${policesRepli}${cssEffets(effets)}${cssFormes(forme)}</style>`} />
    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <script is:inline set:html={`document.fonts&&${JSON.stringify(policesAvantAffichage)}.forEach(function(p){document.fonts.load(p)})`} />
    <a class="evitement" href="#contenu">Aller au contenu</a>

    {site.message && <div class="message" role="status"><Icone nom="lucide:info" />{site.message}</div>}

    {nouveau ? (
      <Coquille courant={courant} rdvGeneral={rdvGeneral}><slot /></Coquille>
    ) : (<>
    {!transparent && <div class="infobarre">
      <div class="cadre infobarre__contenu">
        <span><Icone nom="lucide:map-pin" />{lieu.nom ? `${lieu.nom} — ` : ''}{adresseLieu}</span>
        {aTelephone && <a href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>}
      </div>
    </div>}

    <header class="entete">
      <div class="cadre entete__contenu">
        <Logo />
        <nav class="liens" aria-label="Navigation principale">
          {liens.map((l, i) => <a href={l.href} data-rang={l.cle === 'theme' ? i + 1 : undefined} aria-current={actifMenu === l.href ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <a class="bouton bouton--plein bouton--petit entete__rdv" href={rdvGeneral ?? lienRdv('entete')}>
          {rdvEnLigne ? 'Prendre RDV' : aTelephone ? 'Appeler' : contactRdv === 'email' ? 'Écrire' : 'Rendez-vous'}
        </a>
        <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="tiroir" aria-haspopup="dialog">
          <span class="menu-bouton__traits" aria-hidden="true"></span><span class="menu-bouton__libelle">Menu</span>
        </button>
      </div>
    </header>

    <!-- Menu mobile (sous 960 px) : tiroir plein écran sur fond plan, <dialog> natif (focus et Échap gérés par le navigateur). -->
    <dialog class="tiroir surface-plan" id="tiroir" aria-label="Menu">
      <div class="cadre tiroir__contenu">
        <div class="tiroir__haut">
          <span class="mono">{[titreMetierAffiche, localisation].filter(Boolean).join(' · ')}</span>
          <button class="tiroir__fermer" type="button">Fermer<span aria-hidden="true" class="tiroir__croix"></span></button>
        </div>
        <nav class="tiroir__nav" aria-label="Menu principal">
          <a href="/" aria-current={actifMobile === '/' ? 'page' : undefined}>Accueil</a>
          {liensMobile.map((l) => <a href={l.href} aria-current={actifMobile === l.href ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <div class="tiroir__bas">
          <p>{lieu.nom && <>{lieu.nom}<br /></>}{adresseLieu}</p>
          <a class="bouton bouton--clair" href={rdvGeneral ?? lienRdv('menu')}>{libelleRdv}{via && <span class="via">{via}</span>}</a>
          {rdvEnLigne && aTelephone && <a class="tiroir__tel" href={telLien}>{site.cabinet.telephone}</a>}
        </div>
      </div>
    </dialog>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre">
