---
// Gabarit commun à toutes les pages d'un site praticien.
// La présentation suit la fiche du modèle (site.modele) ; tout ce qui sert le SEO est produit ici, quel que soit le modèle.
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import Icone from '../components/Icone.astro';
import Consent from '../components/Consent.astro';
import Empreintes from '../components/dessins/Empreintes.astro';
import { CONTOUR } from '../components/animations/pied';
import { site, absUrl } from '../lib/site';
import { buildTheme } from '@plateforme/core';
import { businessSchema, personSchema } from '../lib/schema';
import { photoAccueil } from '../lib/visuels';
import {
  titreMetierAffiche, telLien, itineraire, lienRdv, libelleRdv, titreCabinet, praticiens, lieu, adresseLieu,
} from '../lib/textes';

interface Props {
  title: string;
  description: string;
  path: string;
  schemas?: object[];
  noindex?: boolean;
  /** Page à visuel plein écran : l'en-tête peut être transparent (selon le modèle) */
  immersif?: boolean;
  /** Image de partage (og:image) ; par défaut la photo d'accueil */
  image?: { src: string; alt?: string; largeur?: number; hauteur?: number };
  /** Page d'article : og:type article et date de publication */
  article?: { date: string; theme: string };
}

const { title, description, path, schemas = [], noindex = false, immersif = false, image, article } = Astro.props;
const partage = image ?? { src: photoAccueil };
const canonical = absUrl(path);
const theme = buildTheme(site.theme.couleur);
const POLICES = {
  inter: "'Inter Variable', system-ui, sans-serif",
  manrope: "'Manrope Variable', system-ui, sans-serif",
  fraunces: "'Fraunces Variable', Georgia, serif",
  instrument: "'Instrument Serif', Georgia, serif",
  schibsted: "'Schibsted Grotesk Variable', 'Helvetica Neue', Arial, sans-serif",
};
const m = site.modele;
const encre = m.jetons.accent === 'encre';
const transparent = immersif && m.entete === 'transparent';
const couleurs = [
  `--accent:${encre ? '#0b1c24' : theme['--brand-ink']}`,
  `--accent-fonce:${encre ? '#1c3742' : theme['--brand-deep']}`,
  `--accent-vif:${theme['--brand-ink']}`,
  `--accent-pale:${theme['--brand-soft']}`,
  `--accent-tres-pale:${theme['--brand-softer']}`,
  `--accent-ligne:${theme['--brand-line']}`,
  `--rayon:${m.jetons.rayon}px`,
  `--rayon-grand:${Math.round(m.jetons.rayon * 1.3)}px`,
  `--graisse-titres:${m.jetons.graisseTitres}`,
  `--police-titres:${POLICES[m.jetons.policeTitres]}`,
  `--police-texte:${POLICES[m.jetons.policeTexte]}`,
  `--rayon-bouton:${{ pilule: '999px', arrondi: '12px', carre: '2px' }[m.jetons.boutons]}`,
  `--fond:${m.jetons.fond}`,
  `--voile:${m.accueil.voile / 100}`,
  ...(m.jetons.fondDoux ? [`--doux:${m.jetons.fondDoux}`] : []),
  // Surfaces « plan d'architecte » (fond sombre quadrillé) et couleur des lectures de données
  `--plan:${m.jetons.plan ?? `color-mix(in srgb, ${encre ? '#1c3742' : theme['--brand-deep']} 64%, #050f14)`}`,
  `--signal:${m.jetons.signal ?? '#6ff2c2'}`,
].join(';');
const motif = m.jetons.motif ?? 'plan';
// Motif « courbes de niveau » : contours imbriqués d'une semelle couchée, en filigrane (image SVG en ligne).
const courbes = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='-6 -6 234 104' fill='none' stroke='rgb(16,34,36)' stroke-opacity='0.11' stroke-width='0.5'><g transform='translate(0 92) rotate(-90)'>${
  [1, 0.86, 0.72, 0.58, 0.45, 0.33, 0.22, 0.12].map((e) => `<path d='${CONTOUR}' transform='translate(${(47 * (1 - e)).toFixed(1)} ${(130 * (1 - e)).toFixed(1)}) scale(${e})' stroke-width='${(0.5 / e).toFixed(2)}'/>`).join('')
}</g></svg>`;
const style = motif === 'courbes' ? `${couleurs};--courbes:url("data:image/svg+xml,${encodeURIComponent(courbes)}")` : couleurs;
const allSchemas = [businessSchema(), personSchema(), ...schemas];
const courant = Astro.url.pathname;
const liens = [
  { href: '/soins', label: 'Compétences' },
  { href: '/le-cabinet', label: praticiens.length > 1 ? 'Praticiens' : 'Le cabinet' },
  ...(site.articles.length > 0 ? [{ href: '/actualites', label: 'Actualités' }] : []),
  { href: '/acces', label: 'Accès' },
];
const nomMarque = praticiens.length > 1 ? 'Cabinet de podologie' : `${praticiens[0].prenom} ${praticiens[0].nom}`;
const rdvGeneral = site.praticiens.length > 1 && site.rdvMode !== 'telephone' ? '/le-cabinet#praticiens' : null;
---
<!doctype html>
<html lang="fr" style={style} data-modele={m.id} data-titres={m.jetons.policeTitres} data-pied={m.pied} data-images={m.jetons.images} data-motif={motif} class:list={[{ 'entete-transparent': transparent, 'sans-animations': m.animations === 'aucune' }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(site.demo || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.theme.couleur} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.cabinet.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absUrl(partage.src)} />
    {partage.largeur && <meta property="og:image:width" content={String(partage.largeur)} />}
    {partage.hauteur && <meta property="og:image:height" content={String(partage.hauteur)} />}
    {partage.alt && <meta property="og:image:alt" content={partage.alt} />}
    {article && <meta property="article:published_time" content={article.date} />}
    {article && <meta property="article:section" content={article.theme} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé pour les assistants IA" />
    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>

    {site.message && <div class="message" role="status"><Icone nom="lucide:info" />{site.message}</div>}

    {!transparent && <div class="infobarre">
      <div class="cadre infobarre__contenu">
        <span><Icone nom="lucide:map-pin" />{lieu.nom ? `${lieu.nom} — ` : ''}{adresseLieu}</span>
        <a href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>
      </div>
    </div>}

    <header class="entete">
      <div class="cadre entete__contenu">
        <a class="marque" href="/" aria-label={`Accueil — ${titreCabinet}`}>
          <span class="marque__icone"><Icone nom="healthicons:foot-outline" /></span>
          <span class="marque__texte">
            <strong>{nomMarque}</strong>
            <small>{titreMetierAffiche} · {site.cabinet.ville}</small>
          </span>
        </a>
        <nav class="liens" aria-label="Navigation principale">
          {liens.map((l) => <a href={l.href} aria-current={courant.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <a class="bouton bouton--plein bouton--petit entete__rdv" href={rdvGeneral ?? lienRdv('entete')}>
          {site.rdvMode === 'telephone' ? 'Appeler' : 'Prendre RDV'}
        </a>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre">
        <div class="pied__bandeau" aria-hidden="true">
          <span>{titreMetierAffiche}</span>
          <span>{site.cabinet.quartier || site.cabinet.ville}</span>
        </div>
        <div class="pied__haut">
          <div class="pied__gauche">
            <p class="pied__appel">
              {libelleRdv}
              <span>{site.rdvMode !== 'telephone' ? `En ligne sur ${site.rdv.plateforme}, 24h/24` : `Au ${site.cabinet.telephone}`}</span>
            </p>
            <a class="bouton bouton--clair" href={rdvGeneral ?? lienRdv('pied')}>{libelleRdv}</a>
          </div>
          <div class="pied__visuel anime-visible"><Empreintes appui="reparti" /></div>
        </div>
        <div class="pied__grille">
          <div>
            <p class="pied__titre">{titreCabinet}</p>
            <p>{lieu.nom && <>{lieu.nom}<br /></>}{lieu.adresse}{lieu.complement && `, ${lieu.complement}`}<br />{lieu.codePostal} {lieu.ville}</p>
            <p>
              <a href={telLien}>{site.cabinet.telephone}</a>
              {site.cabinet.email && <><br /><a href={`mailto:${site.cabinet.email}`}>{site.cabinet.email}</a></>}
            </p>
          </div>
          <div>
            <p class="pied__titre">{praticiens.length > 1 ? 'Praticiens' : 'Praticien'}</p>
            <ul>
              {praticiens.map((p) => (
                <li><strong>{p.prenom} {p.nom}</strong> — {p.titre}{p.identifiants[0] && <><br /><small>{p.identifiants[0]}</small></>}</li>
              ))}
            </ul>
          </div>
          <div>
            <p class="pied__titre">Navigation</p>
            <ul>
              {liens.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
              <li><a href="/mentions-legales">Mentions légales</a></li>
              {site.pays === 'FR' && <li><a href="https://www.onpp.fr" rel="noopener" target="_blank">Ordre national des pédicures-podologues</a></li>}
            </ul>
          </div>
        </div>
        <div class="pied__bas">
          <span>© {new Date().getFullYear()} {titreCabinet}</span>
          <span>Illustrations : représentations schématiques, sans valeur de mesure</span>
        </div>
      </div>
    </footer>

    <nav class="barre-mobile" aria-label="Accès rapide">
      <a href={telLien}><Icone nom="lucide:phone" />Appeler</a>
      <a href={rdvGeneral ?? lienRdv('barre-mobile')} class="barre-mobile__rdv"><Icone nom="lucide:calendar" />Rendez-vous</a>
      <a href={itineraire} target="_blank" rel="noopener"><Icone nom="lucide:map-pin" />Itinéraire</a>
    </nav>
    <Consent />

    <script>
      // En-tête transparent sur visuel plein écran : opacité progressive au défilement.
      if (document.documentElement.classList.contains('entete-transparent')) {
        const racine = document.documentElement;
        const maj = () => {
          const o = Math.min(window.scrollY / 260, 1);
          racine.style.setProperty('--opacite-entete', String(o));
          racine.classList.toggle('entete-opaque', o > 0.55);
        };
        maj();
        window.addEventListener('scroll', maj, { passive: true });
      }
      // Apparition douce des sections au défilement (désactivée si l'utilisateur réduit les animations).
      if (!document.documentElement.classList.contains('sans-animations') && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vu'); obs.unobserve(e.target); } }),
          { threshold: 0.12 },
        );
        document.querySelectorAll('.apparait').forEach((el) => { el.classList.add('pret'); obs.observe(el); });
      }
      // Animations continues (lignes de scan) : actives seulement quand le bloc est à l'écran.
      if ('IntersectionObserver' in window) {
        const vue = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('en-vue', e.isIntersecting)));
        document.querySelectorAll('.anime-visible').forEach((el) => vue.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --fond: #ffffff;
    --doux: var(--accent-tres-pale, #f3f7f6);
    --encre: #102224;
    --encre-douce: #4d5d5e;
    --encre-pale: #8a9898;
    --ligne: #e3e9e8;
    --rayon: 18px;
    --rayon-grand: 28px;
    --ombre: 0 24px 60px -30px rgb(16 34 36 / 0.35);
    --ombre-profonde: 0 40px 80px -40px rgb(16 34 36 / 0.45), 0 2px 6px -2px rgb(16 34 36 / 0.08);
    --police-mono: 'JetBrains Mono Variable', ui-monospace, 'SFMono-Regular', Consolas, monospace;
    --plan: #123c8c;
    --signal: #6ff2c2;
    /* Alias pour les composants partagés (FAQ, consentement, fil d'Ariane, actualités) */
    --bg: #fff; --line: var(--ligne); --radius: var(--rayon); --brand-ink: var(--accent-vif); --ink-soft: var(--encre-douce);
    --ink: var(--encre); --ink-mute: var(--encre-douce); --shadow: var(--ombre);
    --brand-softer: var(--doux); --brand-soft: var(--accent-pale); --brand-line: var(--accent-ligne);
  }
  [data-modele='premium'] { --encre: #0b1c24; }
  /* Traitement des photos selon le style, pour l'unité graphique (portraits exclus). */
  [data-images='chaud'] main img:not(.praticien__photo) { filter: sepia(0.22) saturate(1.1) hue-rotate(-8deg) contrast(1.02); }
  [data-images='doux'] main img:not(.praticien__photo) { filter: saturate(0.72) brightness(1.06) contrast(0.92); }
  [data-images='contraste'] main img:not(.praticien__photo) { filter: contrast(1.12) saturate(0.88) brightness(0.96); }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: var(--police-texte, 'Inter Variable', system-ui, sans-serif); font-feature-settings: 'ss01', 'cv11'; color: var(--encre); background: var(--fond); font-size: 1.0625rem; line-height: 1.65; -webkit-font-smoothing: antialiased; padding-bottom: 82px; }
  @media (min-width: 900px) { body { padding-bottom: 0; } }
  img { display: block; max-width: 100%; }
  a { color: var(--accent-vif); text-underline-offset: 3px; }
  a:hover { color: var(--accent-fonce); }
  :focus-visible { outline: 3px solid var(--accent-vif); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { line-height: 1.05; letter-spacing: -0.035em; margin: 0; color: var(--encre); text-wrap: balance; font-weight: var(--graisse-titres, 600); font-family: var(--police-titres); }
  [data-titres='fraunces'] h1, [data-titres='fraunces'] h2 { letter-spacing: -0.025em; font-variation-settings: 'SOFT' 50, 'opsz' 144; }
  [data-titres='fraunces'] .pale { font-style: italic; font-variation-settings: 'SOFT' 100, 'WONK' 1; color: var(--accent-vif); }
  [data-titres='instrument'] :is(h1, h2) { letter-spacing: -0.02em; line-height: 1; }
  [data-titres='instrument'] h1 { font-size: clamp(2.9rem, 6.6vw, 5.6rem); }
  [data-titres='instrument'] h2 { font-size: clamp(2.2rem, 4.4vw, 3.6rem); }
  [data-titres='instrument'] .pale { font-style: italic; color: var(--accent-vif); }
  [data-titres='manrope'] :is(h1, h2) { letter-spacing: -0.045em; }
  [data-titres='manrope'] .pale { color: var(--accent-vif); }
  h1 { font-size: clamp(2.4rem, 5.6vw, 4.6rem); letter-spacing: -0.05em; }
  h2 { font-size: clamp(1.9rem, 3.8vw, 3.1rem); margin-bottom: 20px; }
  h3 { font-size: 1.2rem; letter-spacing: -0.02em; line-height: 1.2; }
  p { margin: 0 0 1em; }
  .cadre { width: min(1180px, 100% - 40px); margin-inline: auto; }
  .section { padding-block: clamp(64px, 9vw, 120px); }
  .section--douce { background: var(--doux); }
  .sur { display: inline-flex; align-items: center; gap: 10px; font-size: 0.76rem; font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-vif); margin: 0 0 18px; }
  .sur::before { content: ''; width: 20px; height: 1.5px; background: currentColor; }
  /* Sur-titres numérotés de l'accueil, façon affiche : « 01 — Compétences » */
  main { counter-reset: sur; }
  .sur--num { counter-increment: sur; font-family: var(--police-mono); font-weight: 500; letter-spacing: 0.08em; font-size: 0.74rem; }
  .sur--num::before { content: counter(sur, decimal-leading-zero) ' —'; width: auto; height: auto; background: none; opacity: 0.7; }
  .mono { font-family: var(--police-mono); font-size: 0.74rem; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }

  /* Surfaces graphiques partagées */
  .surface-plan {
    --dessin-trait: #eef3f8; --dessin-accent: var(--signal); --dessin-fond: color-mix(in srgb, var(--plan), #000 30%);
    color: #eef3f8; background-color: var(--plan);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px),
      linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px),
      radial-gradient(120% 90% at 72% 30%, color-mix(in srgb, var(--plan), #fff 14%) 0%, var(--plan) 72%);
    background-size: 96px 96px, 96px 96px, 24px 24px, 24px 24px, 100% 100%;
  }
  .surface-grille {
    background-color: color-mix(in srgb, var(--fond), var(--encre) 2%);
    background-image: linear-gradient(rgb(16 34 36 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(16 34 36 / 0.05) 1px, transparent 1px);
    background-size: 16px 16px; background-position: center;
  }
  /* Texture discrète des sections alternées, selon le motif du modèle (fondue vers le bas à gauche) */
  .section--douce { position: relative; isolation: isolate; }
  .section--douce::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; -webkit-mask-image: radial-gradient(ellipse 70% 80% at 88% 12%, #000 10%, transparent 75%); mask-image: radial-gradient(ellipse 70% 80% at 88% 12%, #000 10%, transparent 75%); }
  [data-motif='plan'] .section--douce::before { background-image: linear-gradient(rgb(16 34 36 / 0.07) 1px, transparent 1px), linear-gradient(90deg, rgb(16 34 36 / 0.07) 1px, transparent 1px), linear-gradient(rgb(16 34 36 / 0.035) 1px, transparent 1px), linear-gradient(90deg, rgb(16 34 36 / 0.035) 1px, transparent 1px); background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px; }
  [data-motif='trame'] .section--douce::before { background-image: radial-gradient(circle, rgb(16 34 36 / 0.13) 1.2px, transparent 1.7px), radial-gradient(circle, rgb(16 34 36 / 0.13) 1.2px, transparent 1.7px); background-size: 16px 13.86px; background-position: 0 0, 8px 6.93px; }
  [data-motif='courbes'] .section--douce::before { background: var(--courbes) no-repeat 92% 30% / min(760px, 90%) auto; -webkit-mask-image: none; mask-image: none; opacity: 0.9; }
  .pale { color: var(--encre-pale); }
  .chapo { color: var(--encre-douce); font-size: 1.12rem; max-width: 58ch; }
  .note { font-size: 0.86rem; color: var(--encre-douce); }
  .entete-section { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 40px; margin-bottom: clamp(32px, 4vw, 56px); }
  .entete-section h2 { margin: 0; max-width: 18ch; }
  .entete-section .chapo { margin: 0; max-width: 46ch; }
  .evitement { position: absolute; left: -9999px; }
  .evitement:focus { left: 16px; top: 16px; z-index: 99; background: #fff; padding: 8px 12px; }

  .bouton, .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 26px; border-radius: var(--rayon-bouton, 999px); font: inherit; font-weight: 600; font-size: 0.98rem; text-decoration: none; border: 0; cursor: pointer; white-space: nowrap; transition: transform 0.25s cubic-bezier(.2,.7,.2,1), background 0.25s; }
  .bouton:hover, .btn:hover { transform: translateY(-1px); }
  .bouton--petit { min-height: 42px; padding: 0 18px; font-size: 0.9rem; }
  .bouton--plein, .btn--primary { background: var(--accent); color: #fff; }
  .bouton--plein:hover, .btn--primary:hover { background: var(--accent-fonce); color: #fff; }
  .bouton--ligne, .btn--ghost { background: transparent; color: var(--encre); box-shadow: inset 0 0 0 1.5px var(--ligne); }
  .bouton--ligne:hover, .btn--ghost:hover { box-shadow: inset 0 0 0 1.5px var(--encre); color: var(--encre); }
  .bouton--clair { background: #fff; color: var(--encre); }
  .bouton--clair:hover { color: var(--encre); }
  .icone { width: 1.1em; height: 1.1em; }

  .message { display: flex; justify-content: center; align-items: center; gap: 8px; padding: 10px 20px; background: var(--accent-vif); color: #fff; font-weight: 600; font-size: 0.95rem; text-align: center; }

  .infobarre { display: none; border-bottom: 1px solid var(--ligne); font-size: 0.82rem; color: var(--encre-douce); }
  @media (min-width: 760px) { .infobarre { display: block; } }
  .infobarre__contenu { display: flex; justify-content: space-between; gap: 20px; padding-block: 9px; }
  .infobarre span, .infobarre a { display: inline-flex; align-items: center; gap: 8px; color: inherit; text-decoration: none; }

  .entete { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--fond) 86%, transparent); backdrop-filter: blur(16px) saturate(1.6); border-bottom: 1px solid var(--ligne); transition: color 0.3s, border-color 0.3s; }
  .entete-transparent .entete { position: fixed; left: 0; right: 0; background: color-mix(in srgb, var(--fond) calc(var(--opacite-entete, 0) * 90%), transparent); border-bottom-color: rgb(16 34 36 / calc(var(--opacite-entete, 0) * 0.1)); backdrop-filter: blur(calc(var(--opacite-entete, 0) * 16px)); }
