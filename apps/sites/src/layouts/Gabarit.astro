  .pied__haut { display: grid; gap: 36px; align-items: center; padding-block: clamp(36px, 5vw, 72px); margin-bottom: 44px; border-bottom: var(--filet) solid var(--pied-ligne); }
  @media (min-width: 860px) { .pied__haut { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); } }
