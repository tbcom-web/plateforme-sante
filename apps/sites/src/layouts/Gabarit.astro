  /* Pied de page : affiche éditoriale sur fond quadrillé (plan d'architecte), filets, lectures en mono. */
  .pied { --pied-ligne: var(--sur-sombre-filet); --pied-quadrillage: var(--quadrillage-sombre-fin); --pied-repere: var(--signal); background-color: var(--pied-fond, var(--encre)); background-image: linear-gradient(var(--pied-quadrillage) var(--filet), transparent var(--filet)), linear-gradient(90deg, var(--pied-quadrillage) var(--filet), transparent var(--filet)); background-size: var(--quadrillage-pas) var(--quadrillage-pas); color: var(--sur-sombre-doux); padding-block: clamp(40px, 5vw, 64px) 28px; font-size: 0.92rem; overflow: hidden; }
