  .pied__titre::before { counter-increment: pied; content: counter(pied, decimal-leading-zero) ' — '; font-family: var(--police-mono); font-weight: 450; font-size: 0.8em; color: var(--pied-repere); }
  .pied ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
  .pied small { color: var(--sur-sombre-pale); }
  .pied__bas { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 48px; padding-top: 16px; border-top: var(--filet-fort) solid var(--pied-ligne); font-family: var(--police-mono); font-size: var(--taille-donnees-petit); letter-spacing: 0.02em; color: var(--sur-sombre-pale); }

  .barre-mobile { position: fixed; z-index: 40; left: 12px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: 8px; padding: 8px; border-radius: 20px; background: rgb(var(--blanc-rgb) / 0.94); backdrop-filter: blur(14px); box-shadow: var(--ombre); }
  .barre-mobile a { display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 48px; border-radius: 14px; font-weight: 600; font-size: 0.9rem; line-height: 1.15; text-decoration: none; color: var(--encre); }
