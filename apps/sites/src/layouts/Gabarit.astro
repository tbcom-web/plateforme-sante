  html[data-registre='pedagogique'] :is(.encart__titre, .materiel-soin__titre, .praticien__statut, .praticien__fiche dt, .article__meta, .horaires__jour, .logo .mono) { text-transform: none; letter-spacing: 0; font-size: 0.9rem; font-weight: 700; }
  /* Numéros décoratifs en mono : retirés (et les grilles qui leur réservaient une colonne, resserrées) */
  html[data-registre='pedagogique'] :is(.faits__num, .tuile__num, .expertise__num, .faq__num, .autres__num, .materiel__num, .faq__compte, .faq__contact .mono, .pied__bandeau, .tiroir__nav a .mono, .tiroir__haut .mono, .materiel__compte) { display: none !important; }
