  }
  /* Couleurs de données réservées aux données : filets de survol et pastilles à l'accent du cabinet */
  html[data-registre='pedagogique'] .expertises li::after, html[data-registre='pedagogique'] .bento a::after { background: var(--accent); }
  html[data-registre='pedagogique'] .praticien__orientations i { background: var(--accent) !important; }
  /* Surfaces : « plan » devient un fond doux clair, « grille » un aplat doux, sans quadrillage */
  html[data-registre='pedagogique'] .surface-plan { --plan: var(--doux); --papier: var(--encre); --signal: var(--accent-vif); --sur-sombre: var(--encre); --sur-sombre-doux: var(--encre-douce); --sur-sombre-pale: var(--encre-pale); --sur-sombre-filet: var(--ligne); --sur-sombre-verre: var(--fond); --dessin-trait: var(--encre); --dessin-accent: var(--accent-vif); --dessin-fond: var(--fond); --dessin-os: var(--accent-vif); color: var(--encre); background-color: var(--doux); background-image: none; }
  html[data-registre='pedagogique'] .surface-grille { background-color: var(--doux); background-image: none; }
