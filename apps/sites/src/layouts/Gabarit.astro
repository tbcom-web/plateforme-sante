    <script>
      // Menu mobile : <dialog> modal (piège du focus, Échap et retour du focus assurés par le navigateur).
      const boutonMenu = document.querySelector<HTMLButtonElement>('.menu-bouton');
      const tiroir = document.querySelector<HTMLDialogElement>('#tiroir');
      if (boutonMenu && tiroir && typeof tiroir.showModal === 'function') {
        const racine = document.documentElement;
        boutonMenu.addEventListener('click', () => {
          tiroir.showModal();
          boutonMenu.setAttribute('aria-expanded', 'true');
          racine.classList.add('tiroir-ouvert');
        });
        tiroir.addEventListener('close', () => {
          boutonMenu.setAttribute('aria-expanded', 'false');
          racine.classList.remove('tiroir-ouvert');
          boutonMenu.focus();
        });
        tiroir.querySelector('.tiroir__fermer')?.addEventListener('click', () => tiroir.close());
        // Lien vers une ancre de la page courante : on referme le tiroir avant de défiler.
        tiroir.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => tiroir.close()));
        matchMedia('(min-width: 960px)').addEventListener('change', (e) => { if (e.matches && tiroir.open) tiroir.close(); });
      }
      // En-tête transparent sur visuel plein écran : opacité progressive au défilement.
      if (document.documentElement.classList.contains('entete-transparent')) {
        const racine = document.documentElement;
        const maj = () => {
          const o = Math.min(window.scrollY / 260, 1);
          racine.style.setProperty('--opacite-entete', String(o));
          racine.classList.toggle('entete-opaque', o > 0.55);
        };
        maj();
        window.addEventListener('scroll', maj, { passive: true });
      }
      // Apparition douce des sections au défilement (désactivée si l'utilisateur réduit les animations).
      if (!document.documentElement.classList.contains('sans-animations') && !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vu'); obs.unobserve(e.target); } }),
          { threshold: 0.12 },
        );
        document.querySelectorAll('.apparait').forEach((el) => { el.classList.add('pret'); obs.observe(el); });
      }
      // Animations continues (lignes de scan, trame de points des relevés) : actives seulement quand le bloc est à l'écran.
      if ('IntersectionObserver' in window) {
        const vue = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('en-vue', e.isIntersecting)));
        document.querySelectorAll('.anime-visible, svg.dessin--releve, svg.heros-theme--releve').forEach((el) => vue.observe(el));
      }
    </script>
