---
import '@fontsource-variable/inter';
import '@fontsource-variable/nunito';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { site, absUrl, rdvHref } from '../lib/site';
import { themeStyle } from '../lib/theme';
import { businessSchema, personSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  schemas?: object[];
}

const { title, description, path, schemas = [] } = Astro.props;
const canonical = absUrl(path);
const allSchemas = [businessSchema(), personSchema(), ...schemas];
---
<!doctype html>
<html lang="fr" data-layout={site.theme.mise_en_page} style={themeStyle(site.theme.couleur)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {site.demo && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.theme.couleur} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.cabinet.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé pour les assistants IA" />
    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <a class="rdv-sticky btn btn--primary" href={rdvHref('mobile-sticky')}>Prendre rendez-vous</a>
    <Consent />
  </body>
</html>

<style>
  .rdv-sticky {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    box-shadow: var(--shadow);
  }
  @media (min-width: 900px) {
    .rdv-sticky { display: none; }
  }
  @media (max-width: 899px) {
    :global(body) { padding-bottom: 88px; }
  }
</style>
