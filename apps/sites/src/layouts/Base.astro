---
import '@fontsource-variable/inter';
import '@fontsource-variable/nunito';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { site, absUrl, rdvHref } from '../lib/site';
import { themeStyle } from '@plateforme/core';
import { businessSchema, personSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  schemas?: object[];
  /** Page à ne pas indexer (ex. page vide). */
  noindex?: boolean;
}

const { title, description, path, schemas = [], noindex = false } = Astro.props;
const canonical = absUrl(path);
const allSchemas = [businessSchema(), personSchema(), ...schemas];
---
<!doctype html>
<html lang="fr" data-layout={site.theme.mise_en_page} style={themeStyle(site.theme.couleur)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(site.demo || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.theme.couleur} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.cabinet.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé pour les assistants IA" />
    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <a class="rdv-sticky btn btn--primary" href={rdvHref('mobile-sticky')}>Prendre rendez-vous</a>
    <script>
      // Le bouton flottant mobile se cache quand un autre bouton « Prendre RDV » est déjà visible.
      const sticky = document.querySelector<HTMLElement>('.rdv-sticky');
      const autres = document.querySelectorAll('main a[href^="/rdv"], footer a[href^="/rdv"]');
      if (sticky && 'IntersectionObserver' in window) {
        const visibles = new Set<Element>();
        const obs = new IntersectionObserver((entrees) => {
          entrees.forEach((e) => (e.isIntersecting ? visibles.add(e.target) : visibles.delete(e.target)));
          sticky.classList.toggle('rdv-sticky--cache', visibles.size > 0);
        });
        autres.forEach((a) => obs.observe(a));
      }
    </script>
    <Consent />
  </body>
</html>

<style>
  .rdv-sticky {
    position: fixed;
    left: 50%;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 40;
    min-height: 44px;
    padding: 0.55em 1.4em;
    font-size: 0.95rem;
    white-space: nowrap;
    box-shadow: 0 6px 20px rgb(16 24 22 / 0.18);
    transform: translateX(-50%);
    transition: transform 0.25s, opacity 0.25s;
  }
  .rdv-sticky--cache {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 140%);
  }
  @media (min-width: 900px) {
    .rdv-sticky { display: none; }
  }
  @media (max-width: 899px) {
    :global(body) { padding-bottom: 72px; }
  }
</style>
