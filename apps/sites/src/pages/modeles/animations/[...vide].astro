---
// Planche des animations d'accueil, générée uniquement sur les sites de démo : /modeles/animations
// Chaque animation en mouvement (fond plan et fond clair), son image fixe (aperçus de l'admin, mouvement
// réduit), son schéma calme du registre pédagogique et sa vignette de liste (~240 px).
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@plateforme/core/dessins.css';
import Animation from '../../../components/animations/Animation.astro';
import { site } from '../../../lib/site';
import { feuilleCharte, GAMMES, variablesGamme, svgAnimationFixe, ANIMATIONS, LIBELLES_ANIMATIONS } from '@plateforme/core';
const accent = Object.entries(variablesGamme(GAMMES[0])).map(([k, v]) => `${k}:${v}`).join(';');

export function getStaticPaths() {
  return site.demo ? [{ params: { vide: undefined } }] : [];
}
---
<!doctype html>
<html lang="fr" style={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Animations d'accueil</title>
    <Fragment set:html={`<style>${feuilleCharte()}</style>`} />
  </head>
  <body>
    <main>
      {ANIMATIONS.map((a) => (
        <section class="ligne">
          <p class="titre">{a} · {LIBELLES_ANIMATIONS[a]}</p>
          <div class="cases">
            <figure class="case surface-plan"><div class="scene"><Animation nom={a} fond="clair" /></div><figcaption>en mouvement · fond plan</figcaption></figure>
            <figure class="case case--claire"><div class="scene"><Animation nom={a} fond="clair" /></div><figcaption>en mouvement · fond clair</figcaption></figure>
            <figure class="case surface-plan"><div class="scene" set:html={svgAnimationFixe(a, { id: `f-${a}` })} /><figcaption>image fixe</figcaption></figure>
            <figure class="case case--claire"><div class="scene" set:html={svgAnimationFixe(a, { id: `p-${a}`, registre: 'pedagogique' })} /><figcaption>registre pédagogique</figcaption></figure>
            <figure class="case case--vignette surface-plan"><div class="scene" set:html={svgAnimationFixe(a, { id: `v-${a}` })} /><figcaption>vignette 240 px</figcaption></figure>
          </div>
        </section>
      ))}
    </main>
    <script is:inline>
      // Planche seule (sans le gabarit) : même règle que Gabarit.astro, le mouvement ne tourne qu'à l'écran.
      if ('IntersectionObserver' in window) {
        const vue = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('en-vue', e.isIntersecting)));
        document.querySelectorAll('.anime-visible').forEach((el) => vue.observe(el));
      }
    </script>
  </body>
</html>

<style>
  body { margin: 0; font-family: 'Inter Variable', system-ui, sans-serif; background: var(--doux-defaut); color: var(--encre); }
  main { display: grid; gap: 28px; padding: 20px; }
  .titre { font-family: var(--police-mono); font-size: var(--taille-donnees); letter-spacing: var(--interlettrage-donnees); text-transform: uppercase; margin: 0 0 10px; }
  .cases { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; align-items: start; }
  .case { margin: 0; border-radius: 18px; overflow: hidden; }
  .case--claire { background: var(--blanc); }
  .case--vignette { width: 240px; }
  .scene { aspect-ratio: 4 / 3; }
  .scene :global(svg), .scene :global(canvas) { display: block; width: 100%; height: 100%; }
  figcaption { font-family: var(--police-mono); font-size: var(--taille-donnees-petit); padding: 8px 12px; opacity: 0.7; }
</style>
