---
import Gabarit from '../../layouts/Gabarit.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqList from '../../components/FaqList.astro';
import Icone from '../../components/Icone.astro';
import { site, md } from '../../lib/site';
import { soinSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';
import { noms, telLien, lienRdv, libelleRdv, lieu, rdvEnLigne } from '../../lib/textes';
import { iconeSoin, ICONE_SOIN_DEFAUT, type Soin } from '@plateforme/core';

export function getStaticPaths() {
  return site.soins.map((soin) => ({ params: { slug: soin.slug }, props: { soin } }));
}

const { soin } = Astro.props as { soin: Soin };
const path = `/soins/${soin.slug}`;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Compétences', path: '/soins' },
  { name: soin.titreCourt, path },
];
const autres = site.soins.filter((s) => s.slug !== soin.slug);
---
<Gabarit
  title={`${soin.titre} – ${noms}`}
  description={soin.resume}
  path={path}
  schemas={[soinSchema(soin), ...(soin.faq.length ? [faqSchema(soin.faq)] : []), breadcrumbSchema(crumbs)]}
>
  <article>
    <header class="section section--douce entete-soin">
      <div class="cadre">
        <Breadcrumb items={crumbs} />
        <div class="titre">
          <span class="titre__icone"><Icone nom={iconeSoin(soin.slug, soin.icone)} secours={ICONE_SOIN_DEFAUT} /></span>
          <h1>{soin.titre}</h1>
        </div>
        <p class="chapo">{soin.resume}</p>
      </div>
    </header>

    <div class="cadre corps">
      <div class="prose" set:html={md(soin.corps)} />
      <aside>
        <div class="encart">
          <p class="encart__titre">Rendez-vous</p>
          <p>{lieu.nom || site.cabinet.nom}<br />{lieu.adresse}, {lieu.codePostal} {lieu.ville}</p>
          <a class="bouton bouton--plein" href={site.praticiens.length > 1 && rdvEnLigne ? '/#praticiens' : lienRdv(`soin-${soin.slug}`)}>{libelleRdv}</a>
          {rdvEnLigne && <a class="bouton bouton--ligne" href={telLien}>{site.cabinet.telephone}</a>}
        </div>
      </aside>
    </div>

    {soin.faq.length > 0 && (
      <section class="section section--douce">
        <div class="cadre">
          <h2>Questions fréquentes</h2>
          <FaqList items={soin.faq} />
        </div>
      </section>
    )}
  </article>

  {autres.length > 0 && (
    <section class="section">
      <div class="cadre">
        <h2>Autres compétences du cabinet</h2>
        <ul class="autres">{autres.map((s) => <li><a href={`/soins/${s.slug}`}>{s.titreCourt}</a></li>)}</ul>
      </div>
    </section>
  )}
</Gabarit>

<style>
  .entete-soin { padding-block: 36px 32px; }
  .titre { display: flex; align-items: center; gap: 16px; }
  .titre__icone { display: grid; place-items: center; flex: none; width: 56px; height: 56px; border-radius: 16px; background: #fff; color: var(--accent); font-size: 2rem; }
  .chapo { margin-top: 14px; }
  .corps { display: grid; gap: 40px; padding-block: 40px 72px; }
  @media (min-width: 960px) { .corps { grid-template-columns: 1fr 320px; } }
  .encart { position: sticky; top: 96px; display: grid; gap: 12px; padding: 24px; border-radius: var(--rayon); border: 1px solid var(--ligne); }
  .encart__titre { font-weight: 700; font-size: 1.1rem; margin: 0; }
  .encart p { margin: 0; color: var(--encre-douce); font-size: 0.95rem; }
  .autres { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 0; }
  .autres a { display: inline-block; padding: 8px 16px; border: 1px solid var(--ligne); border-radius: 999px; text-decoration: none; font-weight: 600; }
  .autres a:hover { background: var(--accent-pale); }
</style>
