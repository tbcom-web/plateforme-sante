---
// Page d'un soin : même langage que l'accueil (en-tête éditorial à filet, sur-titre indexé, visuel du soin
// selon le style visuel : photo, planche ou animation, ou les deux ; source unique : jeu visuel de la spécialité, lib/visuels-soins.ts).
// Titres, textes et données structurées inchangés.
import Gabarit from '../../layouts/Gabarit.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqList from '../../components/FaqList.astro';
import VisuelEntete from '../../components/gabarit/VisuelEntete.astro';
import VignetteSoin from '../../components/gabarit/VignetteSoin.astro';
import { site, md } from '../../lib/site';
import { soinSchema, faqSchema, breadcrumbSchema } from '../../lib/schema';
import { visuelSoin, photoPraticienSoin } from '../../lib/visuels-soins';
import { noms, telLien, lienRdv, libelleRdv, lieu, rdvEnLigne, titreCompetences, viaPlateforme } from '../../lib/textes';
import { espacesFines } from '@plateforme/core';
import type { Soin } from '@plateforme/core';

export function getStaticPaths() {
  return site.soins.map((soin) => ({ params: { slug: soin.slug }, props: { soin } }));
}

const { soin } = Astro.props as { soin: Soin };
const path = `/soins/${soin.slug}`;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Compétences', path: '/soins' },
  { name: soin.titreCourt, path },
];
const deux = (n: number) => String(n).padStart(2, '0');
const rang = site.soins.findIndex((s) => s.slug === soin.slug) + 1;
const total = site.soins.length;
const autres = site.soins.filter((s) => s.slug !== soin.slug);
const visuel = visuelSoin(soin.slug);
---
<Gabarit
  title={`${soin.titre} – ${noms}`}
  description={soin.resume}
  path={path}
  schemas={[soinSchema(soin), ...(soin.faq.length ? [faqSchema(soin.faq)] : []), breadcrumbSchema(crumbs)]}
>
  <article>
    <header class="cadre tete-page">
      <Breadcrumb items={crumbs} />
      <div class="tete-page__grille tete-page__grille--soin">
        <div>
          <p class="sur sur--index"><b aria-hidden="true">{deux(rang)} / {deux(total)} —</b> {titreCompetences}</p>
          <h1>{espacesFines(soin.titre)}</h1>
          <p class="chapo">{soin.resume}</p>
        </div>
        <VisuelEntete photo={visuel.photo} cadrage={visuel.cadrage} dessin={visuel.dessin} animation={visuel.animation} legende={soin.titreCourt} repere={`Fig. ${deux(rang)}`} photoBonne={visuel.photoBonne} photoPraticien={photoPraticienSoin(soin.slug)} altPraticien={`${soin.titreCourt} au cabinet de ${site.cabinet.ville}`} />
      </div>
    </header>

    <div class="cadre corps">
      <div class="prose" set:html={md(soin.corps)} />
      <aside>
        <div class="encart">
          <p class="encart__titre mono">Rendez-vous</p>
          <p class="encart__lieu">{lieu.nom || site.cabinet.nom}<br />{lieu.adresse}, {lieu.codePostal} {lieu.ville}</p>
          <a class="bouton bouton--plein" href={site.praticiens.length > 1 && rdvEnLigne ? '/#praticiens' : lienRdv(`soin-${soin.slug}`)}>{libelleRdv}{!(site.praticiens.length > 1) && viaPlateforme && <span class="via">{viaPlateforme}</span>}</a>
          {rdvEnLigne && <a class="bouton bouton--ligne" href={telLien}>{site.cabinet.telephone}</a>}
        </div>
      </aside>
    </div>

    {soin.faq.length > 0 && (
      <section class="section section--douce">
        <div class="cadre faq">
          <div class="faq__entete">
            <p class="sur sur--num">{soin.titreCourt}</p>
            <h2>Questions fréquentes</h2>
            <p class="faq__compte mono" aria-hidden="true">{deux(soin.faq.length)} questions</p>
          </div>
          <FaqList items={soin.faq} />
        </div>
      </section>
    )}
  </article>

  {autres.length > 0 && (
    <section class="section">
      <div class="cadre">
        <p class="sur sur--num">{titreCompetences}</p>
        <h2>Autres compétences du cabinet</h2>
        <ul class="autres">
          {autres.map((s) => (
            <li>
              <a href={`/soins/${s.slug}`}>
                <span class="autres__num mono" aria-hidden="true">{deux(site.soins.indexOf(s) + 1)}</span>
                <span class="autres__dessin surface-grille" aria-hidden="true"><VignetteSoin slug={s.slug} survol /></span>
                <span class="autres__titre">{s.titreCourt}</span>
                <span class="autres__fleche" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Gabarit>

<style>
  @media (min-width: 960px) { .tete-page__grille--soin { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
  .corps { display: grid; gap: 40px; padding-block: 8px clamp(56px, 8vw, 96px); }
  @media (min-width: 960px) { .corps { grid-template-columns: 1fr 320px; } }
  .encart { position: sticky; top: 96px; display: grid; gap: 12px; padding: 18px 0 0; border-top: var(--filet-fort) solid var(--encre); }
  .encart__titre { margin: 0; color: var(--accent-vif); text-transform: uppercase; letter-spacing: var(--interlettrage-donnees); }
  .encart__lieu { margin: 0 0 6px; color: var(--encre-douce); font-size: 0.95rem; }

  .faq { display: grid; gap: 32px; }
  .faq__compte { margin: 22px 0 0; padding-top: 14px; border-top: var(--filet) solid var(--ligne); color: var(--accent-vif); text-transform: uppercase; letter-spacing: var(--interlettrage-donnees); }
  @media (min-width: 960px) { .faq { grid-template-columns: 0.8fr 1.2fr; align-items: start; } .faq__entete { position: sticky; top: 110px; } }

  .autres { list-style: none; display: grid; gap: 0 28px; padding: 0; margin: 8px 0 0; border-top: var(--filet-fort) solid var(--encre); grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .autres li { border-bottom: var(--filet) solid var(--ligne); }
  .autres a { display: grid; grid-template-columns: 2.2em 84px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 14px 0; text-decoration: none; color: var(--encre); }
  .autres__num { color: var(--encre-pale); }
  .autres__dessin { position: relative; overflow: hidden; display: grid; place-items: center; width: 84px; aspect-ratio: 4 / 3; padding: 4px; border-radius: calc(var(--rayon) * 0.6); box-shadow: inset 0 0 0 var(--filet) var(--ligne); background-color: var(--doux); }
  .autres__titre { font-family: var(--police-titres); font-weight: var(--graisse-titres, 600); font-size: 1.1rem; letter-spacing: -0.02em; line-height: 1.15; }
  .autres__fleche { color: var(--accent-vif); transition: transform var(--duree-court) var(--courbe-sortie); }
  .autres a:hover .autres__fleche { transform: translateX(4px); }
</style>
