---
// Liste des compétences : en-tête éditorial (filet, sur-titre indexé, visuel selon le style visuel) et
// grille bento des soins illustrés comme à l'accueil (dessins, photos ou les deux).
import Gabarit from '../../layouts/Gabarit.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Competences from '../../components/gabarit/Competences.astro';
import VisuelEntete from '../../components/gabarit/VisuelEntete.astro';
import { visuelSoin } from '../../lib/visuels-soins';
import { site } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';
import { titreCompetences, titreCabinet, localisation } from '../../lib/textes';
import TetePage from '../../components/gabarits/TetePage.astro';
import SoinsVariantes from '../../components/gabarits/Soins.astro';
import { nouveauGabarit, variantes } from '../../lib/gabarits';
import SujetsAccueil from '../../components/SujetsAccueil.astro';
import { navigation, soinDuSite } from '../../lib/navigation';
import type { Soin } from '@plateforme/core';

// Soins groupés par thème du praticien (principaux, secondaires, puis « Autres soins ») : chaque soin une seule fois.
const groupes = navigation.groupesSoins.map((g) => ({ ...g, liste: g.soins.map(soinDuSite).filter((s): s is Soin => Boolean(s)) }));
const groupe = groupes.length > 1;

const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Soins', path: '/soins' }];
const total = String(site.soins.length).padStart(2, '0');
// Visuel d'en-tête : celui du bilan (examen qui ouvre toute prise en charge), sans animation.
const bilan = visuelSoin('bilan-podologique');
---
<Gabarit
  title={`${titreCompetences} – ${titreCabinet}`}
  description={`${titreCabinet} : ${site.soins.map((s) => s.titreCourt.toLowerCase()).join(', ')}.`}
  path="/soins"
  schemas={[breadcrumbSchema(crumbs)]}
>
  {nouveauGabarit ? (<>
    <TetePage crumbs={crumbs} sur={localisation} chapo="Chaque prise en charge commence par un échange et un examen, afin de proposer des soins adaptés.">
      <h1 slot="titre">{titreCompetences}</h1>
    </TetePage>
    <section class="g-section g-bloc"><div class="g-cadre g-bloc__dedans"><SujetsAccueil variante="soins" /><SoinsVariantes variante={variantes.soins} complet /></div></section>
  </>) : (<>
  <section class="cadre tete-page">
    <Breadcrumb items={crumbs} />
    <div class="tete-page__grille">
      <div>
        <p class="sur sur--index"><b aria-hidden="true">{total} —</b> {localisation}</p>
        <h1>{titreCompetences}</h1>
        <p class="chapo">Chaque prise en charge commence par un échange et un examen, afin de proposer des soins adaptés.</p>
      </div>
      <VisuelEntete photo={bilan.photo} cadrage={bilan.cadrage} dessin="analyse" legende="Bilan" repere="Fig. 00" liste />
    </div>
  </section>
  <section class="section section--serree">
    <div class="cadre">
      <SujetsAccueil variante="soins" />
      {groupe ? groupes.map((g) => (
        <div class="groupe">
          <p class="sur groupe__titre">{g.href ? <a href={g.href}>{g.titre}</a> : g.titre}</p>
          <Competences soins={g.liste} />
        </div>
      )) : <Competences />}
    </div>
  </section>
  </>)}
</Gabarit>

<style>
  .section--serree { padding-top: 0; }
  .groupe + .groupe { margin-top: clamp(40px, 6vw, 64px); }
  .groupe__titre { margin-bottom: 18px; }
  .groupe__titre a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; }
</style>
