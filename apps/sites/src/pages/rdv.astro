---
// Repli statique (développement local). En production, la fonction Cloudflare
// functions/rdv.js intercepte /rdv, compte le clic puis redirige.
import { site } from '../lib/site';
// Sans lien de rendez-vous utilisable (replis.ts) : la rubrique « Prise de rendez-vous » des informations pratiques.
const cible = site.rdv.url || '/acces#rdv';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${cible}`} />
    <title>Redirection vers {site.rdv.url ? site.rdv.plateforme : 'la prise de rendez-vous'}</title>
  </head>
  <body>
    <p>Redirection vers <a href={cible}>{site.rdv.url ? site.rdv.plateforme : 'la prise de rendez-vous'}</a>…</p>
  </body>
</html>
