---
// Le cabinet : même langage que l'accueil (en-tête éditorial, relevé d'empreintes sur fond plan,
// sur-titres numérotés). Titres, textes et données structurées inchangés.
import Gabarit from '../layouts/Gabarit.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Praticiens from '../components/gabarit/Praticiens.astro';
import Infos from '../components/gabarit/Infos.astro';
import Galerie from '../components/gabarit/Galerie.astro';
import Materiel from '../components/gabarit/Materiel.astro';
import Planche from '../components/dessins/Planche.astro';
import Empreintes from '../components/dessins/Empreintes.astro';
import { site } from '../lib/site';
import { pedagogique, photoLieuAccueil, cadrageLieuAccueil, photoResponsive } from '../lib/visuels';
import { breadcrumbSchema } from '../lib/schema';
import { titreCabinet, phraseAccueil, titrePraticiens, noms, titreMetierAffiche, localisation, suffixeVille } from '../lib/textes';
import TetePage from '../components/gabarits/TetePage.astro';
import PraticiensVariantes from '../components/gabarits/Praticiens.astro';
import VenirAuCabinet from '../components/gabarits/VenirAuCabinet.astro';
import MaterielCabinet from '../components/MaterielCabinet.astro';
import { nouveauGabarit, variantes } from '../lib/gabarits';
import { lieu } from '../lib/textes';

// Rubrique « Matériel et hygiène » : seulement si le praticien a coché du matériel (sinon rien n'apparaît).
const materiel = (site.equipements?.length ?? 0) > 0 || Boolean(site.equipementsAutres?.trim());
// Gabarits tableau et village : la photo du lieu en en-tête seulement si c'est celle du praticien (jamais une photo de banque légendée « le cabinet »).
const photoDuLieu = [site.photos.accueil, site.photos.panorama, ...site.photos.cabinet].filter(Boolean)[0] ?? '';
const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Le cabinet', path: '/le-cabinet' }];
---
<Gabarit
  title={`Le cabinet – ${noms}${site.praticiens.length ? `, ${site.titreMetier.toLowerCase()}` : ''}${suffixeVille}`}
  description={`${titreCabinet}. ${phraseAccueil}`}
  path="/le-cabinet"
  schemas={[breadcrumbSchema(crumbs)]}
>
  {nouveauGabarit ? (<>
    <TetePage crumbs={crumbs} sur={[titreMetierAffiche, localisation].filter(Boolean).join(' · ')} chapo={phraseAccueil}>
      <h1 slot="titre">{titreCabinet}</h1>
      <ul class="g-bulles">
        {site.praticiens.length > 0 && <li><a class="g-bulle g-bulle--texte" href="#praticiens">{titrePraticiens}</a></li>}
        {materiel && <li><a class="g-bulle g-bulle--texte" href="#materiel">Matériel et hygiène</a></li>}
        <li><a class="g-bulle g-bulle--texte" href="#infos">Informations pratiques</a></li>
      </ul>
      {photoDuLieu && <img slot="visuel" src={photoDuLieu} alt={`${lieu.nom || 'Le cabinet'}${suffixeVille}`} width="1200" height="900" fetchpriority="high" decoding="async" />}
    </TetePage>
    {/* Sans praticien nommé : la page présente le cabinet seul (replis.ts). */}
    {site.praticiens.length > 0 && <section class="g-section g-bloc" id="praticiens">
      <div class="g-cadre g-bloc__dedans">
        <div class="g-tete"><p class="g-sur">{titreMetierAffiche}</p><h2>{titrePraticiens}</h2></div>
        <PraticiensVariantes variante={variantes.praticiens} />
      </div>
    </section>}
    {materiel && (
      <section class="g-section g-bloc" id="materiel">
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete"><p class="g-sur">Le cabinet</p><h2>Matériel et hygiène</h2></div>
          <MaterielCabinet />
        </div>
      </section>
    )}
    <section class="g-section g-bloc" id="infos">
      <div class="g-cadre g-bloc__dedans">
        <div class="g-tete"><p class="g-sur">Accès et horaires</p><h2>Informations pratiques</h2></div>
        <VenirAuCabinet variante={variantes.infos} />
      </div>
    </section>
  </>) : (<>
  <section class="cadre tete-page">
    <Breadcrumb items={crumbs} />
    <div class="tete-page__grille">
      <div>
        <p class="sur sur--index"><b aria-hidden="true">{String(site.praticiens.length).padStart(2, '0')} —</b> {[titreMetierAffiche, localisation].filter(Boolean).join(' · ')}</p>
        <h1>{titreCabinet}</h1>
        <p class="chapo">{phraseAccueil}</p>
      </div>
      {pedagogique && photoLieuAccueil ? (
        // Registre pédagogique : la photo du lieu d'exercice plutôt qu'un relevé illustratif.
        <img class="tete-page__photo" src={photoLieuAccueil} {...photoResponsive(photoLieuAccueil, '(min-width: 960px) 40vw, calc(100vw - 40px)')} alt="" width="1600" height="1000" fetchpriority="high" decoding="async" style={`object-position:${cadrageLieuAccueil}`} />
      ) : (
      <Planche legende={site.cabinet.ville} repere="Relevé" fond="plan" class="tete-page__releve">
        <Empreintes appui="reparti" cadre />
      </Planche>
      )}
    </div>
    {site.photos.cabinet.length > 0 && <div class="galerie"><Galerie /></div>}
  </section>
  {site.praticiens.length > 0 && <section class="section section--douce" id="praticiens">
    <div class="cadre">
      <p class="sur sur--num">{titreMetierAffiche}</p>
      <h2>{titrePraticiens}</h2>
      <Praticiens />
    </div>
  </section>}
  {materiel && (
    <section class="section" id="materiel">
      <div class="cadre">
        <p class="sur sur--num">Le cabinet</p>
        <h2>Matériel et hygiène</h2>
        <Materiel />
      </div>
    </section>
  )}
  <section class:list={['section', { 'section--douce': materiel }]} id="infos">
    <div class="cadre">
      <p class="sur sur--num">Accès et horaires</p>
      <h2>Informations pratiques</h2>
      <Infos colonnes />
    </div>
  </section>
  </>)}
</Gabarit>

<style>
  .tete-page__photo { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--rayon-grand); background: var(--doux); }
  .galerie { margin-top: 32px; }
  .tete-page :global(.tete-page__releve) { max-width: 460px; justify-self: end; }
  @media (max-width: 959px) { .tete-page :global(.tete-page__releve) { justify-self: stretch; max-width: none; } }
</style>
