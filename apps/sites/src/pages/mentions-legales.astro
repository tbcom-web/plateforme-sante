---
import Gabarit from '../layouts/Gabarit.astro';
import { site } from '../lib/site';
import { pack } from '../lib/pack';
import { noms, lieu, titreCabinet, rdvEnLigne, aAdresse, adresseLieu, aTelephone } from '../lib/textes';

const mesure = site.tracking.ga4 || site.tracking.clarity;
const ordre = pack.instance[site.pays];
// Profession réglementée : titre professionnel, État où il a été obtenu et règles professionnelles applicables (pack de la profession).
const paysTitre = { FR: 'France', BE: 'Belgique', CH: 'Suisse' }[site.pays];
const diplomeEtat = pack.diplome[site.pays];
const regles = pack.regles[site.pays];
---
<Gabarit title={`Mentions légales – ${titreCabinet}`} description={`Mentions légales du site de ${noms}.`} path="/mentions-legales">
  <section class="cadre tete-page">
    <div class="tete-page__grille tete-page__grille--simple">
      <div>
        <p class="sur sur--index">Informations légales</p>
        <h1>Mentions légales</h1>
      </div>
    </div>
  </section>
  <section class="section section--serree">
    <div class="cadre prose mentions">

      <h2>Éditeur du site</h2>
      <p>
        {titreCabinet}<br />
        {lieu.nom && <>{lieu.nom}<br /></>}
        {aAdresse ? <>{lieu.adresse}{lieu.complement && `, ${lieu.complement}`}, {`${lieu.codePostal} ${lieu.ville}`}</> : `${adresseLieu}.`}
        {aTelephone && <><br />Téléphone : {site.cabinet.telephone}</>}
        {site.cabinet.email && <><br />E-mail : {site.cabinet.email}</>}
      </p>
      {site.praticiens.map((p) => (
        <p>
          <strong>{`${p.prenom} ${p.nom}`.trim()}</strong><br />
          Titre professionnel : {p.titre.toLowerCase()}<br />
          Diplôme : {p.diplome || diplomeEtat} ({paysTitre})<br />
          {p.identifiants.map((id) => <>{id}<br /></>)}
        </p>
      ))}
      <p>Directeur de la publication : {site.praticiens.length ? `${site.praticiens[0].prenom} ${site.praticiens[0].nom}`.trim() : site.mentions.editeur}.</p>
      {site.praticien.conventionnement && <p>{site.praticien.conventionnement}.</p>}
      <p>Instance professionnelle : {ordre}.</p>
      <p>Règles professionnelles : {regles}</p>

      <h2>Hébergement</h2>
      <p>{site.mentions.hebergeur}</p>

      {site.mentions.creditPhotos && (
        <>
          <h2>Crédits photos</h2>
          <p>{site.mentions.creditPhotos}.</p>
        </>
      )}

      <h2>Informations médicales</h2>
      <p>
        Les informations publiées sur ce site sont générales. Elles ne remplacent pas une consultation et ne permettent pas
        d’établir un diagnostic. En cas d’urgence, composez le {site.pays === 'FR' ? '15' : site.pays === 'BE' ? '112' : '144'}.
      </p>

      <h2>Données personnelles</h2>
      <p>
        Ce site ne collecte aucune donnée de santé.
        {rdvEnLigne && ` La prise de rendez-vous se fait sur ${site.rdv.plateforme}, qui dispose de sa propre politique de confidentialité.`}
        Les clics vers la prise de rendez-vous sont comptés de façon anonyme, sans cookie ni adresse IP.
      </p>
      {mesure && (
        <p>
          Avec votre accord, des outils de mesure d’audience (Google Analytics, Microsoft Clarity) sont utilisés. Vous pouvez
          retirer votre consentement à tout moment via le lien « Gérer les cookies ».
        </p>
      )}
      <p>
        Vous disposez d’un droit d’accès, de rectification et de suppression de vos données, à exercer auprès de l’éditeur.
        {site.pays === 'FR' && ' Vous pouvez également saisir la CNIL.'}
      </p>
    </div>
  </section>
</Gabarit>

<style>
  /* Sobre : filets et numéros mono, comme les rubriques du pied de page. */
  .section--serree { padding-top: 0; }
  .mentions { counter-reset: rubrique; }
  .mentions :global(h2) { counter-increment: rubrique; display: flex; align-items: baseline; gap: 14px; font-size: 1.35rem; margin: 2.2em 0 0.7em; padding-top: 14px; border-top: var(--filet) solid var(--ligne); }
  .mentions :global(h2:first-child) { margin-top: 0; }
  .mentions :global(h2)::before { content: counter(rubrique, decimal-leading-zero); font-family: var(--police-mono); font-size: var(--taille-donnees); font-weight: 450; letter-spacing: 0.04em; color: var(--accent-vif); }
</style>
