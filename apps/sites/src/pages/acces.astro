---
// Plan d'accès : en-tête éditorial (filet, sur-titre indexé), carte et informations côte à côte comme à
// l'accueil. Titres, textes et données structurées inchangés.
import Gabarit from '../layouts/Gabarit.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Carte from '../components/gabarit/Carte.astro';
import Infos from '../components/gabarit/Infos.astro';
import { site } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';
import { titreCabinet, adresseLieu, lieu, aLaVille, aTelephone, aAdresse } from '../lib/textes';
import TetePage from '../components/gabarits/TetePage.astro';
import PlanAcces from '../components/gabarits/PlanAcces.astro';
import InfosPratiques from '../components/gabarits/InfosPratiques.astro';
import Icone from '../components/Icone.astro';
import { nouveauGabarit, variantes } from '../lib/gabarits';
import { itineraire, telLien } from '../lib/textes';

const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Plan d’accès', path: '/acces' }];
---
<Gabarit
  title={`Plan d’accès – ${titreCabinet}`}
  description={`Venir au cabinet : ${lieu.nom ? `${lieu.nom}, ` : ''}${adresseLieu}. Horaires, stationnement, transports et accessibilité.`}
  path="/acces"
  schemas={[breadcrumbSchema(crumbs)]}
>
  {nouveauGabarit ? (<>
    <TetePage crumbs={crumbs} sur="Plan d’accès" chapo={`${lieu.nom ? `${lieu.nom}, ` : ''}${adresseLieu}.`}>
      <h1 slot="titre">Venir au cabinet {aLaVille && <span class="pale">{aLaVille}</span>}</h1>
      <div class="g-bulles">
        {itineraire && <a class="g-bouton g-bouton--plein" href={itineraire} target="_blank" rel="noopener"><Icone nom="picto:itineraire" secours="lucide:map-pin" />Itinéraire</a>}
        {aTelephone && <a class="g-bouton g-bouton--ligne" href={telLien}><Icone nom="picto:telephone" secours="lucide:phone" />{site.cabinet.telephone}</a>}
      </div>
    </TetePage>
    <section class="g-section g-bloc">
      <div class="g-cadre g-bloc__dedans g-acces">
        {aAdresse && <div class="g-acces__plan"><PlanAcces /></div>}
        <InfosPratiques variante={variantes.infos} sansAdresse niveau={2} />
      </div>
    </section>
  </>) : (<>
  <section class="cadre tete-page">
    <Breadcrumb items={crumbs} />
    <div class="tete-page__grille tete-page__grille--simple">
      <div>
        <p class="sur sur--index">{site.cabinet.codePostal && <b aria-hidden="true">{site.cabinet.codePostal} —</b>} Plan d’accès</p>
        <h1>Venir au cabinet {aLaVille && <span class="pale">{aLaVille}</span>}</h1>
      </div>
      <p class="chapo">{lieu.nom ? `${lieu.nom}, ` : ''}{adresseLieu}.</p>
    </div>
  </section>
  <section class="section section--serree">
    <div class="cadre acces"><Carte /><Infos sansAdresse niveau={2} /></div>
  </section>
  </>)}
</Gabarit>

<style>
  .section--serree { padding-top: 0; }
  .tete-page__grille--simple .chapo { margin: 0; max-width: 40ch; }
  .acces { display: grid; gap: 28px; }
  @media (min-width: 1000px) { .acces { grid-template-columns: 1.1fr 0.9fr; align-items: start; } .acces > :global(.carte) { position: sticky; top: 100px; } .acces :global(.carte__plan) { min-height: 460px; } }
</style>
