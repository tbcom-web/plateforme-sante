---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import InfosPratiques from '../components/InfosPratiques.astro';
import { site, md, nomPraticien, metierVille } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Le cabinet', path: '/a-propos' }];
---
<Base
  title={`${nomPraticien}, ${metierVille} : parcours et cabinet`}
  description={`Parcours, formations et cabinet de ${nomPraticien}, ${site.praticien.titre.toLowerCase()} à ${site.cabinet.ville}.`}
  path="/a-propos"
  schemas={[breadcrumbSchema(crumbs)]}
>
  <section class="section">
    <div class="wrap layout">
      <div>
        <Breadcrumb items={crumbs} />
        <h1>{nomPraticien}</h1>
        <p class="lead">{site.praticien.titre}, {site.cabinet.quartier}.</p>
        <div class="prose" set:html={md(site.praticien.parcours)} />
      </div>
      <aside class="card">
        <h2>Formations</h2>
        <ul>{site.praticien.formations.map((f) => <li>{f}</li>)}</ul>
        <h2>Informations professionnelles</h2>
        <dl>
          <dt>N° RPPS</dt><dd>{site.praticien.rpps}</dd>
          <dt>Ordre</dt><dd>{site.praticien.ordre}</dd>
          <dt>Conventionnement</dt><dd>{site.praticien.conventionnement}</dd>
          <dt>Langues</dt><dd>{site.praticien.langues.join(', ')}</dd>
        </dl>
      </aside>
    </div>
  </section>
  <InfosPratiques />
</Base>

<style>
  .layout { display: grid; gap: 40px; }
  @media (min-width: 960px) { .layout { grid-template-columns: 1fr 360px; align-items: start; } }
  aside h2 { font-size: 1.1rem; margin-top: 0.4em; }
  aside ul { padding-left: 1.1em; color: var(--ink-soft); }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; font-size: 0.95rem; margin: 0; }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--ink-soft); }
</style>
