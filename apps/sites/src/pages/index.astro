---
// Accueil : assemblé selon la fiche du modèle (type d'accueil, ordre et variantes des sections).
// Les textes, titres et données structurées sont identiques quel que soit le modèle (SEO stable).
import Gabarit from '../layouts/Gabarit.astro';
import FaqList from '../components/FaqList.astro';
import { texte, champ } from '../lib/edition';
import HeroDiaporama from '../components/gabarit/HeroDiaporama.astro';
import HeroScinde from '../components/gabarit/HeroScinde.astro';
import HeroPlein from '../components/gabarit/HeroPlein.astro';
import HeroLieu from '../components/gabarit/HeroLieu.astro';
import Icone from '../components/Icone.astro';
import { pedagogique } from '../lib/visuels';
import Expertises from '../components/gabarit/Expertises.astro';
import Competences from '../components/gabarit/Competences.astro';
import Praticiens from '../components/gabarit/Praticiens.astro';
import Infos from '../components/gabarit/Infos.astro';
import Galerie from '../components/gabarit/Galerie.astro';
import Panorama from '../components/gabarit/Panorama.astro';
import Carte from '../components/gabarit/Carte.astro';
import Couverture from '../components/dessins/Couverture.astro';
import AccueilVariantes from '../components/gabarits/Accueil.astro';
import SujetsAccueil from '../components/SujetsAccueil.astro';
import { nouveauGabarit } from '../lib/gabarits';
import { soinsAccueil, soinsAccueilAllege } from '../lib/navigation';
import { site, dateFr } from '../lib/site';
import { faqSchema } from '../lib/schema';
import { photoResponsive } from '../lib/visuels';
import { titreCabinet, phraseAccueil, titreCompetences, titrePraticiens, noms, rdvEnLigne, telLien, lieu, lienRdv, libelleRdv, aTelephone, adresseLieu, aAdresse, phraseRdv, lienContact, contactRdv } from '../lib/textes';
import { espacesFines, faitEquipement } from '@plateforme/core';

const m = site.modele;
const metier = site.titreMetier.toLowerCase();
// Bande « en bref » : seulement des informations utiles au patient (jamais le seul nom du métier, déjà dans le titre).
const ouverts = lieu.horaires.filter((h) => /\d/.test(h.heures)).map((h) => h.jour.toLowerCase());
const faits = [
  site.praticiens.length > 1 ? `${site.praticiens.length} praticiens` : site.praticiens[0]?.diplome ?? '',
  site.praticien.conventionnement,
  site.accesDetail.pmr ? 'Cabinet accessible PMR' : '',
  site.domicile.actif ? 'Visites à domicile' : '',
  rdvEnLigne ? `Réservation en ligne sur ${site.rdv.plateforme}` : aTelephone ? `Rendez-vous au ${site.cabinet.telephone}` : phraseRdv,
  ouverts.length > 1 ? `Ouvert du ${ouverts[0]} au ${ouverts.at(-1)}` : '',
].filter(Boolean).slice(0, 4);
// Matériel et hygiène : une ligne de plus quand le cabinet a coché la stérilisation (ex. « Stérilisation autoclave classe B »).
const faitHygiene = faitEquipement(site.equipements ?? []);
if (faitHygiene) faits.splice(Math.min(2, faits.length), 0, faitHygiene);
const articles = [...site.articles].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);

const title = `${[site.titreMetier, site.cabinet.ville].filter(Boolean).join(' ')} – ${noms}`;
const description = `${titreCabinet}. ${phraseAccueil} ${site.soins.slice(0, 4).map((s) => s.titreCourt).join(', ')}.`;
// Sections sur fond doux ; en registre pédagogique, le lieu (panorama) et la FAQ seulement, pour alterner sans enchaîner deux fonds doux.
const douce = (s: string) => (pedagogique ? ['faq'] : ['praticiens', 'faq']).includes(s);

// Premier rendez-vous en trois étapes (section « etapes ») : uniquement des informations déjà saisies (prise de
// rendez-vous, adresse et accès, déroulé de la consultation déjà affiché à l'accueil), sans intertitre : aucun titre SEO ajouté.
const premiers = [...lieu.horaires].filter((h) => /\d/.test(h.heures)).map((h) => h.jour.toLowerCase());
const aApporter = site.soins.flatMap((s) => s.faq).find((f) => /apporter/i.test(f.q))?.r;
const telInsecable = site.cabinet.telephone.replace(/ /g, ' ');
const etapes = [
  {
    titre: 'Prendre rendez-vous',
    texte: rdvEnLigne
      ? `En ligne sur ${site.rdv.plateforme}, 24h/24${aTelephone ? `, ou par téléphone au ${telInsecable}` : ''}.`
      : aTelephone ? `Par téléphone au ${telInsecable}${premiers.length > 1 ? `, du ${premiers[0]} au ${premiers.at(-1)}` : ''}.` : `${phraseRdv}.`,
  },
  {
    titre: 'Venir au cabinet',
    texte: `${lieu.nom ? `${lieu.nom}, ` : ''}${aAdresse ? `${lieu.adresse}${lieu.complement ? `, ${lieu.complement}` : ''}, ${lieu.codePostal} ${lieu.ville}` : adresseLieu}.${site.accesDetail.pmr ? ' Cabinet accessible aux personnes à mobilité réduite.' : ''}`,
  },
  {
    titre: 'La consultation',
    texte: `${texte('competences.chapo', 'Chaque consultation commence par un échange et un examen, afin de proposer des soins adaptés à chacun.')}${aApporter ? ` À apporter : ${aApporter.charAt(0).toLowerCase()}${aApporter.slice(1)}` : ''}`,
  },
];
// Registre pédagogique : questions des fiches de soins sur l'ordonnance et le remboursement, affichées en plus de la FAQ
// générale (données structurées inchangées : FAQPage de l'accueil = FAQ générale).
const faqEnPlus = pedagogique
  ? site.soins.flatMap((s) => s.faq).filter((f, i, toutes) => /ordonnance|prescription|rembours/i.test(f.q) && !site.faqGenerale.some((g) => g.q === f.q) && toutes.findIndex((x) => x.q === f.q) === i).slice(0, 2)
  : [];
---
<Gabarit title={title} description={description} path="/" schemas={[faqSchema(site.faqGenerale, { nom: title, description, path: '/' })]} immersif={m.accueil.hero === 'diaporama' || m.accueil.hero === 'plein'}>
  {nouveauGabarit ? <AccueilVariantes articles={articles} /> : (<>
  {m.accueil.hero === 'diaporama' ? <HeroDiaporama /> : m.accueil.hero === 'plein' ? <HeroPlein /> : m.accueil.hero === 'lieu' ? <HeroLieu /> : <HeroScinde />}
  <SujetsAccueil />

  {m.accueil.sections.map((section) => (
    <>
      {section === 'faits' && (
        <ul class="cadre faits" aria-label="En bref">{faits.map((f) => <li>{f}</li>)}</ul>
      )}

      {section === 'etapes' && (
        <section class="section section--etapes" aria-label="Premier rendez-vous">
          <div class="cadre">
            <p class="sur">Premier rendez-vous</p>
            <ol class="etapes">
              {etapes.map((e, i) => (
                <li class="etape">
                  <span class="etape__num" aria-hidden="true">{i + 1}</span>
                  <p class="etape__titre">{e.titre}</p>
                  <p class="etape__texte">{e.texte}</p>
                </li>
              ))}
            </ol>
            <div class="etapes__actions">
              <a class="bouton bouton--plein" href={site.praticiens.length > 1 && rdvEnLigne ? '#praticiens' : lienRdv('etapes')}><Icone nom={rdvEnLigne ? 'lucide:calendar' : aTelephone ? 'lucide:phone' : 'lucide:mail'} />{libelleRdv}</a>
              {rdvEnLigne && aTelephone && <a class="bouton bouton--ligne" href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>}
            </div>
          </div>
        </section>
      )}

      {section === 'competences' && (
        <section class="section" id="competences">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur sur--num">{titreCompetences}</p>
                <h2>Une prise en charge <span class="pale" {...champ('competences.deco')}>{texte('competences.deco', 'du pied, à tout âge.')}</span></h2>
              </div>
              {!(pedagogique && m.accueil.sections.includes('etapes')) && <p class="chapo" {...champ('competences.chapo')}>{texte('competences.chapo', 'Chaque consultation commence par un échange et un examen, afin de proposer des soins adaptés à chacun.')}</p>}
            </div>
            {/* Soins déjà portés par les cartes des sujets : non répétés (lib/navigation.ts, soinsAccueil) */}
            {soinsAccueil.length > 0 && (m.competences === 'cartes' ? <Competences soins={soinsAccueil} /> : <Expertises soins={soinsAccueil} />)}
            {soinsAccueilAllege && <p class="tous-soins"><a class="bouton bouton--ligne bouton--petit" href="/soins">Voir tous les soins</a></p>}
          </div>
        </section>
      )}

      {section === 'panorama' && <Panorama />}

      {section === 'praticiens' && site.praticiens.length > 0 && (
        <section class:list={['section', { 'section--douce': douce(section) }]} id="praticiens">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur sur--num">{titrePraticiens}</p>
                <h2>{site.praticiens.length > 1 ? <>Une équipe{' '}<span class="pale" {...champ('praticiens.deco')}>{texte('praticiens.deco', `de ${site.praticiens.length} praticiens.`)}</span></> : <>Votre {metier}{' '}<span class="pale" {...champ('praticiens.deco')}>{texte('praticiens.deco', `à ${site.cabinet.ville}.`)}</span></>}</h2>
              </div>
            </div>
            <Praticiens />
          </div>
        </section>
      )}

      {section === 'galerie' && site.photos.cabinet.length > 0 && (
        <section class="section">
          <div class="cadre">
            <div class="entete-section apparait"><div><p class="sur sur--num">Le cabinet</p><h2>En images</h2></div></div>
            <Galerie />
          </div>
        </section>
      )}

      {section === 'actualites' && articles.length > 0 && (
        <section class="section">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur sur--num">Actualités</p>
                <h2>Conseils <span class="pale" {...champ('actualites.deco')}>{texte('actualites.deco', 'et actualités.')}</span></h2>
              </div>
              <a class="bouton bouton--ligne bouton--petit" href="/actualites">Toutes les actualités</a>
            </div>
            <div class:list={['articles', `articles--${articles.length}`]}>
              {articles.map((a, i) => (
                <a class="article apparait" href={`/actualites/${a.slug}`}>
                  <span class="article__visuel">
                    {a.image
                      ? <img src={a.image} {...photoResponsive(a.image, '(min-width: 1000px) 40vw, 100vw')} alt={a.imageAlt ?? ''} width="1600" height="900" loading="lazy" />
                      : <Couverture theme={a.theme} titre={a.titre} numero={i + 1} />}
                  </span>
                  <span class="article__meta mono">{a.theme} · <time datetime={a.date}>{dateFr(a.date)}</time></span>
                  <span class="article__titre">{espacesFines(a.titre)}</span>
                  <span class="article__resume">{a.resume}</span>
                  <span class="article__lire">Lire l’article →</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {section === 'acces' && (
        <section class="section" id="infos">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur sur--num">Accès et informations</p>
                <h2>Venir <span class="pale" {...champ('acces.deco')}>{texte('acces.deco', 'au cabinet.')}</span></h2>
              </div>
            </div>
            <div class="acces"><Carte /><Infos sansAdresse /></div>
          </div>
        </section>
      )}

      {section === 'faq' && (
        <section class="section section--douce">
          <div class="cadre faq">
            <div class="faq__entete">
              <p class="sur sur--num">Questions fréquentes</p>
              <h2>Bon à savoir <span class="pale" {...champ('faq.deco')}>{texte('faq.deco', 'avant de venir.')}</span></h2>
              <p class="faq__contact"><span class="mono">{String(site.faqGenerale.length).padStart(2, '0')} questions</span>{aTelephone ? <>Une autre question ? <a href={telLien}>{site.cabinet.telephone}</a></> : contactRdv === 'email' && <>Une autre question ? <a href={lienContact}>{site.cabinet.email}</a></>}</p>
            </div>
            <div>
              <FaqList items={site.faqGenerale} cle="faq" />
              {faqEnPlus.length > 0 && <div class="faq__suite"><FaqList items={faqEnPlus} /></div>}
            </div>
          </div>
        </section>
      )}
    </>
  ))}
  </>)}
</Gabarit>

<style>
  .faits { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); border-top: var(--filet-fort) solid var(--encre); border-bottom: var(--filet) solid var(--ligne); margin-top: clamp(28px, 4vw, 48px); }
  .faits li { display: grid; gap: 6px; padding: 18px 20px 20px 0; font-size: 0.93rem; color: var(--encre); font-weight: 500; }
  .faits li + li { border-top: var(--filet) solid var(--ligne); }
  @media (min-width: 760px) { .faits li + li { border-top: 0; border-left: var(--filet) solid var(--ligne); padding-left: 20px; } }

  .articles { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .article { display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 10px; text-decoration: none; color: var(--encre); }
  .article:hover { color: var(--encre); }
  .article__visuel { display: block; aspect-ratio: 16 / 9; border-radius: var(--rayon); overflow: hidden; margin-bottom: 8px; background: var(--doux); box-shadow: var(--ombre); transition: transform var(--duree-moyen) var(--courbe-sortie), box-shadow var(--duree-moyen); }
  .article__visuel img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--duree-moyen) var(--courbe-sortie); }
  .article__visuel :global(.couverture) { height: 100%; }
  .article:hover .article__visuel { transform: translateY(-4px); box-shadow: var(--ombre-profonde); }
  .article:hover .article__visuel img { transform: scale(1.04); }
  .article__meta { padding-top: 12px; border-top: var(--filet-fort) solid var(--encre); color: var(--accent-vif); text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--taille-donnees-petit); }
  .article__titre { font-family: var(--police-titres); font-weight: var(--graisse-titres, 600); font-size: clamp(1.3rem, 2vw, 1.6rem); letter-spacing: -0.03em; line-height: 1.12; text-wrap: balance; }
  .article__resume { color: var(--encre-douce); font-size: 0.95rem; }
  .article__lire { font-weight: 600; font-size: 0.92rem; color: var(--accent-vif); }
  @media (min-width: 1000px) {
    /* Trois articles : le plus récent en vedette, les deux autres en colonne */
    .articles--3 { grid-template-columns: 1.35fr 1fr; grid-template-rows: auto auto; }
    .articles--3 .article:first-child { grid-row: span 2; }
    .articles--3 .article:first-child .article__titre { font-size: clamp(1.7rem, 2.6vw, 2.3rem); }
    .articles--3 .article:not(:first-child) { grid-template-columns: 0.9fr 1.1fr; grid-template-rows: auto auto 1fr auto; column-gap: 20px; }
    .articles--3 .article:not(:first-child) .article__visuel { grid-row: 1 / -1; margin: 0; }
  }

  .acces { display: grid; gap: 28px; }
  /* Carte collante à côté des informations (pas de vide sous la carte quand la colonne de droite est longue) */
  @media (min-width: 1000px) { .acces { grid-template-columns: 1.1fr 0.9fr; align-items: start; } .acces > :global(.carte) { position: sticky; top: 100px; } }

  /* Premier rendez-vous : trois étapes en colonnes (ordinateur), numéros ronds dans la police du texte */
  .etapes { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; align-items: start; }
  @media (min-width: 860px) { .etapes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
  .etape { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 16px; align-content: start; padding: 22px; border-radius: var(--rayon); background: var(--doux); }
  .etape__num { grid-row: span 2; display: grid; place-items: center; width: 2.4em; height: 2.4em; border-radius: 50%; background: var(--accent); color: var(--blanc); font-weight: 800; font-size: 1.1rem; }
  .etape__titre { margin: 0 0 6px; font-family: var(--police-titres); font-weight: var(--graisse-titres, 700); font-size: 1.2rem; line-height: 1.25; color: var(--encre); }
  .etape__texte { margin: 0; color: var(--encre-douce); }
  .etapes__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .tous-soins { margin: 28px 0 0; }
  .section--etapes { padding-block: 0 clamp(56px, 8vw, 96px); }
  .faq__suite :global(.faq) { border-top: 0; }

  .faq { display: grid; gap: 32px; }
  .faq__contact { display: grid; gap: 6px; margin: 28px 0 0; padding-top: 16px; border-top: var(--filet) solid var(--ligne); color: var(--encre-douce); font-size: 0.95rem; max-width: 30ch; }
  .faq__contact .mono { color: var(--accent-vif); text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--taille-donnees-petit); }
  @media (min-width: 960px) { .faq { grid-template-columns: 0.8fr 1.2fr; align-items: start; } .faq__entete { position: sticky; top: 110px; } }
  /* Téléphone (≤ 759 px, TELEPHONE de la charte) */
  @media (max-width: 759px) {
    .faits li { font-size: var(--taille-texte-telephone); }
    .articles { gap: var(--espace-bloc); }
    .article__resume { font-size: var(--taille-texte-telephone); }
    .etapes { gap: var(--espace-ligne); }
    .section--etapes { padding-top: var(--espace-bloc); }
    .faq__contact { font-size: var(--taille-texte-telephone); }
    .faq__contact a { display: inline-flex; align-items: center; min-height: var(--cible-tactile); }
  }
</style>
