---
// Accueil : assemblé selon la fiche du modèle (type d'accueil, ordre et variantes des sections).
// Les textes, titres et données structurées sont identiques quel que soit le modèle (SEO stable).
import Gabarit from '../layouts/Gabarit.astro';
import FaqList from '../components/FaqList.astro';
import HeroDiaporama from '../components/gabarit/HeroDiaporama.astro';
import HeroScinde from '../components/gabarit/HeroScinde.astro';
import Expertises from '../components/gabarit/Expertises.astro';
import Competences from '../components/gabarit/Competences.astro';
import Praticiens from '../components/gabarit/Praticiens.astro';
import Infos from '../components/gabarit/Infos.astro';
import Galerie from '../components/gabarit/Galerie.astro';
import Panorama from '../components/gabarit/Panorama.astro';
import Carte from '../components/gabarit/Carte.astro';
import { site, dateFr } from '../lib/site';
import { faqSchema } from '../lib/schema';
import { titreCabinet, phraseAccueil, titreCompetences, titrePraticiens, noms, rdvEnLigne } from '../lib/textes';

const m = site.modele;
const metier = site.titreMetier.toLowerCase();
const faits = [
  site.praticiens.length > 1 ? `${site.praticiens.length} praticiens` : site.praticiens[0].diplome || site.titreMetier,
  site.praticien.conventionnement,
  site.accesDetail.pmr ? 'Cabinet accessible PMR' : '',
  site.domicile.actif ? 'Visites à domicile' : '',
  rdvEnLigne ? `Réservation en ligne sur ${site.rdv.plateforme}` : `Rendez-vous au ${site.cabinet.telephone}`,
].filter(Boolean).slice(0, 4);
const articles = [...site.articles].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);

const title = `${site.titreMetier} ${site.cabinet.ville} – ${noms}`;
const description = `${titreCabinet}. ${phraseAccueil} ${site.soins.slice(0, 4).map((s) => s.titreCourt).join(', ')}.`;
const douce = (s: string) => ['praticiens', 'faq'].includes(s);
---
<Gabarit title={title} description={description} path="/" schemas={[faqSchema(site.faqGenerale)]} immersif={m.accueil.hero === 'diaporama'}>
  {m.accueil.hero === 'diaporama' ? <HeroDiaporama /> : <HeroScinde />}

  {m.accueil.sections.map((section) => (
    <>
      {section === 'faits' && (
        <ul class="cadre faits" aria-label="En bref">{faits.map((f) => <li>{f}</li>)}</ul>
      )}

      {section === 'competences' && (
        <section class="section" id="competences">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur">{titreCompetences}</p>
                <h2>Une prise en charge <span class="pale">du pied, à tout âge.</span></h2>
              </div>
              <p class="chapo">Chaque consultation commence par un échange et un examen, afin de proposer des soins adaptés à chacun.</p>
            </div>
            {m.competences === 'cartes' ? <Competences /> : <Expertises />}
          </div>
        </section>
      )}

      {section === 'panorama' && <Panorama />}

      {section === 'praticiens' && (
        <section class:list={['section', { 'section--douce': douce(section) }]} id="praticiens">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur">{titrePraticiens}</p>
                <h2>{site.praticiens.length > 1 ? <>Une équipe <span class="pale">à votre écoute.</span></> : <>Votre {metier} <span class="pale">à {site.cabinet.ville}.</span></>}</h2>
              </div>
            </div>
            <Praticiens />
          </div>
        </section>
      )}

      {section === 'galerie' && site.photos.cabinet.length > 0 && (
        <section class="section">
          <div class="cadre">
            <div class="entete-section apparait"><div><p class="sur">Le cabinet</p><h2>En images</h2></div></div>
            <Galerie />
          </div>
        </section>
      )}

      {section === 'actualites' && articles.length > 0 && (
        <section class="section">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur">Actualités</p>
                <h2>Conseils <span class="pale">et actualités.</span></h2>
              </div>
              <a class="bouton bouton--ligne bouton--petit" href="/actualites">Toutes les actualités</a>
            </div>
            <div class="articles">
              {articles.map((a) => (
                <a class="article apparait" href={`/actualites/${a.slug}`}>
                  <span class="article__meta">{a.theme} · <time datetime={a.date}>{dateFr(a.date)}</time></span>
                  <span class="article__titre">{a.titre}</span>
                  <span class="article__resume">{a.resume}</span>
                  <span class="article__lire">Lire l’article →</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}

      {section === 'acces' && (
        <section class="section" id="infos">
          <div class="cadre">
            <div class="entete-section apparait">
              <div>
                <p class="sur">Accès et informations</p>
                <h2>Venir <span class="pale">au cabinet.</span></h2>
              </div>
            </div>
            <div class="acces"><Carte /><Infos /></div>
          </div>
        </section>
      )}

      {section === 'faq' && (
        <section class="section section--douce">
          <div class="cadre faq">
            <div>
              <p class="sur">Questions fréquentes</p>
              <h2>Bon à savoir <span class="pale">avant de venir.</span></h2>
            </div>
            <FaqList items={site.faqGenerale} />
          </div>
        </section>
      )}
    </>
  ))}
</Gabarit>

<style>
  .faits { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); border-block: 1px solid var(--ligne); }
  .faits li { padding: 20px 20px 20px 0; font-size: 0.93rem; color: var(--encre-douce); }
  .faits li + li { border-top: 1px solid var(--ligne); }
  @media (min-width: 760px) { .faits li + li { border-top: 0; border-left: 1px solid var(--ligne); padding-left: 20px; } }

  .articles { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .article { display: grid; gap: 10px; padding: 28px; border-radius: var(--rayon); border: 1px solid var(--ligne); text-decoration: none; color: var(--encre); transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s; }
  .article:hover { transform: translateY(-3px); box-shadow: var(--ombre); border-color: transparent; color: var(--encre); }
  .article__meta { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-vif); }
  .article__titre { font-size: 1.3rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.2; }
  .article__resume { color: var(--encre-douce); font-size: 0.95rem; }
  .article__lire { margin-top: auto; font-weight: 600; font-size: 0.92rem; color: var(--accent-vif); }

  .acces { display: grid; gap: 20px; }
  @media (min-width: 1000px) { .acces { grid-template-columns: 1.1fr 0.9fr; align-items: start; } }

  .faq { display: grid; gap: 32px; }
  @media (min-width: 960px) { .faq { grid-template-columns: 0.8fr 1.2fr; align-items: start; } }
</style>
