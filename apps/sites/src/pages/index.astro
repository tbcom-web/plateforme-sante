---
import Gabarit from '../layouts/Gabarit.astro';
import Icone from '../components/Icone.astro';
import FaqList from '../components/FaqList.astro';
import Competences from '../components/gabarit/Competences.astro';
import Praticiens from '../components/gabarit/Praticiens.astro';
import Infos from '../components/gabarit/Infos.astro';
import Galerie from '../components/gabarit/Galerie.astro';
import { site } from '../lib/site';
import { faqSchema } from '../lib/schema';
import {
  titreMetierAffiche, titreCabinet, phraseAccueil, titreCompetences, titrePraticiens, noms, titreMetierPluriel,
  lieu, telLien, lienRdv, libelleRdv, TYPES_LIEU,
} from '../lib/textes';

const ouverts = lieu.horaires.filter((h) => /\d/.test(h.heures)).map((h) => h.jour.toLowerCase());
const jours = ouverts.length > 1 ? `Du ${ouverts[0]} au ${ouverts.at(-1)}, sur rendez-vous` : 'Sur rendez-vous';
const lieuLigne = lieu.nom || (lieu.type !== 'cabinet' ? TYPES_LIEU[lieu.type] : '');

const title = `${site.titreMetier} ${site.cabinet.ville} – ${noms}`;
const description = `${titreCabinet}. ${phraseAccueil} ${site.soins.slice(0, 4).map((s) => s.titreCourt).join(', ')}.`;
const metier = site.titreMetier.toLowerCase();
---
<Gabarit title={title} description={description} path="/" schemas={[faqSchema(site.faqGenerale)]}>
  <section class="cadre accueil">
    <div>
      <p class="sur">{titreMetierAffiche} · {site.cabinet.ville}</p>
      <h1>{titreCabinet}</h1>
      <p class="chapo">{phraseAccueil}</p>
      <ul class="essentiel">
        <li><Icone nom="lucide:map-pin" /><span>{lieuLigne && <>{lieuLigne}<br /></>}{lieu.adresse}, {lieu.codePostal} {lieu.ville}</span></li>
        <li><Icone nom="lucide:clock" /><span>{jours}</span></li>
        {site.domicile.actif && <li><Icone nom="healthicons:home-outline" /><span>Visites à domicile{site.domicile.secteurs.length ? ` (${site.domicile.secteurs.length} secteurs)` : ''}</span></li>}
      </ul>
      <div class="actions">
        <a class="bouton bouton--plein" href={site.praticiens.length > 1 ? '#praticiens' : lienRdv('accueil')}><Icone nom="lucide:calendar" />{libelleRdv}</a>
        {site.rdvMode !== 'telephone' && <a class="bouton bouton--ligne" href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>}
      </div>
    </div>
    <figure class="accueil__photo">
      <img src={site.photos.accueil || '/photos/cabinet-lumiere.webp'} alt={`Le cabinet de ${site.cabinet.ville}`} width="1200" height="1500" fetchpriority="high" />
    </figure>
  </section>

  <section class="section section--douce">
    <div class="cadre">
      <h2>Quand consulter un {metier} ?</h2>
      <p class="chapo">
        Le {metier} prend en charge les affections de la peau et des ongles du pied, ainsi que les douleurs du pied, de la
        cheville, du genou, de la hanche ou du dos liées à la marche ou à la course. Une douleur régulière au talon, aux
        orteils ou sous le pied, une verrue plantaire ou un ongle incarné sont autant de raisons de consulter.
      </p>
    </div>
  </section>

  <section class="section" id="competences">
    <div class="cadre">
      <h2>{titreCompetences}</h2>
      <Competences />
    </div>
  </section>

  <section class="section section--douce" id="praticiens">
    <div class="cadre">
      <h2>{titrePraticiens}</h2>
      <Praticiens />
    </div>
  </section>

  {site.photos.cabinet.length > 0 && (
    <section class="section">
      <div class="cadre">
        <h2>Le cabinet</h2>
        <Galerie />
      </div>
    </section>
  )}

  <section class="section" id="infos">
    <div class="cadre">
      <h2>Informations pratiques</h2>
      <Infos />
    </div>
  </section>

  <section class="section section--douce">
    <div class="cadre">
      <h2>Questions fréquentes</h2>
      <FaqList items={site.faqGenerale} />
    </div>
  </section>
</Gabarit>

<style>
  .accueil { display: grid; gap: 40px; align-items: center; padding-block: clamp(36px, 6vw, 72px); }
  @media (min-width: 900px) { .accueil { grid-template-columns: 1.15fr 0.85fr; } }
  .chapo { margin: 18px 0 24px; }
  .essentiel { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 12px; }
  .essentiel li { display: flex; gap: 12px; align-items: flex-start; font-size: 0.97rem; }
  .essentiel :global(.icone) { color: var(--accent); font-size: 1.3rem; margin-top: 2px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .accueil__photo { margin: 0; }
  .accueil__photo img { width: 100%; height: clamp(280px, 50vh, 500px); object-fit: cover; border-radius: 24px; }
</style>
