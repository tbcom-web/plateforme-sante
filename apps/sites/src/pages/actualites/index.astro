---
import Gabarit from '../../layouts/Gabarit.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Couverture from '../../components/dessins/Couverture.astro';
import { site, nomPraticien, dateFr } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Conseils', path: '/actualites' }];
const articles = [...site.articles].sort((a, b) => b.date.localeCompare(a.date));
---
<Gabarit
  title={`Conseils et actualités | ${nomPraticien}`}
  description={`Conseils pour prendre soin de vos pieds, par ${nomPraticien}, ${site.profession.libelle.toLowerCase()} à ${site.cabinet.ville}.`}
  path="/actualites"
  schemas={[breadcrumbSchema(crumbs)]}
  noindex={articles.length === 0}
>
  <section class="section">
    <div class="cadre">
      <Breadcrumb items={crumbs} />
      <h1>Conseils et actualités</h1>
      {articles.length === 0 && <p class="chapo">Les premiers conseils arrivent bientôt.</p>}
      <div class="liste">
        {articles.map((a, i) => (
          <a class="item" href={`/actualites/${a.slug}`}>
            <span class="item__visuel">
              {a.image
                ? <img src={a.image} alt={a.imageAlt ?? ''} width="1600" height="900" loading="lazy" />
                : <Couverture theme={a.theme} titre={a.titre} numero={i + 1} />}
            </span>
            <span class="item__texte">
              <span class="tag">{a.theme} · <time datetime={a.date}>{dateFr(a.date)}</time></span>
              <h2>{a.titre}</h2>
              <p>{a.resume}</p>
              <span class="item__lire">Lire l’article →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Gabarit>

<style>
  .liste { display: grid; gap: 0; max-width: 1000px; margin-top: 32px; border-top: 1.5px solid var(--encre); }
  .item { display: grid; gap: 18px 32px; padding: 28px 0; border-bottom: 1px solid var(--ligne); text-decoration: none; color: inherit; }
  @media (min-width: 760px) { .item { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; } }
  .item:hover { color: inherit; }
  .item__visuel { display: block; aspect-ratio: 16 / 9; border-radius: var(--rayon); overflow: hidden; box-shadow: var(--ombre); transition: transform 0.45s cubic-bezier(.2,.7,.2,1); }
  .item__visuel img { width: 100%; height: 100%; object-fit: cover; }
  .item__visuel :global(.couverture) { height: 100%; }
  .item:hover .item__visuel { transform: translateY(-4px); }
  .item__texte { display: grid; gap: 10px; align-content: center; }
  .item h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: 0; }
  .item p { color: var(--ink-soft); margin: 0; }
  .tag { font-family: var(--police-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand-ink); }
  .item__lire { font-weight: 600; font-size: 0.92rem; color: var(--accent-vif); }
</style>
