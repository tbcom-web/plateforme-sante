---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { site, nomPraticien, dateFr } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const crumbs = [{ name: 'Accueil', path: '/' }, { name: 'Conseils', path: '/actualites' }];
const articles = [...site.articles].sort((a, b) => b.date.localeCompare(a.date));
---
<Base
  title={`Conseils et actualités | ${nomPraticien}`}
  description={`Conseils pour prendre soin de vos pieds, par ${nomPraticien}, ${site.profession.libelle.toLowerCase()} à ${site.cabinet.ville}.`}
  path="/actualites"
  schemas={[breadcrumbSchema(crumbs)]}
  noindex={articles.length === 0}
>
  <section class="section">
    <div class="wrap">
      <Breadcrumb items={crumbs} />
      <h1>Conseils et actualités</h1>
      {articles.length === 0 && <p class="lead">Les premiers conseils arrivent bientôt.</p>}
      <div class="liste">
        {articles.map((a) => (
          <a class="card item" href={`/actualites/${a.slug}`}>
            <span class="tag">{a.theme} · <time datetime={a.date}>{dateFr(a.date)}</time></span>
            <h2>{a.titre}</h2>
            <p>{a.resume}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .liste { display: grid; gap: 16px; max-width: 820px; margin-top: 24px; }
  .item { text-decoration: none; color: inherit; }
  .item:hover { border-color: var(--brand-line); box-shadow: var(--shadow); color: inherit; }
  .item h2 { font-size: 1.35rem; margin-bottom: 0.4em; }
  .item p { color: var(--ink-soft); margin: 0; }
  .tag { font-size: 0.8rem; font-weight: 700; color: var(--brand-ink); }
</style>
