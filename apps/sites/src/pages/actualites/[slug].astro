---
// Article du flux de contenus : mise en page éditoriale, image 16:9 optimisée (dimensions fixes, priorité
// de chargement, og:image et ImageObject dans les données structurées), liens vers les autres conseils.
// Présentation (variante « article » du modèle ou de la recette, studio de recettes 2026-10-07) : standard (historique),
// lecture (colonne centrée, image en tête), latérale (image à côté du texte sur grand écran), chapô (chapô en grand et sommaire
// des intertitres). Même texte et mêmes titres (H1, H2) pour toutes ; les intertitres reçoivent une ancre (id) pour le sommaire.
// Lisibilité : mesure de 60 à 75 caractères (68ch) et interligne 1,7 dans toutes les présentations.
import Gabarit from '../../layouts/Gabarit.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { site, md, dateFr } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';
import { titreCabinet, praticiens, lienRdv, libelleRdv, lieu } from '../../lib/textes';
import { ancrerIntertitres, espacesFines, minutesLecture, sommaireMarkdown } from '@plateforme/core';
import { variantes } from '../../lib/gabarits';
import { photoResponsive } from '../../lib/visuels';
import type { Article } from '@plateforme/core';

export function getStaticPaths() {
  return site.articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const path = `/actualites/${article.slug}`;
const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Conseils', path: '/actualites' },
  { name: article.titre, path },
];
const auteur = praticiens.length === 1 ? `${`${praticiens[0].prenom} ${praticiens[0].nom}`.trim()}, ${praticiens[0].titre.toLowerCase()}` : titreCabinet;
const minutes = minutesLecture(article.corps);
const presentation = variantes.article ?? 'standard';
const sommaire = sommaireMarkdown(article.corps);
const corps = ancrerIntertitres(md(article.corps), sommaire);
const autres = [...site.articles].filter((a) => a.slug !== article.slug).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
---
<Gabarit
  title={`${article.titre} | ${site.cabinet.nom}`}
  description={article.resume}
  path={path}
  schemas={[articleSchema(article), breadcrumbSchema(crumbs)]}
  image={article.image ? { src: article.image, alt: article.imageAlt, largeur: 1600, hauteur: 900 } : undefined}
  article={{ date: article.date, theme: article.theme }}
>
  <article class:list={['section', 'article', `article--${presentation}`, { 'article--avec-image': Boolean(article.image) }]}>
    <header class="cadre article__tete">
      <Breadcrumb items={crumbs} />
      <p class="sur">{article.theme} · <time datetime={article.date}>{dateFr(article.date)}</time> · {minutes} min de lecture</p>
      <h1>{espacesFines(article.titre)}</h1>
      <p class="chapo">{article.resume}</p>
      <p class="article__auteur">Par <a href="/le-cabinet">{auteur}</a></p>
    </header>

    {presentation === 'chapo' && sommaire.length >= 2 && (
      <nav class="cadre article__sommaire" aria-label="Sommaire de l’article">
        <p class="sur">Sommaire</p>
        <ol>{sommaire.map((s) => <li><a href={`#${s.id}`}>{s.titre}</a></li>)}</ol>
      </nav>
    )}

    {article.image && (
      <figure class="cadre article__image">
        <img
          src={article.image}
          {...photoResponsive(article.image, 'min(1180px, 100vw)')}
          alt={article.imageAlt ?? ''}
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )}

    <div class="cadre article__corps">
      <div class="prose" set:html={corps} />

      <aside class="article__rdv" aria-label="Rendez-vous">
        <p><strong>Une question sur vos pieds ?</strong><span>{titreCabinet}{lieu.nom ? `, ${lieu.nom}` : ''}, {lieu.adresse}.</span></p>
        <a class="bouton bouton--plein" href={lienRdv(`article-${article.slug}`)}>{libelleRdv}</a>
      </aside>
    </div>

    {autres.length > 0 && (
      <nav class="cadre article__autres" aria-label="Autres conseils">
        <p class="sur">Autres conseils</p>
        <ul>
          {autres.map((a) => (
            <li><a href={`/actualites/${a.slug}`}><span>{a.theme}</span>{a.titre}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</Gabarit>

<style>
  .article__tete { max-width: 860px; }
  .article__tete h1 { font-size: clamp(2.2rem, 5vw, 4rem); margin: 4px 0 22px; }
  .article__tete .chapo { font-size: clamp(1.1rem, 1.6vw, 1.3rem); }
  .article__auteur { font-size: 0.92rem; color: var(--encre-douce); padding-top: 18px; border-top: var(--filet) solid var(--ligne); margin: 26px 0 0; }
  .article__auteur a { font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; min-height: 28px; }

  .article__image { margin-block: clamp(32px, 5vw, 56px); }
  .article__image img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--rayon-grand); background: var(--doux); }

  .article__corps { max-width: 860px; }
  /* Lisibilité (toutes présentations) : 60 à 75 caractères par ligne, interligne 1,7 */
  .article__corps .prose { font-size: 1.08rem; max-width: 68ch; line-height: 1.7; }
  .article__corps .prose :global(h2) { scroll-margin-top: 96px; }
  .article__corps .prose :global(h2) { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin-top: 2em; }
  .article__corps .prose :global(p:first-child) { font-size: 1.18rem; color: var(--encre); }

  .article__rdv { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-top: 48px; padding: 26px 28px; border-radius: var(--rayon); background: var(--doux); border: var(--filet) solid var(--accent-ligne); }
  .article__rdv p { margin: 0; display: grid; gap: 4px; }
  .article__rdv span { color: var(--encre-douce); font-size: 0.95rem; }

  .article__autres { max-width: 860px; margin-top: clamp(56px, 8vw, 96px); }
  .article__autres ul { list-style: none; padding: 0; margin: 0; border-top: var(--filet) solid var(--ligne); }
  .article__autres li { border-bottom: var(--filet) solid var(--ligne); }
  .article__autres a { display: grid; gap: 4px; padding: 18px 0; text-decoration: none; color: var(--encre); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.02em; }
  .article__autres a span { font-size: var(--taille-donnees-petit); font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-vif); }
  .article__autres a:hover { color: var(--accent-fonce); }
  /* ———— Présentations (variante « article ») : même balisage, mise en page seule ———— */
  /* Lecture : colonne centrée, image en tête */
  .article--lecture { display: flex; flex-direction: column; }
  .article--lecture .article__image { order: -1; max-width: 1040px; margin-block: 0 clamp(28px, 4vw, 48px); }
  .article--lecture :is(.article__tete, .article__corps, .article__autres) { max-width: calc(68ch + 40px); margin-inline: auto; }
  .article--lecture .article__tete { text-align: center; }
  .article--lecture .article__tete :global(.breadcrumb ol) { justify-content: center; }
  .article--lecture .article__tete .sur { justify-content: center; }
  .article--lecture .article__tete .chapo { margin-inline: auto; }
  .article--lecture .prose { margin-inline: auto; }
  /* Latérale : image à côté du texte (grand écran), collée pendant la lecture */
  @media (min-width: 1040px) {
    .article--laterale.article--avec-image { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 0.62fr); column-gap: clamp(32px, 4vw, 56px); width: min(1180px, 100% - 40px); margin-inline: auto; align-items: start; }
    .article--laterale.article--avec-image > :is(.article__tete, .article__corps, .article__autres) { grid-column: 1; width: auto; margin-inline: 0; }
    .article--laterale.article--avec-image .article__image { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: 96px; width: auto; margin: clamp(28px, 4vw, 48px) 0 0; }
    .article--laterale.article--avec-image .article__image img { aspect-ratio: 4 / 5; }
  }
  /* Chapô : chapô en grand, filet d'accent, sommaire des intertitres */
  .article--chapo .article__tete .chapo { font-size: clamp(1.3rem, 2.4vw, 1.75rem); line-height: 1.45; color: var(--encre); padding-left: 18px; border-left: var(--filet-fort) solid var(--accent-vif); max-width: 46ch; }
  .article__sommaire { max-width: 860px; margin-top: clamp(24px, 3vw, 36px); }
  .article__sommaire ol { margin: 6px 0 0; padding: 0 0 0 1.2em; display: grid; gap: 2px; }
  .article__sommaire li::marker { color: var(--accent-vif); font-weight: 700; }
  .article__sommaire a { display: inline-flex; align-items: center; min-height: var(--cible-tactile, 44px); font-weight: 600; color: var(--encre); }
  .article__sommaire a:hover { color: var(--accent-fonce); }

  /* Téléphone (≤ 759 px, TELEPHONE de la charte) */
  @media (max-width: 759px) {
    .article__auteur { font-size: var(--taille-texte-telephone); }
    .article__rdv { padding: 24px 20px; }
    .article__rdv span { font-size: var(--taille-texte-telephone); }
    .article__rdv :global(.bouton) { width: 100%; }
  }
</style>
