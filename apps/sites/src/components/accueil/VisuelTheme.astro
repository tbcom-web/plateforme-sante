---
// Visuel d'un sujet du cabinet (lib/vitrine.ts, visuelTheme) : photo teintée par la gamme, illustration « héros » composée du
// thème (core, heros-themes.ts : SVG sans texte, ≤ 12 Ko compressé, en ligne donc visible dès le premier affichage, format
// portrait ou paysage selon le cadre), animation existante, ou dessin validé chargé à l'approche de l'écran. Décoratif
// (aria-hidden) : le sujet est dit par le texte voisin. Le cadre réserve sa place (aucun décalage) ; la photo du premier
// écran est chargée en priorité (fetchpriority, srcset), les autres paresseusement.
import '@plateforme/core/dessins.css';
import Dessin from '../dessins/Dessin.astro';
import Animation from '../animations/Animation.astro';
import { photoResponsive, registre as registreSite } from '../../lib/visuels';
import { site } from '../../lib/site';
import type { VisuelTheme } from '../../lib/vitrine';
import { illustrationTheme, herosDiabete, lireCleHerosDiabete, htmlVisuelAnime, cssVisuelAnime, styleCouleursHeros, SCRIPT_VISUEL_ANIME, SCRIPT_PARTICULES, type AnimationEntete, type FormatHeros, type Registre } from '@plateforme/core';

interface Props {
  visuel: VisuelTheme;
  /** Premier écran : photo prioritaire */
  prioritaire?: boolean;
  /** Animation autorisée (premier écran du gabarit classique seulement) */
  animer?: boolean;
  /** Registre des dessins (par défaut : celui du modèle) */
  registre?: Registre;
  /** Format de l'illustration héros (portrait : cadres hauts et téléphone ; paysage : bandeaux) */
  format?: FormatHeros;
  sizes?: string;
  class?: string;
  /** Une seule grande illustration (le dessin principal du sujet), jamais l'assemblage du héros : cadres ronds ou petits
   *  (retour de l'atelier du 2026-10-07 : « une seule illustration dans le rond ») */
  seul?: boolean;
  /**
   * Visuel ANIMÉ du premier écran (heros-anime.ts, lib/vitrine.ts : animationPremierEcran) : l'animation à la place de
   * l'illustration ou de la photo, dans ce même cadre (place réservée, aucun décalage) ; image fixe sans script ou en réduction
   * des animations ; `nu` : sans panneau (posée sur le disque de la carte).
   */
  animationHeros?: AnimationEntete | null;
  nu?: boolean;
}
const { visuel, prioritaire = false, animer = false, registre = registreSite, format = 'portrait', sizes = '100vw', class: classe, seul = false, animationHeros = null, nu = false } = Astro.props;
// Visuel animé : panneau sombre de la gamme en relevé, clair « encre » sinon ; couleurs --hp-* du premier écran (heros-photo.ts)
const anime = animationHeros ? htmlVisuelAnime(animationHeros, { ton: registre === 'releve' ? 'sombre' : 'clair', nu }) : '';
const styleAnime = animationHeros ? styleCouleursHeros(site.modele, site.theme) : '';
const animation = visuel.type === 'dessin' && animer && registre === 'releve' ? visuel.animation : null;
// Illustration héros du thème : gamme du site (sans gamme, couleur libre : les variables de la page s'appliquent). Modèle à
// teinte « gamme » en relevé : toujours les variables de la page (plan, signal et pression dérivés de la gamme, teinteSombre),
// jamais le signal fixe de la fiche de la gamme (menthe sur cobalt : « du bleu et du vert mélangés »).
const gammeHeros = site.modele.jetons.teinte === 'gamme' && registre === 'releve' ? null : site.theme.gamme || null;
// Illustration validée de l'activité du praticien (lib/vitrine.ts) : à la place du dessin du thème (jamais d'une animation) ;
// sur un fond sombre (registre relevé), trait clair
const svgActivite = visuel.type === 'dessin' && visuel.svg && !animation ? visuel.svg : '';
// Héros d'un univers (diabète) validé par Paul et retenu par le kit illustré du site : son propre registre, même habillage
const univers = visuel.type === 'dessin' && !animation && !seul ? lireCleHerosDiabete(visuel.herosUnivers) : null;
const heros = univers
  ? herosDiabete(univers.nom, { format, registre: univers.registre, gamme: univers.registre === 'releve' && site.modele.jetons.teinte === 'gamme' ? null : site.theme.gamme || null, id: `hu-${univers.nom}-${format[0]}` })
  : visuel.type === 'dessin' && visuel.heros && !animation && !seul
  ? illustrationTheme(visuel.heros, { format, registre, gamme: gammeHeros, id: `h-${visuel.heros}-${format[0]}-${registre[0]}` })
  : '';
---
{anime ? (
  <div class:list={['vt', 'vt--visuel-anime', 'ha', classe]} data-ea style={styleAnime} aria-hidden="true">
    <Fragment set:html={`<style>${cssVisuelAnime(animationHeros!)}</style>${anime}`} />
  </div>
) : (
<div class:list={['vt', `vt--${heros || svgActivite ? 'heros' : visuel.type}`, animation ? 'vt--anime' : '', classe]} aria-hidden="true" style={svgActivite && registre === 'releve' ? '--dessin-ligne:var(--sur-sombre-doux);--dessin-trait:var(--sur-sombre-doux)' : undefined}>
  {visuel.type === 'photo' ? (
    <img src={visuel.src} {...photoResponsive(visuel.src, sizes)} alt="" width="1600" height="1067" style={`object-position:${visuel.cadrage}`} loading={prioritaire ? 'eager' : 'lazy'} fetchpriority={prioritaire ? 'high' : 'auto'} decoding={prioritaire ? 'sync' : 'async'} />
  ) : animation ? (
    <Animation nom={animation} releve />
  ) : svgActivite ? (
    <Fragment set:html={svgActivite} />
  ) : heros ? (
    <Fragment set:html={heros} />
  ) : registre === 'ligne' ? (
    <Dessin ligne={visuel.ligne} />
  ) : (
    <Dessin nom={visuel.dessin} registre={registre} />
  )}
</div>
)}
{anime && animationHeros === 'em-particules' && <script is:inline set:html={SCRIPT_PARTICULES} />}
{anime && <script is:inline set:html={SCRIPT_VISUEL_ANIME} />}

<style>
  .vt { position: relative; display: grid; place-items: center; width: 100%; height: 100%; overflow: hidden; isolation: isolate; }
  .vt :global(.dessin) { width: 100%; height: 100%; }
  .vt--heros > :global(svg) { display: block; width: 100%; height: 100%; }
  .vt--photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Teinte de la gamme sur la photo : voile coloré en mode « couleur douce », jamais au point de masquer la photo */
  .vt--photo::after { content: ''; position: absolute; inset: 0; background: var(--vt-teinte, var(--g-vif, var(--accent))); mix-blend-mode: multiply; opacity: 0.16; pointer-events: none; }
  .vt--anime { place-items: stretch; }
  .vt--anime :global(canvas), .vt--anime :global(svg) { width: 100%; height: 100%; }
</style>
