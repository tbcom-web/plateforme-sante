---
// Animation « trajectoire » (posture, biomécanique) : deux empreintes en trame de points (contour en
// pointillés) ; le centre de pression se trace du talon au gros orteil, pied après pied, et les zones
// d'appui (talon, bord externe, avant-pied, orteils) s'allument à son passage. Le tracé est celui de l'image
// fixe (core : contenuTrajectoire) ; ce composant n'ajoute que le mouvement.
// SVG + CSS, aucun script. Mouvement seulement quand le bloc est à l'écran (.en-vue, posée par Gabarit.astro
// sur .anime-visible) ; sinon, ou si le visiteur réduit les mouvements : image fixe complète.
// Registre « pedagogique » : schéma calme au trait, sans mouvement. Décoratif : aria-hidden.
import { contenuTrajectoire, svgAnimationFixe, type Registre } from '@plateforme/core';

interface Props { fond?: 'sombre' | 'clair'; registre?: Registre }
const { fond = 'sombre', registre = 'releve' } = Astro.props;
// Identifiants internes (trame définie une fois, posée par <use>) : uniques par instance dans la page
const id = `tj-${Math.random().toString(36).slice(2, 8)}`;
---
{registre === 'pedagogique' ? (
  <Fragment set:html={svgAnimationFixe('trajectoire', { registre })} />
) : (
  <svg class:list={['trajectoire', `trajectoire--${fond}`, 'anime-visible']} viewBox="0 0 400 300" aria-hidden="true" preserveAspectRatio="xMidYMid meet" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={contenuTrajectoire(id)} />
)}

<style>
  /* Palette de pression, pointillés, traits et cycle : charte du core */
  .trajectoire { display: block; width: 100%; height: 100%; --cycle: var(--cycle-pas); }
  .trajectoire--sombre { background: var(--fond-nuit); }
  .trajectoire--clair { --anim-trait: var(--dessin-trait, var(--encre)); --accent-pale: var(--dessin-accent, var(--accent-vif, var(--encre))); }
  .trajectoire :global(.tj-point) { opacity: 0; filter: drop-shadow(0 0 6px var(--pression-3)); }
  @media (prefers-reduced-motion: no-preference) {
    .trajectoire.en-vue :global(.tj-trajet) { stroke-dasharray: 1; animation: tj-trace var(--cycle) ease-in-out infinite backwards; animation-delay: calc(var(--j) * var(--cycle) / 2); }
    .trajectoire.en-vue :global(.tj-point) { animation: tj-avance var(--cycle) ease-in-out infinite backwards; animation-delay: calc(var(--j) * var(--cycle) / 2); }
    .trajectoire.en-vue :global(.tj-zone) { animation: tj-appui var(--cycle) ease-in-out infinite backwards; animation-delay: calc(var(--j) * var(--cycle) / 2 + var(--z) * var(--cycle) * 0.11); }
  }
  @keyframes tj-trace { 0% { stroke-dashoffset: 1; opacity: 1; } 45% { stroke-dashoffset: 0; opacity: 1; } 80% { stroke-dashoffset: 0; opacity: 0; } 100% { stroke-dashoffset: 1; opacity: 0; } }
  @keyframes tj-avance { 0% { offset-distance: 0%; opacity: 1; } 45% { offset-distance: 100%; opacity: 1; } 55%, 100% { offset-distance: 100%; opacity: 0; } }
  @keyframes tj-appui { 0% { opacity: 0.3; } 8% { opacity: 1; } 40%, 100% { opacity: 0.3; } }
</style>
