---
// Animation « coureur » (podologie du sport), façon laboratoire d'analyse du mouvement :
// squelette vu de profil avec marqueurs articulaires, trajectoires des marqueurs (tapis de course),
// angle du genou suivi en direct (arc seul : aucun texte, règle de Paul du 2026-10-06). Cinématique d'une foulée de course partagée avec l'image fixe
// (core : foulee.ts, d'après Novacheck 1998) : appui ≈ 38 % du cycle, pied d'appui fixé au sol, bras opposés aux jambes.
// Couleurs (palette de pression), traits, police des données et cadence viennent de la charte du core.
// Canvas, sans librairie. Décoratif : aria-hidden ; image fixe si le visiteur réduit les mouvements.
// Registre « pedagogique » : schéma calme au trait (chaussure de course), sans canvas ni mouvement.
import { svgAnimationFixe, type Registre } from '@plateforme/core';
interface Props { fond?: 'sombre' | 'clair'; registre?: Registre }
const { fond = 'sombre', registre = 'releve' } = Astro.props;
---
{registre === 'pedagogique' ? (
  <Fragment set:html={svgAnimationFixe('coureur', { registre })} />
) : (
  <canvas class:list={['coureur', `coureur--${fond}`]} data-fond={fond} aria-hidden="true"></canvas>
)}

<script>
  import { PRESSION, NEUTRES, TRAIT, POINTILLE, CYCLES, transparence } from '@plateforme/core/charte';
  import { poseCoureur, reculParCycle, type Pt } from '@plateforme/core/foulee';
  const CYCLE = CYCLES.foulee / 1000; // secondes par cycle (2 pas) → cadence ≈ 167 pas/min

  document.querySelectorAll<HTMLCanvasElement>('canvas.coureur').forEach((cv) => {
    const ctx = cv.getContext('2d')!;
    const sombre = cv.dataset.fond !== 'clair';
    const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let accent: string = PRESSION[1];
    const trait = (a: number) => transparence(sombre ? NEUTRES.blanc : NEUTRES.encre, a);
    const ratio = Math.min(2, devicePixelRatio || 1);
    // Image fixe au premier affichage ; mouvement lancé après le chargement de la page (debut > 0).
    let l = 0, h = 0, debut = 0, precedent = 0, visible = false, enCours = false;
    // Traces des marqueurs (cheville, genou, orteil de la jambe droite), décalées comme sur un tapis.
    const traces: Record<string, Pt[]> = { cheville: [], genou: [], orteil: [] };
    // Marqueurs suivis : couleurs de la palette de pression (genou = pic, cheville = moyenne, orteil = modérée)
    const COULEURS: Record<string, string> = { cheville: PRESSION[2], genou: PRESSION[4], orteil: PRESSION[1] };

    function dimensionner() {
      l = cv.clientWidth; h = cv.clientHeight;
      cv.width = l * ratio; cv.height = h * ratio;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      for (const k in traces) traces[k] = [];
      // Lecture des couleurs après la mise en page (aucun recalcul de style forcé avant le premier affichage)
      const style = getComputedStyle(cv);
      accent = style.getPropertyValue('--accent-pale').trim() || style.getPropertyValue('--signal').trim() || PRESSION[1];
    }

    function segment(a: Pt, b: Pt, largeur: number, couleur: string) {
      ctx.strokeStyle = couleur; ctx.lineWidth = largeur; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
    }
    /** Pied chaussé (foulee.ts) : contour lissé par les milieux des côtés, aplat léger et trait fin */
    function chaussure(pts: Pt[], couleur: string) {
      const m = (i: number) => { const a = pts[i % pts.length], b = pts[(i + 1) % pts.length]; return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }; };
      ctx.beginPath(); const d0 = m(0); ctx.moveTo(d0.x, d0.y);
      for (let i = 1; i <= pts.length; i++) { const p = pts[i % pts.length], q = m(i); ctx.quadraticCurveTo(p.x, p.y, q.x, q.y); }
      ctx.closePath(); ctx.fillStyle = couleur; ctx.globalAlpha = 0.25; ctx.fill(); ctx.globalAlpha = 1;
      ctx.strokeStyle = couleur; ctx.lineWidth = TRAIT.fin * 1.4; ctx.lineJoin = 'round'; ctx.stroke();
    }
    function marqueur(p: Pt, r: number, couleur: string = NEUTRES.blanc) {
      ctx.fillStyle = couleur; ctx.shadowColor = couleur; ctx.shadowBlur = r * 2.5;
      ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2); ctx.fill();
      ctx.shadowBlur = 0;
    }

    function dessiner(maintenant: number) {
      const anime = debut > 0;
      const t = anime ? 0.1 + (maintenant - debut) / 1000 : 0.1;
      const dt = Math.min(0.05, (maintenant - precedent) / 1000); precedent = maintenant;
      const p = (t / CYCLE) % 1;
      const taille = Math.min(h * 0.62, l * 0.9); // hauteur du squelette, tête comprise
      const L = taille * 0.5; // longueur de jambe
      const sol = h * 0.86;
      const X = (q: Pt): Pt => ({ x: l * 0.5 + q.x, y: sol + q.y });
      const pose = poseCoureur(p, L);
      const [bassin, epaule, tete] = [X(pose.bassin), X(pose.epaule), X(pose.tete)];
      const jambe = (j: typeof pose.droite) => ({ g: X(j.genou), c: X(j.cheville), t: X(j.talon), o: X(j.orteil), ch: j.chaussure.map(X) });
      const d = jambe(pose.droite), g = jambe(pose.gauche);
      const bd = { coude: X(pose.brasDroit.coude), main: X(pose.brasDroit.main) }, bg = { coude: X(pose.brasGauche.coude), main: X(pose.brasGauche.main) };

      ctx.clearRect(0, 0, l, h);

      // Grille du laboratoire et sol du tapis
      ctx.strokeStyle = trait(0.06); ctx.lineWidth = TRAIT.fin;
      const pas = Math.max(24, L / 4);
      for (let x = (l / 2) % pas; x < l; x += pas) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
      for (let y = sol % pas; y < h; y += pas) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(l, y); ctx.stroke(); }
      const vitesse = (reculParCycle(L) * L) / CYCLE; // défilement du tapis (px/s) : la vitesse du pied posé à plat
      // Sol du tapis en pointillés ronds, comme le contour d'un relevé de podoscope
      const tirets = [0, POINTILLE.contour.ecart * 2.5];
      ctx.strokeStyle = trait(0.35); ctx.lineWidth = TRAIT.fort; ctx.lineCap = 'round';
      ctx.setLineDash(tirets); ctx.lineDashOffset = (t * vitesse) % tirets[1];
      ctx.beginPath(); ctx.moveTo(0, sol + 2); ctx.lineTo(l, sol + 2); ctx.stroke(); ctx.setLineDash([]);

      // Traces des marqueurs (elles reculent avec le tapis)
      if (anime) {
        for (const k in traces) {
          const tr = traces[k];
          for (const q of tr) q.x -= vitesse * dt;
          tr.push({ ...(k === 'cheville' ? d.c : k === 'genou' ? d.g : d.o) });
          while (tr.length && tr[0].x < l * 0.04) tr.shift();
          ctx.strokeStyle = COULEURS[k]; ctx.lineWidth = TRAIT.normal;
          for (let i = 1; i < tr.length; i++) {
            ctx.globalAlpha = (i / tr.length) * 0.8;
            ctx.beginPath(); ctx.moveTo(tr[i - 1].x, tr[i - 1].y); ctx.lineTo(tr[i].x, tr[i].y); ctx.stroke();
          }
          ctx.globalAlpha = 1;
        }
      }

      // Membres côté gauche (en retrait), puis tronc, puis côté droit
      const pale = trait(0.33);
      const [arriere, avant] = [TRAIT.marque * 0.85, TRAIT.marque];
      segment(epaule, bg.coude, arriere, pale); segment(bg.coude, bg.main, arriere, pale);
      segment(bassin, g.g, arriere, pale); segment(g.g, g.c, arriere, pale); chaussure(g.ch, pale);
      segment(bassin, epaule, avant, accent);
      segment(bassin, d.g, avant, accent); segment(d.g, d.c, avant, accent); chaussure(d.ch, accent);
      segment(epaule, bd.coude, avant, accent); segment(bd.coude, bd.main, avant, accent);
      ctx.strokeStyle = accent; ctx.lineWidth = arriere; ctx.beginPath(); ctx.arc(tete.x, tete.y, L * 0.085, 0, Math.PI * 2); ctx.stroke();

      // Marqueurs articulaires
      for (const m of [g.g, g.c, g.o, bg.coude]) marqueur(m, 3, pale);
      marqueur(bassin, 4.5); marqueur(epaule, 4.5);
      marqueur(d.g, 4.5, COULEURS.genou); marqueur(d.c, 4.5, COULEURS.cheville); marqueur(d.o, 4, COULEURS.orteil); marqueur(bd.coude, 4);

      // Angle du genou droit : arc seul (aucun texte dans l'animation : règle de Paul, 2026-10-06)
      const a1 = Math.atan2(bassin.y - d.g.y, bassin.x - d.g.x), a2 = Math.atan2(d.c.y - d.g.y, d.c.x - d.g.x);
      ctx.strokeStyle = COULEURS.genou; ctx.lineWidth = TRAIT.normal;
      let ecart = a2 - a1; // angle intérieur : le plus court chemin entre cuisse et tibia
      if (ecart > Math.PI) ecart -= 2 * Math.PI;
      if (ecart < -Math.PI) ecart += 2 * Math.PI;
      ctx.beginPath(); ctx.arc(d.g.x, d.g.y, L * 0.12, a1, a1 + ecart, ecart < 0); ctx.stroke();
    }

    // Boucle d'animation : seulement une fois lancée et tant que le bloc est à l'écran.
    const image = (maintenant: number) => {
      dessiner(maintenant);
      if (visible) requestAnimationFrame(image);
      else enCours = false;
    };
    const relancer = () => {
      if (debut && visible && !enCours) { enCours = true; precedent = performance.now(); requestAnimationFrame(image); }
    };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; relancer(); }).observe(cv);
    // Premier appel juste après la mise en page initiale : l'image fixe figure dès le premier affichage.
    new ResizeObserver(() => {
      dimensionner();
      if (!enCours) dessiner(performance.now());
    }).observe(cv);
    if (!calme) {
      const lancer = () => { debut = performance.now(); relancer(); };
      const libre = () => ('requestIdleCallback' in window ? requestIdleCallback(lancer, { timeout: 2000 }) : setTimeout(lancer, 300));
      if (document.readyState === 'complete') libre();
      else addEventListener('load', libre, { once: true });
    }
  });
</script>

<style>
  .coureur { display: block; width: 100%; height: 100%; }
  .coureur--sombre { background: var(--fond-nuit); }
</style>
