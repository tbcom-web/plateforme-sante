---
// Animation « podoscope » : deux empreintes plantaires en trame hexagonale de points, colorées comme une
// carte de pression. Même géométrie de pied (pied.ts), même trame et même palette que les dessins
// (charte du core). Les points apparaissent par balayage, puis la pression se déplace du talon vers
// l'avant-pied comme pendant le pas. Canvas, sans librairie.
// Décoratif : aria-hidden ; image fixe si le visiteur réduit les mouvements.
interface Props { fond?: 'sombre' | 'clair' }
const { fond = 'sombre' } = Astro.props;
---
<canvas class:list={['podoscope', `podoscope--${fond}`]} aria-hidden="true"></canvas>

<script>
  import { couleurPression, TRAME, CYCLES, DUREES } from '@plateforme/core/charte';
  import { dansPlante, pression as pressionStatique } from '../dessins/trame';

  type Point = { x: number; y: number; b: number; zone: number; gauche: boolean };
  const L = 92, H = 222; // repère du pied (pied.ts)

  // Zone principale d'appui : 0 talon, 1 avant-pied, 2 orteils (repère du pied, orteils en haut).
  const zone = (y: number) => (y > 150 ? 0 : y > 38 ? 1 : 2);

  /** Points de la trame (repère du pied) pour un pied droit : contact au sol uniquement (voûte creuse). */
  function trameDuPied() {
    const pts: { x: number; y: number; b: number }[] = [];
    const pas = TRAME.pas;
    for (let rang = 0, y = 3; y <= H - 1; rang++, y += pas * 0.866) {
      for (let x = 6 + (rang % 2 ? pas / 2 : 0); x <= L - 4; x += pas) {
        if (!dansPlante(x, y)) continue;
        const b = pressionStatique('normal', x, y);
        if (b > 0) pts.push({ x, y, b });
      }
    }
    return pts;
  }
  const MODELE = trameDuPied();

  function construire(l: number, h: number) {
    const hauteur = Math.min(h * 0.74, l * 0.62);
    const k = hauteur / H; // px par unité du pied
    const largeur = L * k;
    const pts: Point[] = [];
    for (const gauche of [true, false]) {
      const ox = l / 2 + (gauche ? -largeur * 1.2 : largeur * 0.2);
      const oy = (h - hauteur) / 2 + (gauche ? hauteur * 0.04 : -hauteur * 0.04);
      for (const p of MODELE) {
        const x = gauche ? L - p.x : p.x; // le pied gauche est le miroir du droit
        pts.push({ x: ox + x * k, y: oy + p.y * k, b: p.b, zone: zone(p.y), gauche });
      }
    }
    return { pts, pasPx: TRAME.pas * k };
  }

  // Pression d'un point à l'instant t (un cycle de pas : talon → avant-pied → orteils).
  function pression(p: Point, t: number) {
    const phase = ((t / CYCLES.pouls) + (p.gauche ? 0 : 0.5)) % 1;
    const centre = phase < 0.35 ? 0 : phase < 0.75 ? 1 : 2;
    const base = [0.55, 0.62, 0.38][p.zone];
    const bonus = p.zone === centre ? 0.45 : p.zone === (centre + 2) % 3 ? 0.1 : 0;
    const intensite = 0.55 + 0.45 * p.b; // relief du relevé statique (bords du pied plus froids)
    return Math.min(1, (base + bonus) * intensite);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.podoscope').forEach((cv) => {
    const ctx = cv.getContext('2d')!;
    const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pts: Point[] = [], pasPx = 6, l = 0, h = 0;
    const debut = performance.now();
    const ratio = Math.min(2, devicePixelRatio || 1);
    const { min, max } = TRAME.diametre;

    function dimensionner() {
      l = cv.clientWidth; h = cv.clientHeight;
      cv.width = l * ratio; cv.height = h * ratio;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ({ pts, pasPx } = construire(l, h));
    }

    function dessiner(maintenant: number) {
      const t = calme ? DUREES.long : maintenant - debut;
      ctx.clearRect(0, 0, l, h);
      const balayage = calme ? 2 : Math.min(1.2, t / DUREES.trace); // apparition du haut vers le bas
      for (const p of pts) {
        const seuil = p.y / h;
        if (seuil > balayage) continue;
        const v = pression(p, t);
        const apparition = Math.min(1, (balayage - seuil) * 6);
        const rayon = (pasPx * (min + (max - min) * v)) / 2;
        ctx.globalAlpha = (0.35 + 0.65 * v) * apparition;
        ctx.fillStyle = couleurPression(v);
        ctx.shadowColor = ctx.fillStyle;
        ctx.shadowBlur = v > 0.7 ? rayon * 2.5 : 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, rayon, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!calme && visible) requestAnimationFrame(dessiner);
    }

    let visible = true;
    new IntersectionObserver(([e]) => {
      const etait = visible; visible = e.isIntersecting;
      if (visible && !etait) requestAnimationFrame(dessiner);
    }).observe(cv);
    new ResizeObserver(dimensionner).observe(cv);
    dimensionner();
    requestAnimationFrame(dessiner);
  });
</script>

<style>
  .podoscope { display: block; width: 100%; height: 100%; }
  .podoscope--sombre { background: var(--fond-nuit); }
  .podoscope--clair { background: transparent; }
</style>
