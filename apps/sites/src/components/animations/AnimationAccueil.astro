---
// Animation d'accueil retenue pour le site (spécialité, case cochée, style visuel autre que « photos »), ou rien.
import Animation from './Animation.astro';
import { animationAccueil } from '../../lib/visuels';

interface Props { fond?: 'sombre' | 'clair' }
const { fond = 'sombre' } = Astro.props;
---
<Animation nom={animationAccueil} fond={fond} />
