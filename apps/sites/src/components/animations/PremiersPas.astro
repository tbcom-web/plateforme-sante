---
// Animation « premiers pas » (enfant) : petites empreintes d'enfant en trame de points colorés par la
// pression, contour en pointillés, le long d'une ligne de marche en tirets, avec une cote de pas en mono.
// Chaque empreinte apparaît du talon vers les orteils, pas après pas, puis s'estompe. Le tracé est celui
// de l'image fixe (core : contenuPremiersPas) ; ce composant n'ajoute que le mouvement.
// SVG + CSS (opacité seulement), aucun script. Mouvement seulement quand le bloc est à l'écran (.en-vue,
// posée par Gabarit.astro sur .anime-visible) ; sinon, ou si le visiteur réduit les mouvements : image fixe complète.
// Registre « pedagogique » : schéma calme au trait, sans mouvement. Décoratif : aria-hidden.
import { contenuPremiersPas, svgAnimationFixe, type Registre } from '@plateforme/core';

interface Props { fond?: 'sombre' | 'clair'; registre?: Registre }
const { fond = 'sombre', registre = 'releve' } = Astro.props;
// Identifiants internes (trame définie une fois, posée par <use>) : uniques par instance dans la page
const id = `pp-${Math.random().toString(36).slice(2, 8)}`;
---
{registre === 'pedagogique' ? (
  <Fragment set:html={svgAnimationFixe('premiers-pas', { registre })} />
) : (
  <svg class:list={['pas', `pas--${fond}`, 'anime-visible']} viewBox="0 0 400 300" aria-hidden="true" preserveAspectRatio="xMidYMid meet" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={contenuPremiersPas(id)} />
)}

<style>
  .pas { display: block; width: 100%; height: 100%; --cycle: calc(var(--cycle-releve) * 1.5); }
  .pas--sombre { background: var(--fond-nuit); }
  /* Fond clair : trait de la surface parente (papier sur fond plan), sinon encre ; accent lisible */
  .pas--clair { --anim-trait: var(--dessin-trait, var(--encre)); --accent-pale: var(--dessin-accent, var(--accent-vif, var(--encre))); }
  @media (prefers-reduced-motion: no-preference) {
    /* Pas après pas (--i), puis bandes de points du talon (--b = 0) vers les orteils (--b = 4) */
    .pas.en-vue :global(.pp-pas) { animation: pp-pas var(--cycle) linear infinite backwards; animation-delay: calc(var(--i) * var(--duree-moyen)); }
    .pas.en-vue :global(.pp-bande) { animation: pp-bande var(--cycle) var(--courbe-sortie) infinite backwards; animation-delay: calc(var(--i) * var(--duree-moyen) + var(--b) * var(--duree-decalage) * 1.5); }
  }
  @keyframes pp-pas { 0% { opacity: 0; } 2% { opacity: 1; } 70% { opacity: 1; } 84%, 100% { opacity: 0; } }
  @keyframes pp-bande { 0% { opacity: 0; } 4%, 100% { opacity: 1; } }
</style>
