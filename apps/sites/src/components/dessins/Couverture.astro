---
// Couverture générée d'un article (quand il n'a pas de photo) : planche technique sur fond plan
// d'architecte, dessin choisi selon le thème de l'article, sans texte incrusté (ni cartouche, ni « Fig. », ni mention :
// règle de Paul du 2026-10-06). Décorative.
// En mode photos, la photo de la banque associée au même dessin (lib/visuels-soins.ts) la remplace ;
// la photo propre de l'article, quand elle existe, reste prioritaire (gérée par la page).
import Dessin from './Dessin.astro';
import { dessinArticle } from '../../lib/dessins';
import { photoDessin } from '../../lib/visuels-soins';
import { enPhotos, photoResponsive } from '../../lib/visuels';

interface Props {
  theme?: string;
  titre?: string;
  /** Numéro affiché dans le cartouche (« Fig. 01 ») */
  numero?: number;
  class?: string;
  /** Toujours la planche dessinée, quel que soit le style visuel (planches de démonstration) */
  dessinSeul?: boolean;
}
const { theme = '', titre = '', numero = 1, class: classe, dessinSeul = false } = Astro.props;
const nom = dessinArticle(theme, titre);
const photo = enPhotos && !dessinSeul ? photoDessin(nom) : null;
---
{photo ? (
<span class:list={['couverture', 'couverture--photo', classe]} aria-hidden="true">
  <img src={photo.photo} {...photoResponsive(photo.photo, '(min-width: 1000px) 40vw, 100vw')} alt="" width="1600" height="900" loading="lazy" decoding="async" style={`object-position:${photo.cadrage}`} />
</span>
) : (
<span class:list={['couverture', 'surface-plan', classe]} aria-hidden="true">
  <span class="couverture__dessin"><Dessin nom={nom} cadre /></span>
</span>
)}

<style>
  .couverture { position: relative; display: grid; grid-template-rows: minmax(0, 1fr); aspect-ratio: 16 / 9; padding: 12px 14px; overflow: hidden; }
  .couverture--photo { display: block; padding: 0; }
  .couverture--photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .couverture__haut, .couverture__bas { display: flex; justify-content: space-between; gap: 12px; font-size: var(--taille-donnees-petit); letter-spacing: var(--interlettrage-donnees); text-transform: uppercase; color: var(--sur-sombre-doux); }
  .couverture__haut { padding-bottom: 8px; border-bottom: var(--filet) solid var(--sur-sombre-filet); }
  .couverture__haut span:first-child { color: var(--signal); }
  .couverture__bas { padding-top: 8px; border-top: var(--filet) solid var(--sur-sombre-filet); text-transform: none; letter-spacing: 0.02em; color: var(--sur-sombre-pale); }
  .couverture__dessin { display: grid; place-items: center; min-height: 0; padding: 6px 0; }
  /* Dessin cadré (retour de Paul du 2026-10-10) : il remplit la couverture, centré sur son tracé réel ; un fond perdu sort par le bord */
  .couverture__dessin :global(.dessin) { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform var(--duree-moyen) var(--courbe-sortie); }
  :global(a:hover) > .couverture .couverture__dessin :global(.dessin), :global(a:hover) .couverture .couverture__dessin :global(.dessin) { transform: scale(1.05); }
</style>
