---
// Paire d'empreintes en trame hexagonale de points (relevé de baropodométrie), avec ligne de scan
// et légende graduée. Décoratif (aria-hidden) ; la ligne de scan ne tourne que lorsque le bloc est à l'écran.
import { CONTOUR, ORTEILS } from '../animations/pied';
import { trame, PRESSION, type Appui } from './trame';

interface Props {
  appui?: Appui;
  /** Légende graduée verticale à droite */
  legende?: boolean;
  /** Ligne de scan animée */
  scan?: boolean;
  class?: string;
}
const { appui = 'normal', legende = true, scan = true, class: classe } = Astro.props;
const id = `e-${Math.random().toString(36).slice(2, 8)}`;
const niveaux = trame(appui, 6.4);
const largeur = legende ? 236 : 210;
---
<svg class:list={['empreintes', classe, { 'empreintes--scan': scan }]} viewBox={`0 0 ${largeur} 236`} aria-hidden="true" fill="none" stroke-linecap="round">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="1" x2="0" y2="0">
      {PRESSION.map((c, k) => <stop offset={[0, 0.35, 0.6, 0.8, 1][k]} stop-color={c} />)}
    </linearGradient>
    <linearGradient id={`${id}-s`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--signal, #6ff2c2)" stop-opacity="0" />
      <stop offset="1" stop-color="var(--signal, #6ff2c2)" stop-opacity="0.2" />
    </linearGradient>
  </defs>
  {[`translate(10 7) scale(-1 1) translate(-92 0)`, `translate(108 7)`].map((t) => (
    <g transform={t}>
      <path class="empreintes__contour" d={CONTOUR} />
      {ORTEILS.map(([cx, cy, rx, ry, r]) => <ellipse class="empreintes__contour" cx={cx} cy={cy} rx={rx} ry={ry} transform={`rotate(${r} ${cx} ${cy})`} />)}
      {niveaux.map((n) => <path d={n.d} stroke={n.couleur} stroke-width={n.epaisseur} />)}
    </g>
  ))}
  {scan && (
    <g class="empreintes__scan">
      <rect x="0" y="-18" width="210" height="18" fill={`url(#${id}-s)`} />
      <rect x="0" y="-0.6" width="210" height="0.9" fill="var(--signal, #6ff2c2)" />
    </g>
  )}
  {legende && (
    <g>
      <rect x="226" y="40" width="5" height="156" fill={`url(#${id}-g)`} />
      {[40, 79, 118, 157, 196].map((y) => <line class="empreintes__graduation" x1="221" x2="224" y1={y} y2={y} />)}
    </g>
  )}
</svg>

<style>
  .empreintes { display: block; width: 100%; height: auto; overflow: visible; }
  .empreintes__contour { stroke: currentColor; stroke-width: 1.2; stroke-dasharray: 0 4.5; opacity: 0.5; }
  .empreintes__graduation { stroke: currentColor; stroke-width: 1; opacity: 0.5; }
  .empreintes__scan { animation: scan 5.5s cubic-bezier(.65,0,.35,1) infinite; animation-play-state: paused; }
  :global(.en-vue) .empreintes__scan { animation-play-state: running; }
  @keyframes scan { 0% { transform: translateY(0); opacity: 0; } 8% { opacity: 1; } 70% { opacity: 1; } 78%, 100% { transform: translateY(236px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .empreintes__scan { display: none; } }
</style>
