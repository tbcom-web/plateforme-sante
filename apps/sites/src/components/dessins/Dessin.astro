---
// Dessins techniques de la marque : trait anatomique fin, contours en pointillés (relevé de podoscope),
// trame hexagonale de points colorés par la pression (bleu → vert d'eau → jaune → orange → rouge).
// Le tracé est dans le core (packages/core/src/dessins.ts, svgDessin), partagé avec l'aperçu de l'admin ;
// les styles sont dans packages/core/src/dessins.css. Ce composant n'en est qu'une enveloppe.
// Couleurs (surchargeables par le parent) : --dessin-trait, --dessin-accent, --dessin-fond ; le reste vient de la charte.
// Les traits marqués « trace » se dessinent quand le bloc parent apparaît (.apparait.vu).
import '@plateforme/core/dessins.css';
import { svgDessin, type NomDessin } from '@plateforme/core';
export type { NomDessin } from '@plateforme/core';

interface Props {
  nom: NomDessin;
  class?: string;
}

const { nom, class: classe } = Astro.props;
// Identifiant unique par instance : plusieurs dessins identiques peuvent cohabiter dans une page.
const id = `d-${Math.random().toString(36).slice(2, 8)}`;
---
<Fragment set:html={svgDessin(nom, { id, classe })} />
