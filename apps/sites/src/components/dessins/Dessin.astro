---
// Dessins techniques de la marque : trait anatomique fin, contours en pointillés (relevé de podoscope),
// trame hexagonale de points colorés par la pression (bleu → vert d'eau → jaune → orange → rouge).
// Le tracé est dans le core (packages/core/src/dessins.ts, svgDessin), partagé avec l'aperçu de l'admin.
// Sur le site, chaque dessin est un fichier statique généré au build (pages/dessins/[fichier].svg.ts) que ce
// composant référence par <use> : la page ne recopie pas le tracé (HTML léger, fichier mis en cache), et le
// dessin hérite des couleurs de la page — --dessin-trait, --dessin-accent, --dessin-fond (surchargeables par
// le parent, par exemple .surface-plan), palette de pression et accent de la gamme.
// Registre « pedagogique » : schéma au trait, sans trame ni lecture. Registre « ligne » : dessin au trait continu (ligne.ts) ;
// le tracé se dessine à l'apparition (ChargeurDessins, data-trace ; trait complet si le visiteur réduit les mouvements). La
// prop `ligne` pose directement un dessin du registre ligne par son nom (DESSINS_LIGNE). Décoratif : aria-hidden.
import '@plateforme/core/dessins.css';
import { cadrageDessin, cleCadrage, type NomDessin, type NomLigne, type Registre } from '@plateforme/core';
import { urlDessin, suffixeRegistre } from '../../lib/fichiers-dessins';
import ChargeurDessins from './ChargeurDessins.astro';
import { registre as registreSite } from '../../lib/visuels';
export type { NomDessin } from '@plateforme/core';

interface Props {
  nom?: NomDessin;
  /** Dessin du registre « ligne » par son nom (sinon : celui qui correspond à `nom`) */
  ligne?: NomLigne;
  class?: string;
  /** « releve », « pedagogique » ou « ligne » (par défaut : registre du modèle) */
  registre?: Registre;
  /** Registre ligne : le trait se dessine à l'apparition (par défaut : oui) */
  trace?: boolean;
  /**
   * Dessin posé dans une CASE (carte de soin, vignette) : viewBox recadré sur le tracé réel, centré, marge régulière, fond perdu
   * calé au bord (core : cadrages-dessins.ts ; retour de Paul du 2026-10-10). Le <svg> doit alors remplir la case.
   */
  cadre?: boolean;
}

const { nom = 'appuis', ligne, class: classe, registre: registreProp = registreSite, trace = true, cadre = false } = Astro.props;
const registre: Registre = ligne ? 'ligne' : registreProp;
const fichier = urlDessin(ligne ? `ligne-${ligne}` : `${nom}${suffixeRegistre(registre)}`);
const anime = registre === 'ligne' && trace ? '' : undefined;
const cadrage = cadre ? cadrageDessin(ligne ? `ligne:${ligne}` : cleCadrage(nom, registre)) : null;
const viewBox = cadrage?.viewBox ?? '0 0 240 180';
const preserveAspectRatio = cadrage?.preserveAspectRatio;
---
<svg class:list={['dessin', `dessin--${ligne ?? nom}`, `dessin--${registre}`, { 'dessin--cadre': cadrage, 'dessin--ouvert': cadrage?.ouvert }, classe]} viewBox={viewBox} preserveAspectRatio={preserveAspectRatio} aria-hidden="true" data-trace={anime}><use data-dessin={fichier} width="240" height="180" /></svg>
<noscript><svg class:list={['dessin', `dessin--${ligne ?? nom}`, `dessin--${registre}`, { 'dessin--cadre': cadrage, 'dessin--ouvert': cadrage?.ouvert }, classe]} viewBox={viewBox} preserveAspectRatio={preserveAspectRatio} aria-hidden="true"><use href={fichier} width="240" height="180" /></svg><style>svg:has(> use[data-dessin]){display:none}</style></noscript>
<ChargeurDessins />
<style is:global>
  /* Fenêtre ouverte (core : DESSINS_FENETRE_OUVERTE) : la pièce de la bibliothèque continue jusqu'au bord de la case */
  svg.dessin--ouvert svg { overflow: visible; }
</style>
