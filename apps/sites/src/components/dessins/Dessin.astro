---
// Dessins techniques de la marque : trait anatomique fin, contours en pointillés (relevé de podoscope),
// trame hexagonale de points colorés par la pression (bleu → vert d'eau → jaune → orange → rouge).
// Même géométrie de pied que les animations d'accueil.
// Couleurs (surchargeables par le parent) : --dessin-trait, --dessin-accent, --dessin-fond ; le reste vient de la charte.
// Les traits marqués « trace » se dessinent quand le bloc parent apparaît (.apparait.vu).
import { CONTOUR, ORTEILS } from '../animations/pied';
import { trame, type Appui } from './trame';
import { PRESSION, ARRETS_PRESSION, TRAIT } from '@plateforme/core';
import type { NomDessin } from '../../lib/dessins';
export type { NomDessin } from '../../lib/dessins';

interface Props {
  nom: NomDessin;
  class?: string;
}

const { nom, class: classe } = Astro.props;
const id = `d-${Math.random().toString(36).slice(2, 8)}`;
const pied = `${id}-pied`;
const degrade = `${id}-degrade`;
const loupe = `${id}-loupe`;
// Échelle d'un pied (repère 92 × 222) dans le dessin (240 × 180).
const E = 0.68;
const piedDroit = (x: number, y: number, e = E) => `translate(${x} ${y}) scale(${e})`;
const piedGauche = (x: number, y: number, e = E) => `translate(${x + 92 * e} ${y}) scale(${-e} ${e})`;
const points = (appui: Appui, pas?: number) => trame(appui, pas);
// Sites du test au monofilament (repère du pied).
const sites: [number, number][] = [[27, 16], [56, 20], [75, 35], [24, 62], [48, 50], [72, 62], [34, 120], [68, 132], [48, 196]];

// Soin : loupe sur l'ongle du gros orteil, reliée au détail agrandi par ses deux tangentes extérieures.
const S = { x: 14, y: 20, e: 0.64 };
const c1 = { x: S.x + (92 - 27) * S.e, y: S.y + 9 * S.e, r: 12 };
const c2 = { x: 170, y: 92, r: 56 };
const tangentes = (() => {
  const dx = c2.x - c1.x, dy = c2.y - c1.y, d = Math.hypot(dx, dy);
  const t = Math.atan2(dy, dx), a = Math.acos((c1.r - c2.r) / d);
  return [t + a, t - a].map((n) => [c1.x + c1.r * Math.cos(n), c1.y + c1.r * Math.sin(n), c2.x + c2.r * Math.cos(n), c2.y + c2.r * Math.sin(n)].map((v) => +v.toFixed(1)));
})();

// Sport : chaussure de course de profil (talon à gauche), hauteurs de semelle au talon et à l'avant-pied.
const SOL = 150;
const lacets = [[118, 82], [129, 88], [140, 94], [151, 99], [162, 104]];
---
<svg class:list={['dessin', `dessin--${nom}`, classe]} viewBox="0 0 240 180" aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <symbol id={pied} viewBox="0 0 92 222" width="92" height="222" overflow="visible">
      <path d={CONTOUR} />
      {ORTEILS.map(([cx, cy, rx, ry, r]) => <ellipse cx={cx} cy={cy} rx={rx} ry={ry} transform={`rotate(${r} ${cx} ${cy})`} />)}
    </symbol>
    <linearGradient id={degrade} x1="0" y1="1" x2="0" y2="0">
      {PRESSION.map((c, k) => <stop offset={ARRETS_PRESSION[k]} stop-color={c} />)}
    </linearGradient>
    <clipPath id={loupe}><circle cx={c2.x} cy={c2.y} r={c2.r - 1} /></clipPath>
  </defs>

  {nom === 'analyse' && (
    <g>
      <g class="grille">{[40, 80, 120, 160].map((y) => <line x1="16" x2="200" y1={y} y2={y} />)}</g>
      {[piedGauche(52, 12), piedDroit(126, 12)].map((t) => (
        <g transform={t}>
          <use href={`#${pied}`} class="pointille pointille--leger" />
          <g class="trame">{points('normal').map((n) => <path d={n.d} stroke={n.couleur} stroke-width={n.epaisseur} style={`--k:${n.k}`} />)}</g>
        </g>
      ))}
      <g class="legende">
        <rect x="218" y="30" width="5" height="116" fill={`url(#${degrade})`} />
        {[30, 59, 88, 117, 146].map((y) => <line class="cote" x1="214" x2="217" y1={y} y2={y} />)}
        <text class="mono" x="220.5" y="24" text-anchor="middle">+</text>
        <text class="mono" x="220.5" y="158" text-anchor="middle">−</text>
      </g>
    </g>
  )}

  {nom === 'appuis' && (
    <g>
      <g class="grille">{[30, 60, 90, 120, 150].map((y) => <line x1="16" x2="200" y1={y} y2={y} />)}</g>
      <g transform={piedDroit(30, 8, 0.74)}>
        <use href={`#${pied}`} class="pointille pointille--leger" />
        <g class="trame">{points('avant').map((n) => <path d={n.d} stroke={n.couleur} stroke-width={n.epaisseur} style={`--k:${n.k}`} />)}</g>
        <circle class="anneau-chaud" cx="32" cy="60" r="14" />
        <circle class="anneau-chaud pulse" cx="32" cy="60" r="14" />
      </g>
      <line class="trace fin" pathLength="1" x1={30 + 32 * 0.74 + 11} y1={8 + 60 * 0.74 - 6} x2="150" y2="38" />
      <text class="mono" x="152" y="40">zone d’appui</text>
      <g class="barres">
        <text class="mono" x="128" y="122">pic</text>
        <rect class="piste" x="148" y="117" width="56" height="5" /><rect class="barre" x="148" y="117" width="49" height="5" fill="var(--d-chaud)" />
        <text class="mono" x="128" y="136">moy.</text>
        <rect class="piste" x="148" y="131" width="56" height="5" /><rect class="barre" x="148" y="131" width="25" height="5" fill="var(--d-froid)" />
      </g>
      <g class="legende">
        <rect x="218" y="30" width="5" height="116" fill={`url(#${degrade})`} />
        <path class="curseur" d="M213 44 l-6 -3.5 v7 z" />
      </g>
    </g>
  )}

  {nom === 'semelle' && (
    <g>
      <g transform={piedDroit(40, 12)}>
        {[1, 0.8, 0.6, 0.42, 0.25].map((e, k) => (
          <path class="trace niveau" d={CONTOUR} pathLength="1" transform={`translate(${47 * (1 - e)} ${125 * (1 - e)}) scale(${e})`}
            style={`--k:${k};stroke:${['var(--d-trait)', 'var(--d-bas)', 'var(--d-froid)', 'var(--d-doux)', 'var(--d-chaud)'][k]};stroke-width:${TRAIT.normal / e / E}`} />
        ))}
      </g>
      <g class="profil">
        <path class="trace" pathLength="1" d="M128 150 C150 152 184 152 214 146 L216 138 C196 134 178 126 160 118 C146 112 134 114 130 124 C127 132 127 142 128 150 Z" />
        <path class="trace fin" pathLength="1" d="M132 138 C160 140 190 140 214 138" />
        <path class="trace fin" pathLength="1" d="M136 128 C150 126 162 128 176 134" />
        <line class="cote" x1="128" y1="162" x2="216" y2="162" />
        <line class="cote" x1="128" y1="158" x2="128" y2="166" />
        <line class="cote" x1="216" y1="158" x2="216" y2="166" />
      </g>
    </g>
  )}

  {nom === 'soin' && (
    <g>
      <g transform={piedGauche(S.x, S.y, S.e)}>
        <use href={`#${pied}`} class="trait" />
        {ORTEILS.map(([cx, cy, rx, ry, r]) => (
          <rect class="ongle-petit" x={cx - rx * 0.55} y={cy - ry * 0.8} width={rx * 1.1} height={ry * 0.85} rx={rx * 0.45} transform={`rotate(${r} ${cx} ${cy})`} />
        ))}
      </g>
      <circle class="trace mire" cx={c1.x} cy={c1.y} r={c1.r} pathLength="1" />
      {tangentes.map(([x1, y1, x2, y2]) => <line class="trace liaison" pathLength="1" x1={x1} y1={y1} x2={x2} y2={y2} />)}
      <circle class="fond-loupe" cx={c2.x} cy={c2.y} r={c2.r} />
      <g clip-path={`url(#${loupe})`} class="zoom">
        <path class="trace" pathLength="1" d="M136 162 C134 128 136 88 149 68 C157 54 183 54 191 68 C204 88 206 128 204 162" />
        <path class="trace ongle" pathLength="1" d="M150 84 C151 72 189 72 190 84 L193 124 C183 131 157 131 147 124 Z" />
        <path class="trace fin" pathLength="1" d="M155 121 C163 111 177 111 185 121" />
        <path class="trace fin" pathLength="1" d="M152 82 C162 77 178 77 188 82" />
        <path class="sillon" d="M143 82 C139 98 139 114 142 132" />
        <path class="sillon" d="M197 82 C201 98 201 114 198 132" />
        <circle class="anneau-chaud pulse" cx="142" cy="104" r="9" />
        {[[142, 96, 3.2, 'var(--d-chaud)'], [141.2, 106, 2.8, 'var(--d-haut)'], [142, 116, 2.2, 'var(--d-doux)']].map(([x, y, r, c], k) => (
          <circle class="point" cx={x} cy={y} r={r} fill={c as string} style={`--k:${k}`} />
        ))}
      </g>
      <circle class="trace loupe" cx={c2.x} cy={c2.y} r={c2.r} pathLength="1" />
      {[0, 90, 180, 270].map((a) => (
        <line class="cote" x1={c2.x + (c2.r + 3) * Math.cos((a * Math.PI) / 180)} y1={c2.y + (c2.r + 3) * Math.sin((a * Math.PI) / 180)}
          x2={c2.x + (c2.r + 8) * Math.cos((a * Math.PI) / 180)} y2={c2.y + (c2.r + 8) * Math.sin((a * Math.PI) / 180)} />
      ))}
      <text class="mono" x={c2.x + c2.r + 2} y={c2.y + c2.r + 10} text-anchor="end">× 6</text>
    </g>
  )}

  {nom === 'diabete' && (
    <g>
      <g transform={piedDroit(56, 10, 0.72)}>
        <use href={`#${pied}`} class="pointille" />
        {sites.map(([x, y], k) => (
          <g style={`--k:${k}`} class="site">
            <circle class="anneau" cx={x} cy={y} r="8.5" />
            <circle class="point" cx={x} cy={y} r="3" fill="var(--d-accent)" style={`--k:${k}`} />
          </g>
        ))}
      </g>
      <g class="filament">
        <rect class="trace" pathLength="1" x="176" y="24" width="12" height="62" rx="6" />
        <path class="trace" pathLength="1" d="M182 86 C182 104 178 116 168 126" />
        <circle class="point" cx="168" cy="126" r="2.6" fill="var(--d-chaud)" style="--k:10" />
      </g>
    </g>
  )}

  {nom === 'sport' && (
    <g>
      <!-- Courbe de force verticale pendant l'appui (double bosse : impact puis propulsion) -->
      <g class="courbe">
        <line class="cote" x1="172" y1="44" x2="230" y2="44" />
        <line class="cote" x1="172" y1="44" x2="172" y2="10" />
        <path class="trace force-courbe" pathLength="1" d="M172 44 C176 44 177 22 181 20 C184 19 185 29 189 29 C195 29 197 12 204 12 C212 12 214 44 222 44" />
        <text class="mono" x="174" y="9">F(t)</text>
      </g>
      <!-- Sol -->
      <line class="sol" x1="12" y1={SOL} x2="232" y2={SOL} />
      <g class="hachures">{Array.from({ length: 22 }, (_, k) => <line x1={16 + k * 10} y1={SOL + 2} x2={10 + k * 10} y2={SOL + 8} />)}</g>
      <!-- Semelle extérieure crantée et semelle intermédiaire (plus épaisse au talon : drop) -->
      <path class="trace semelle" pathLength="1" d="M44 126 C37 129 35 138 36 143 C37 147 41 150 47 150 L150 150 C172 150 196 147 213 138 C218 135 218 131 212 131 C200 132 186 133 172 133 C140 132 90 128 44 126 Z" />
      <path class="trace fin" pathLength="1" d="M38 144.5 C40 145 43 145 47 145 L150 145 C171 145 193 142.5 209 135" />
      <path class="crampons" d="M49 147.6 L150 147.6 C171 147.6 192 145 208 137" />
      <path class="trace fin" pathLength="1" d="M44 136 C80 138 130 140 170 141 C186 141 200 139 210 136" />
      <!-- Tige : contrefort, col, languette, laçage, pare-pierres -->
      <path class="trace" pathLength="1" d="M44 126 C38 112 38 98 44 88 C48 82 55 81 60 85 C66 90 75 91 83 87 C89 83 93 77 99 73 C103 70 108 71 110 75 C123 89 150 102 180 112 C196 117 208 123 212 131" />
      <path class="trace fin" pathLength="1" d="M49 121 C46 110 47 99 53 92" />
      <path class="trace fin" pathLength="1" d="M180 133 C186 123 200 122 210 127" />
      <path class="trace fin" pathLength="1" d="M66 122 C92 116 128 112 166 111" />
      <path class="trace fin" pathLength="1" d="M45 89 C41 86 41 81 45 80 C48 79 51 81 52 84" />
      {lacets.map(([x, y], k) => (
        <g>
          <circle class="oeillet" cx={x} cy={y} r="1.5" />
          <line class="lacet" x1={x + 2.4} y1={y - 4.6} x2={x - 2.4} y2={y + 4.6} style={`--k:${k}`} />
        </g>
      ))}
      <!-- Cotes : hauteurs de semelle au talon et à l'avant-pied -->
      <line class="guide" x1="20" y1="126" x2="44" y2="126" />
      <line class="cote" x1="24" y1="126" x2="24" y2={SOL} />
      <line class="cote" x1="21" y1="126" x2="27" y2="126" />
      <text class="mono" x="20" y="141" text-anchor="end">32</text>
      <line class="guide" x1="172" y1="133" x2="230" y2="133" />
      <line class="cote" x1="226" y1="133" x2="226" y2={SOL} />
      <line class="cote" x1="223" y1="133" x2="229" y2="133" />
      <text class="mono" x="231" y="145">24</text>
      <text class="mono mono--accent" x="124" y="172" text-anchor="middle">drop 8 mm</text>
      <!-- Force de réaction du sol à l'attaque du talon -->
      <line class="trace force" pathLength="1" x1="62" y1={SOL} x2="55" y2="104" />
      <path class="force-fleche" d="M51.2 112.8 L55 103.2 L60.6 111.8" />
      <circle class="point" cx="62" cy={SOL} r="3" fill="var(--d-chaud)" style="--k:2" />
      <text class="mono mono--chaud" x="62" y="112">FRS</text>
    </g>
  )}

  {nom === 'enfant' && (
    <g>
      <g transform={piedDroit(48, 12, 0.7)}>
        <use href={`#${pied}`} class="pointille" />
      </g>
      <g transform={`${piedDroit(132, 70, 0.4)} rotate(6 46 111)`}>
        <use href={`#${pied}`} class="pointille pointille--leger" />
        <g class="trame">{points('enfant', 9).map((n) => <path d={n.d} stroke={n.couleur} stroke-width={n.epaisseur} style={`--k:${n.k}`} />)}</g>
      </g>
      <g class="toise">
        <line class="trace" pathLength="1" x1="206" y1="20" x2="206" y2="166" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => <line class="cote" x1="200" x2={k % 2 ? 206 : 212} y1={28 + k * 18} y2={28 + k * 18} />)}
      </g>
    </g>
  )}

  {nom === 'equilibre' && (
    <g>
      <path class="trace polygone" pathLength="1" d="M70 20 L176 20 L184 168 L62 168 Z" />
      <g transform={piedGauche(64, 16, 0.64)}><use href={`#${pied}`} class="trait" /></g>
      <g transform={piedDroit(124, 16, 0.64)}><use href={`#${pied}`} class="trait" /></g>
      <path class="trace oscillation" pathLength="1" d="M120 96 C130 88 134 104 124 108 C112 112 108 92 118 88 C128 84 132 100 122 104" />
      <circle class="point" cx="121" cy="98" r="4" fill="var(--d-chaud)" style="--k:2" />
    </g>
  )}

  {nom === 'talon' && (
    <g>
      <g transform={piedDroit(74, 8, 0.72)}><use href={`#${pied}`} class="trait" /></g>
      {[14, 24, 34].map((r, k) => <circle class="trace onde" cx={74 + 47 * 0.72} cy={8 + 192 * 0.72} r={r} pathLength="1" style={`--k:${k}`} />)}
      <circle class="point" cx={74 + 47 * 0.72} cy={8 + 192 * 0.72} r="5" fill="var(--d-chaud)" style="--k:3" />
    </g>
  )}
</svg>

<style>
  /* Toutes les valeurs viennent de la charte (packages/core/src/charte.ts) : traits, pointillés, palette
     de données de l'univers (--pression-1 à 5), annotations mono, durées et courbes. */
  .dessin {
    --d-trait: var(--dessin-trait, var(--encre)); --d-accent: var(--dessin-accent, var(--accent-vif, var(--encre))); --d-fond: var(--dessin-fond, var(--blanc));
    --d-bas: var(--pression-1); --d-froid: var(--pression-2); --d-doux: var(--pression-3); --d-haut: var(--pression-4); --d-chaud: var(--pression-5);
    display: block; width: 100%; height: auto; color: var(--d-trait); stroke: currentColor; stroke-width: var(--trait-normal); }
  .grille line { stroke-width: var(--trait-filet); opacity: 0.12; }
  /* Contour « relevé de podoscope » : points ronds (longueur nulle, bouts ronds) */
  .pointille { stroke-width: var(--pointille-point); stroke-dasharray: var(--pointille); opacity: var(--pointille-opacite); }
  .pointille--leger { stroke-width: var(--pointille-leger-point); opacity: var(--pointille-leger-opacite); }
  .trait { stroke-width: var(--trait-fort); }
  .axe { stroke: var(--d-accent); stroke-width: var(--trait-fin); stroke-dasharray: var(--tiret); }
  .mire, .loupe { stroke: var(--d-accent); }
  .loupe { stroke-width: var(--trait-normal); }
  .liaison { stroke: var(--d-accent); stroke-width: var(--trait-fin); opacity: 0.7; }
  .fond-loupe { fill: var(--d-fond); stroke: none; }
  .fin { stroke-width: var(--trait-fin); opacity: 0.6; }
  .cote { stroke-width: var(--trait-fin); opacity: 0.45; }
  .guide { stroke-width: var(--trait-filet); stroke-dasharray: var(--tiret-court); opacity: 0.45; }
  .niveau { fill: none; }
  .ongle { stroke: var(--d-accent); }
  .ongle-petit { stroke-width: var(--trait-normal); opacity: 0.55; }
  .sillon { stroke: var(--d-accent); stroke-width: var(--trait-fin); stroke-dasharray: var(--tiret-court); }
  .anneau { stroke: var(--d-accent); stroke-width: var(--trait-fin); stroke-dasharray: var(--tiret-court); opacity: 0.7; }
  .anneau-chaud { stroke: var(--d-chaud); stroke-width: var(--trait-fin); stroke-dasharray: var(--tiret-court); }
  .semelle { stroke: var(--d-accent); stroke-width: var(--trait-normal); }
  .crampons { stroke-width: var(--trait-marque); stroke-dasharray: var(--tiret); stroke-linecap: butt; opacity: 0.8; }
  .oeillet { stroke-width: var(--trait-fin); }
  .lacet { stroke: var(--d-accent); stroke-width: var(--trait-normal); }
  .sol { stroke-width: var(--trait-fin); }
  .hachures line { stroke-width: var(--trait-filet); opacity: 0.3; }
  .force, .force-fleche { stroke: var(--d-chaud); stroke-width: var(--trait-fort); }
  .force-courbe { stroke: var(--d-accent); stroke-width: var(--trait-normal); }
  .polygone { stroke: var(--d-accent); stroke-width: var(--trait-fin); stroke-dasharray: var(--tiret); }
  .oscillation { stroke: var(--d-chaud); stroke-width: var(--trait-normal); }
  .onde { stroke: var(--d-chaud); stroke-width: var(--trait-normal); stroke-dasharray: var(--tiret); }
  .point { stroke: none; }
  .trame path { fill: none; }
  .piste { fill: currentColor; opacity: 0.1; stroke: none; }
  .barre { stroke: none; }
  .curseur { fill: currentColor; stroke: none; }
  .legende rect { stroke: none; }
  .mono { font-family: var(--police-mono); font-size: var(--taille-donnees-dessin); fill: currentColor; stroke: none; opacity: 0.75; letter-spacing: 0.02em; }
  .mono--accent { fill: var(--d-accent); opacity: 1; }
  .mono--chaud { fill: var(--d-chaud); opacity: 1; }

  /* Apparition : les traits se dessinent, les points s'allument (si le parent est animé). */
  :global(.pret) .dessin .trace:not(.axe):not(.onde):not(.polygone) { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset var(--duree-trace) var(--courbe-trace); }
  :global(.pret.vu) .dessin .trace:not(.axe):not(.onde):not(.polygone) { stroke-dashoffset: 0; }
  :global(.pret) .dessin .point { opacity: 0; transform: scale(0.3); transform-box: fill-box; transform-origin: center; transition: opacity var(--duree-court), transform var(--duree-moyen) var(--courbe-rebond); transition-delay: calc(var(--duree-long) + var(--k, 0) * var(--duree-decalage)); }
  :global(.pret.vu) .dessin .point { opacity: 1; transform: none; }
  :global(.pret) .dessin .trame path { opacity: 0; transition: opacity var(--duree-moyen); transition-delay: calc(var(--duree-court) + var(--k, 0) * var(--duree-decalage)); }
  :global(.pret.vu) .dessin .trame path { opacity: 1; }
  :global(.pret) .dessin .barre { transform: scaleX(0); transform-box: fill-box; transition: transform var(--duree-long) var(--courbe-sortie) var(--duree-long); }
  :global(.pret.vu) .dessin .barre { transform: none; }
  .dessin--talon .onde { animation: onde var(--cycle-pouls) ease-out infinite; animation-delay: calc(var(--k) * var(--cycle-pouls) / 6); transform-box: fill-box; transform-origin: center; }
  .pulse { transform-box: fill-box; transform-origin: center; animation: pulse var(--cycle-pouls) ease-out infinite; }
  @keyframes onde { 0% { opacity: 0.9; } 100% { opacity: 0.15; } }
  @keyframes pulse { 0% { opacity: 0.9; transform: scale(0.6); } 100% { opacity: 0; transform: scale(1.7); } }
  @media (prefers-reduced-motion: reduce) { .dessin * { animation: none !important; transition: none !important; } }
</style>
