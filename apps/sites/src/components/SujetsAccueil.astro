---
// Sujets du cabinet sur l'accueil, juste après le premier écran (tous les gabarits) : les thèmes principaux du praticien en
// cartes, dans son ordre de préférence (picto, libellé, une ligne), puis une rangée plus discrète « Aussi au cabinet » avec
// les thèmes secondaires. Peu d'information d'un coup : ni liste de soins ni bouton ; chaque carte mène à la page du thème.
// Aucun intertitre ajouté (H2) : SEO identique d'un modèle à l'autre (npm run controle:seo). Rien n'est affiché sans thème.
// Variante `soins` : rangée « Par sujet » en tête de la page « Soins » (repli des thèmes n° 2 et 3 sur téléphone).
import Icone from './Icone.astro';
import { navigation, pictoTheme } from '../lib/navigation';
import { nouveauGabarit } from '../lib/gabarits';

interface Props { variante?: 'accueil' | 'soins' }
const { variante = 'accueil' } = Astro.props;
const { principaux, secondaires } = navigation;
const accueil = variante === 'accueil';
const bulles = accueil ? secondaires : [...principaux, ...secondaires];
---
{(principaux.length > 0 || secondaires.length > 0) && (
  <section class:list={['sujets', `sujets--${variante}`, nouveauGabarit ? (accueil ? 'g-section g-bloc' : '') : accueil ? 'section section--sujets' : '']} aria-label={accueil ? 'Sujets du cabinet' : 'Soins par sujet'}>
    <div class:list={[accueil ? (nouveauGabarit ? 'g-cadre g-bloc__dedans' : 'cadre') : '', 'sujets__dedans']}>
      {accueil && principaux.length > 0 && (
        <ul class="sujets__cartes">
          {principaux.map((t, i) => (
            <li>
              <a class="sujet" href={t.href}>
                <span class="sujet__picto" aria-hidden="true"><Icone nom={pictoTheme(t.theme.id)} secours="lucide:footprints" /></span>
                <span class="sujet__texte">
                  <span class="sujet__titre"><span class="sujet__rang" aria-hidden="true">{i + 1}</span>{t.theme.libelle}</span>
                  <span class="sujet__ligne">{t.theme.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {bulles.length > 0 && (
        <div class="sujets__aussi">
          <p class="sujets__etiquette">{accueil ? 'Aussi au cabinet' : 'Par sujet'}</p>
          <ul class="sujets__bulles">
            {bulles.map((t) => (
              <li><a class="sujets__bulle" href={t.href}><Icone nom={pictoTheme(t.theme.id)} secours="lucide:footprints" />{t.theme.libelle}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* Jetons du gabarit classique (--encre…) ou des gabarits tableau, village, revue (--g-*). */
  .sujets {
    --s-encre: var(--g-encre, var(--encre));
    --s-douce: var(--g-encre-douce, var(--encre-douce));
    --s-ligne: var(--g-ligne, var(--ligne));
    --s-accent: var(--g-accent-texte, var(--accent-vif));
    --s-carte: var(--g-carte, var(--blanc));
    --s-bulle: var(--g-bulle, var(--accent-tres-pale, var(--doux)));
    --s-bulle-texte: var(--g-bulle-texte, var(--encre));
    --s-picto: var(--g-bulle-picto, var(--accent-vif));
    --s-bord: var(--g-plein-bord, var(--accent-vif));
    --picto-accent: var(--s-accent);
  }
  .section--sujets { padding-block: clamp(28px, 4vw, 48px) 0; }
  .sujets__dedans { display: grid; gap: 20px; }
  .sujets--soins .sujets__dedans { margin-bottom: 8px; }
  .sujets__cartes { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 760px) { .sujets__cartes { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; } }
  .sujet { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 14px; align-items: center; height: 100%; min-height: 76px; padding: 14px 18px 14px 14px; border-radius: var(--rayon, 16px); background: var(--s-carte); box-shadow: inset 0 0 0 var(--filet, 1px) var(--s-ligne); color: var(--s-encre); text-decoration: none; transition: box-shadow var(--duree-court, 0.15s); }
  .sujet:hover { color: var(--s-encre); box-shadow: inset 0 0 0 var(--filet-fort, 2px) var(--s-bord); }
  .sujet:focus-visible { outline: 3px solid var(--s-accent); outline-offset: 2px; }
  .sujet__picto { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--s-bulle); color: var(--s-picto); }
  .sujet__picto :global(.icone) { width: 34px; height: 34px; }
  .sujet__texte { display: grid; gap: 2px; }
  .sujet__titre { display: flex; align-items: baseline; gap: 8px; font-family: var(--police-titres); font-weight: var(--graisse-titres, 600); font-size: 1.18rem; line-height: 1.2; color: var(--s-encre); }
  .sujet__rang { font-family: var(--police-texte); font-size: 0.8rem; font-weight: 700; color: var(--s-accent); }
  .sujet__ligne { font-size: 0.98rem; line-height: 1.4; color: var(--s-douce); }
  @media (min-width: 760px) {
    .sujet { grid-template-columns: minmax(0, 1fr); align-content: start; gap: 12px; padding: 20px; }
  }
  /* « Aussi au cabinet » : rangée discrète de petites bulles */
  .sujets__aussi { display: grid; gap: 8px; }
  .sujets__etiquette { margin: 0; font-size: 0.95rem; font-weight: 650; color: var(--s-douce); }
  .sujets__bulles { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sujets__bulle { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 4px 16px 4px 10px; border-radius: 999px; background: transparent; box-shadow: inset 0 0 0 var(--filet, 1px) var(--s-ligne); color: var(--s-encre); font-size: 0.98rem; font-weight: 600; line-height: 1.2; text-decoration: none; }
  .sujets__bulle:hover { color: var(--s-encre); box-shadow: inset 0 0 0 var(--filet-fort, 2px) var(--s-bord); }
  .sujets__bulle :global(.icone) { width: 24px; height: 24px; color: var(--s-accent); }
  /* Revue : filets, titres à empattements sans graisse */
  :global(.coquille--revue) .sujet { background: transparent; border-radius: 4px; }
  :global(.coquille--revue) .sujet__picto { background: none; }
  :global(.coquille--revue) .sujet__titre { font-weight: 500; }
  :global(.coquille--revue) .sujets__etiquette { font-style: italic; font-weight: 400; font-size: 1.05rem; }
  /* Village : encadrés teintés, gros caractères */
  :global(.coquille--village) .sujet { background: var(--g-doux); box-shadow: inset 0 0 0 var(--filet-fort, 2px) var(--s-ligne); border-radius: calc(var(--rayon-carte, 16px) * 0.6); }
  :global(.coquille--village) .sujet__titre { font-size: 1.25rem; }
</style>
