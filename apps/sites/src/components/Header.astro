---
import { site, nomPraticien, rdvHref, telLien } from '../lib/site';

const current = Astro.url.pathname;
const liens = [
  { href: '/soins', label: 'Soins' },
  { href: '/a-propos', label: 'Le cabinet' },
  ...(site.articles.length > 0 ? [{ href: '/actualites', label: 'Conseils' }] : []),
  { href: '/#infos', label: 'Infos pratiques' },
];
---
<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href="/" aria-label={`Accueil – ${site.cabinet.nom}`}>
      <span class="brand__mark" aria-hidden="true">{site.praticien.prenom[0]}{site.praticien.nom[0]}</span>
      <span class="brand__text">
        <strong>{nomPraticien}</strong>
        <span>{site.profession.libelle} · {site.cabinet.ville}</span>
      </span>
    </a>

    <details class="menu">
      <summary aria-label="Ouvrir le menu">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </summary>
      <nav aria-label="Navigation principale">
        <ul>
          {liens.map((l) => (
            <li><a href={l.href} aria-current={current.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <a class="tel" href={telLien}>{site.cabinet.telephone}</a>
        <a class="btn btn--primary" href={rdvHref('header')}>Prendre RDV</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .brand__mark {
    display: grid; place-items: center;
    width: 42px; height: 42px; border-radius: 50%;
    background: var(--brand-ink); color: #fff;
    font-family: var(--font-head); font-weight: 700; font-size: 0.95rem; letter-spacing: 0.02em;
  }
  .brand__text { display: flex; flex-direction: column; line-height: 1.2; }
  .brand__text strong { font-family: var(--font-head); font-size: 1.05rem; }
  .brand__text span { font-size: 0.85rem; color: var(--ink-mute); }

  .menu summary { list-style: none; cursor: pointer; padding: 10px; border-radius: 10px; color: var(--ink); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav {
    position: absolute; left: 0; right: 0; top: 72px;
    background: var(--bg); border-bottom: 1px solid var(--line);
    padding: 16px 20px 24px; display: grid; gap: 12px;
  }
  .menu ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .menu ul a { display: block; padding: 10px 0; text-decoration: none; color: var(--ink); font-weight: 600; }
  .menu ul a[aria-current='page'] { color: var(--brand-ink); }
  .tel { font-weight: 700; text-decoration: none; }

  @media (min-width: 900px) {
    .menu summary { display: none; }
    .menu nav { position: static; display: flex; align-items: center; gap: 28px; padding: 0; border: 0; background: none; }
    .menu ul { display: flex; gap: 24px; }
    .menu ul a { padding: 6px 0; font-size: 0.97rem; }
    .menu ul a:hover { color: var(--brand-ink); }
  }
</style>

<script>
  // Sur grand écran, le menu est toujours ouvert.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 900px)');
  const sync = () => menu && (menu.open = mq.matches);
  sync();
  mq.addEventListener('change', sync);
</script>
