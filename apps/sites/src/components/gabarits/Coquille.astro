---
// Coquille des gabarits autres que « classique » (tableau, village, revue… : packages/core/src/modeles.ts, GABARITS) : en-tête court,
// navigation en bulles, pied de page sobre, barre d'actions sur téléphone. Rendue par layouts/Gabarit.astro à la place de
// l'en-tête et du pied de page classiques ; le <head> (title, description, données structurées) reste celui du gabarit commun.
// Règles de clarté : une idée par écran, menu court, texte de 18 px (20 px en « village »), une couleur d'accent, beaucoup
// d'air, zones tactiles ≥ 44 px. Couleurs : uniquement les rôles --g-* (packages/core/src/gabarits.ts), tous dérivés de la
// couleur du cabinet avec garde-fous de contraste.
// Styles : les classes partagées par les sections (g-*) sont déclarées ici sous .coquille (sélecteurs portant l'attribut
// du composant) : sur un site « classique », la coquille est absente et ces règles sont retirées de la page au build
// (styles-alleges, astro.config.mjs).
// Revue : en-tête sur le papier, souligné d'un filet double ; sections en colonnes de journal (chiffre romain et titre à
// gauche, contenu à droite ; une colonne sur téléphone), compteur CSS (aucun texte ajouté au HTML : SEO identique) ;
// filets fins à la place des cartes ; pied de page sur le papier, filet double ; aucune animation.
import Logo from '../Logo.astro';
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { gabaritModele } from '@plateforme/core';
import { telLien, itineraire, lienRdv, titreCabinet, praticiens, lieu, rdvEnLigne, aTelephone, aAdresse, adresseLieu, lienContact, libelleContact, contactRdv } from '../../lib/textes';
import { navigation, entreeActive } from '../../lib/navigation';
import { variantes } from '../../lib/gabarits';

interface Props {
  courant: string;
  /** Lien de rendez-vous général (plusieurs praticiens : liste des praticiens) */
  rdvGeneral: string | null;
}
const { courant, rdvGeneral } = Astro.props;
const gabarit = gabaritModele(site.modele);
const village = gabarit === 'village';
const lienRendezVous = rdvGeneral ?? lienRdv('entete');
// Menu calculé par le core (lib/navigation.ts) : thèmes principaux du praticien, Soins, Le cabinet, Infos pratiques, puis
// Rendez-vous. Sur téléphone (< 760 px), seules les entrées du menu « téléphone » restent (3 au plus : thème n° 1, Soins,
// Infos pratiques) ; de 760 à 1199 px, les thèmes n° 2 et 3 sont repliés. Les entrées repliées sont en tête de la page
// « Soins » et au pied de page. Les actualités restent au pied de page.
const mobiles = new Set(navigation.menuMobile.map((l) => l.href));
const nav = navigation.menu.map((l, i) => ({ href: l.href, label: l.libelle, mobile: mobiles.has(l.href), repli: l.cle === 'theme' && i > 0 }));
const pied = navigation.pied.map((l) => ({ href: l.href, label: l.libelle }));
// Rubrique courante (aria-current="page") : sur ordinateur parmi le menu complet ; sur téléphone, parmi les entrées qui y
// restent (une fiche d'un soin du thème n° 2 active « Soins » sur téléphone, le thème n° 2 sur ordinateur).
const actifLarge = entreeActive(nav, courant);
const actifMobile = entreeActive(nav.filter((l) => l.mobile), courant);
const actifPied = entreeActive(pied, courant);
const actif = (href: string) => actifLarge === href || actifMobile === href;
const classeActif = (href: string) => ({ 'c-nav__actif-large': actifLarge === href && actifMobile !== href, 'c-nav__actif-mobile': actifMobile === href && actifLarge !== href });
const rdv = rdvEnLigne ? lienRendezVous : aTelephone ? telLien : lienContact;
const libelle = rdvEnLigne ? 'Rendez-vous' : aTelephone ? 'Appeler' : contactRdv === 'email' ? 'Écrire' : 'Rendez-vous';
// Nom de cabinet long : réduit (deux lignes au plus) plutôt que de couper le bouton « Rendez-vous » sur deux lignes
const nomLong = site.cabinet.nom.length > 34;
// Rendez-vous et contact (variante « contact », studio de recettes) : bandeau ou carte d'actions avant le pied de page, ou bouton
// flottant sur téléphone à la place de la barre. Liens seulement (aucun formulaire) ; aucun intertitre (SEO identique).
const contact = variantes.contact ?? 'barre';
const actionsContact = [
  ...(rdvEnLigne ? [{ href: lienRendezVous, libelle: 'Prendre rendez-vous', icone: 'picto:rendez-vous', secours: 'lucide:calendar', ext: false }] : []),
  ...(aTelephone ? [{ href: telLien, libelle: 'Appeler le cabinet', icone: 'picto:telephone', secours: 'lucide:phone', ext: false }] : []),
  ...(site.cabinet.email ? [{ href: `mailto:${site.cabinet.email}`, libelle: 'Écrire au cabinet', icone: 'lucide:mail', secours: 'lucide:mail', ext: false }] : []),
  ...(itineraire ? [{ href: itineraire, libelle: 'Itinéraire', icone: 'picto:itineraire', secours: 'lucide:map-pin', ext: true }] : []),
];
// Bouton flottant : l'action principale (rendez-vous en ligne, sinon appeler, sinon écrire)
const principale = actionsContact[0];
---
<div class:list={['coquille', `coquille--${gabarit}`, { 'coquille--nom-long': nomLong }]}>
  <header class="c-entete">
    <div class="g-cadre c-entete__ligne">
      <Logo />
      {village && aTelephone && <a class="c-entete__tel" href={telLien}><Icone nom="picto:telephone" secours="lucide:phone" /><span class="c-entete__tel-libelle">Appeler</span><span class="c-entete__numero">{site.cabinet.telephone}</span></a>}
      {!village && (
        <nav class="c-nav" aria-label="Navigation principale">
          <ul>
            {nav.map((l) => <li class:list={{ 'c-nav__large': !l.mobile, 'c-nav__repli': l.repli }}><a href={l.href} class:list={classeActif(l.href)} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
            <li class="c-nav__rdv"><a class="g-bouton g-bouton--plein" href={rdv}>{libelle}</a></li>
          </ul>
        </nav>
      )}
    </div>
    {village && (
      <div class="c-bande">
        <nav class="g-cadre c-nav" aria-label="Navigation principale">
          <ul>
            {nav.map((l) => <li class:list={{ 'c-nav__large': !l.mobile, 'c-nav__repli': l.repli }}><a href={l.href} class:list={classeActif(l.href)} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
            <li class="c-nav__rdv"><a href={rdv}>{libelle}</a></li>
          </ul>
        </nav>
      </div>
    )}
  </header>

  <main id="contenu" class="c-principal">
    <slot />
  </main>

  {(contact === 'bandeau' || contact === 'carte') && actionsContact.length > 0 && (
    <aside class:list={['c-contact', `c-contact--${contact}`]} aria-label="Contacter le cabinet">
      <div class="g-cadre c-contact__dedans">
        {contact === 'carte' && (
          <div class="c-contact__coord">
            <p class="c-contact__nom">{titreCabinet}</p>
            {aTelephone && <p class="c-contact__ligne"><a href={telLien}>{site.cabinet.telephone}</a></p>}
            {site.cabinet.email && <p class="c-contact__ligne"><a href={`mailto:${site.cabinet.email}`}>{site.cabinet.email}</a></p>}
          </div>
        )}
        <ul class="c-contact__actions">
          {actionsContact.map((a, i) => <li><a class:list={['c-contact__action', { 'c-contact__action--plein': i === 0 }]} href={a.href} {...(a.ext ? { target: '_blank', rel: 'noopener' } : {})}><Icone nom={a.icone} secours={a.secours} />{a.libelle}</a></li>)}
        </ul>
      </div>
    </aside>
  )}

  <footer class:list={['c-pied', `c-pied--${variantes.pied ?? 'simple'}`]}>
    <div class="g-cadre c-pied__grille">
      <div class="c-pied__bloc">
        <p class="c-pied__titre">{titreCabinet}</p>
        <p>{lieu.nom && <>{lieu.nom}<br /></>}{aAdresse ? <>{lieu.adresse}{lieu.complement && `, ${lieu.complement}`}<br />{`${lieu.codePostal} ${lieu.ville}`}</> : adresseLieu}</p>
        <p>{aTelephone && <a href={telLien}>{site.cabinet.telephone}</a>}{site.cabinet.email && <>{aTelephone && <br />}<a href={`mailto:${site.cabinet.email}`}>{site.cabinet.email}</a></>}</p>
      </div>
      {praticiens.length > 0 && <div class="c-pied__bloc">
        <p class="c-pied__titre">{praticiens.length > 1 ? 'Praticiens' : 'Praticien'}</p>
        <ul>
          {praticiens.map((p) => <li>{`${p.prenom} ${p.nom}`.trim()} — {p.titre}{p.identifiants[0] && <><br /><small>{p.identifiants[0]}</small></>}</li>)}
        </ul>
      </div>}
      <div class="c-pied__bloc">
        <p class="c-pied__titre">Pages</p>
        <ul class="c-pied__liens">
          {pied.map((l) => <li><a href={l.href} aria-current={actifPied === l.href ? 'page' : undefined}>{l.label}</a></li>)}
          <li><a href="/mentions-legales">Mentions légales</a></li>
          {site.pays === 'FR' && <li><a href="https://www.onpp.fr" rel="noopener" target="_blank">Ordre national des pédicures-podologues</a></li>}
        </ul>
      </div>
    </div>
    <p class="g-cadre c-pied__bas"><span>© {new Date().getFullYear()} {titreCabinet}</span><span>Illustrations : représentations schématiques, sans valeur de mesure</span></p>
  </footer>

  {contact === 'flottant' && principale ? (
    <nav class="c-flottant" aria-label="Accès rapide">
      <a href={principale.href} class="c-flottant__bouton" aria-label={principale.libelle}><Icone nom={principale.icone} secours={principale.secours} /></a>
    </nav>
  ) : (
  <nav class="c-barre" aria-label="Accès rapide">
    {aTelephone
      ? <a href={telLien} class:list={{ 'c-barre__plein': !rdvEnLigne }}><Icone nom="picto:telephone" secours="lucide:phone" />{rdvEnLigne ? 'Appeler' : 'Appeler le cabinet'}</a>
      : !rdvEnLigne && <a href={lienContact} class="c-barre__plein"><Icone nom="picto:rendez-vous" secours="lucide:calendar" />{libelleContact}</a>}
    {rdvEnLigne
      ? <a href={lienRendezVous} class="c-barre__plein"><Icone nom="picto:rendez-vous" secours="lucide:calendar" />Rendez-vous</a>
      : itineraire && <a href={itineraire} target="_blank" rel="noopener"><Icone nom="picto:itineraire" secours="lucide:map-pin" />Itinéraire</a>}
  </nav>
  )}
</div>

<style>
  /* ———— Socle : fond, texte, titres ———— */
  .coquille { --gouttiere: 32px; --largeur: 1180px; --rayon-carte: var(--rayon); --picto-accent: var(--g-accent-texte); background: var(--g-page); color: var(--g-encre); font-size: 1.125rem; line-height: 1.6; font-feature-settings: normal; min-height: 100vh; }
  .coquille--village { --gouttiere: 40px; --largeur: 880px; font-size: 1.12rem; }
  .coquille :global(.g-cadre) { width: min(var(--largeur), 100% - var(--gouttiere)); margin-inline: auto; }
  .coquille :global(.g-cadre--large) { width: min(1100px, 100% - var(--gouttiere)); margin-inline: auto; }
  /* Titres, paragraphes et liens de base : sélecteurs html[data-gabarit] body pour l'emporter sur les règles globales du gabarit
     classique (h1, a…), sans gêner les règles des composants (qui précisent les leurs) ; sans effet sur un site classique. */
  :global(html[data-gabarit] body :is(h1, h2, h3)) { font-family: var(--police-titres); font-weight: var(--graisse-titres); color: var(--g-encre); letter-spacing: -0.025em; line-height: 1.1; text-wrap: balance; margin: 0; }
  :global(html[data-gabarit] body h1) { font-size: clamp(2.3rem, 5.4vw, 3.9rem); letter-spacing: -0.035em; }
  :global(html[data-gabarit] body h2) { font-size: clamp(1.75rem, 3.4vw, 2.6rem); margin: 0; }
  :global(html[data-gabarit] body h3) { font-size: 1.2rem; letter-spacing: -0.01em; line-height: 1.25; }
  :global(html[data-gabarit='village'] body :is(h1, h2, h3)) { letter-spacing: -0.015em; line-height: 1.15; }
  :global(html[data-gabarit='village'] body h1) { font-size: clamp(2.1rem, 5.6vw, 3.3rem); }
  :global(html[data-gabarit='village'] body h2) { font-size: clamp(1.7rem, 3.6vw, 2.25rem); }
  :global(html[data-gabarit='village'] body h3) { font-size: 1.15rem; }
  .coquille :global(.pale) { color: inherit; font-style: normal; }
  :global(html[data-gabarit] p) { margin: 0; }
  :global(html[data-gabarit] a) { color: var(--g-accent-texte); text-underline-offset: 3px; }
  :global(html[data-gabarit] a:hover) { color: var(--g-encre); }
  .coquille :global(:focus-visible) { outline: 3px solid var(--g-plein-bord); outline-offset: 3px; border-radius: 6px; }
  .coquille :global(.g-section) { padding-block: clamp(44px, 6vw, 72px); }
  .coquille :global(.g-section + .g-section) { padding-top: 0; }
  /* Sections en blocs : tableau = une carte blanche arrondie par section, serrées ; village = sections pleine largeur séparées par un filet */
  .coquille--tableau :global(.g-section.g-bloc) { padding-block: 14px 0; }
  .coquille--tableau :global(.g-bloc__dedans) { padding: clamp(26px, 4.4vw, 52px); border-radius: var(--rayon-carte); background: var(--g-carte); box-shadow: inset 0 0 0 var(--filet) var(--g-ligne); }
  .coquille--village :global(.g-section.g-bloc) { padding-block: clamp(44px, 6vw, 64px); border-top: var(--filet) solid var(--g-ligne); }
  .coquille--village :global(.g-section.g-bloc + .g-section.g-bloc) { padding-top: clamp(44px, 6vw, 64px); }
  .coquille--village :global(.g-section:not(.g-bloc) + .g-section:not(.g-bloc)) { border-top: var(--filet) solid var(--g-ligne); padding-top: clamp(44px, 6vw, 64px); }
  .coquille :global(.g-tete) { display: grid; gap: 12px; margin-bottom: clamp(24px, 4vw, 36px); max-width: 46rem; }
  .coquille :global(.g-sur) { font-size: 1rem; font-weight: 600; color: var(--g-accent-texte); }
  .coquille :global(.g-chapo) { color: var(--g-encre-douce); max-width: 40em; }
  .coquille :global(.g-doux) { color: var(--g-encre-douce); }
  .coquille :global(.g-suite) { display: inline-flex; align-items: center; gap: 8px; min-height: var(--cible-tactile); margin-top: 20px; font-weight: 600; text-decoration: none; }
  .coquille :global(.g-suite::after) { content: '→'; transition: transform var(--duree-court) var(--courbe-sortie); }
  .coquille :global(.g-suite:hover::after) { transform: translateX(3px); }
  .coquille :global(.g-carte) { background: var(--g-carte); border-radius: var(--rayon-carte); box-shadow: inset 0 0 0 var(--filet) var(--g-ligne); padding: clamp(22px, 3vw, 32px); }
  .coquille--village :global(.g-carte) { background: var(--g-doux); box-shadow: none; }

  /* Plan d'accès et informations côte à côte (page « Plan d'accès ») */
  .coquille :global(.g-acces) { display: grid; gap: 18px; }
  @media (min-width: 960px) { .coquille :global(.g-acces) { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: start; } .coquille :global(.g-acces__plan) { position: sticky; top: 110px; } }

  /* Pages communes à tous les gabarits (article, mentions légales) : classes du gabarit classique, accordées à la coquille */
  .coquille :global(.tete-page__grille) { border-top: 0; padding-top: 8px; }
  .coquille :global(.sur) { font-family: var(--police-texte); font-size: 1rem; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--g-accent-texte); }
  .coquille :global(.sur::before), .coquille :global(.sur--index b) { display: none; }
  .coquille :global(.chapo) { color: var(--g-encre-douce); font-size: 1.08em; }
  .coquille :global(.prose) { max-width: 38em; }
  .coquille :global(.prose p + p) { margin-top: 0.9em; }
  .coquille :global(.prose h2) { font-size: clamp(1.4rem, 2.6vw, 1.75rem); margin: 1.6em 0 0.5em; }
  .coquille :global(.breadcrumb) { font-family: var(--police-texte); font-size: 0.92rem; letter-spacing: 0; color: var(--g-encre-douce); }
  .coquille :global(.breadcrumb a) { color: var(--g-encre-douce); display: inline-flex; align-items: center; min-height: var(--cible-tactile); }
  .coquille :global(.bouton--plein) { background: var(--g-plein); color: var(--g-plein-texte); }
  .coquille :global(.bouton--plein:hover) { background: var(--g-plein-survol); color: var(--g-plein-texte); }

  /* ———— Boutons ———— */
  .coquille :global(.g-bouton) { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 8px 24px; border-radius: var(--rayon-bouton); font: inherit; font-weight: 650; font-size: 1rem; line-height: 1.2; text-align: center; text-decoration: none; border: 0; cursor: pointer; transition: background var(--duree-court); }
  .coquille :global(.g-bouton--plein) { background: var(--g-plein); color: var(--g-plein-texte); box-shadow: inset 0 0 0 var(--filet-fort) var(--g-plein-bord); }
  .coquille :global(.g-bouton--plein:hover) { background: var(--g-plein-survol); color: var(--g-plein-texte); }
  .coquille :global(.g-bouton--ligne) { background: var(--g-carte); color: var(--g-encre); box-shadow: inset 0 0 0 var(--filet-fort) var(--g-ligne); }
  .coquille :global(.g-bouton--ligne:hover) { color: var(--g-encre); box-shadow: inset 0 0 0 var(--filet-fort) var(--g-plein-bord); }
  .coquille :global(.g-bouton .icone) { width: 1.3em; height: 1.3em; }
  .coquille :global(.g-via) { display: block; flex-basis: 100%; font-size: 0.8rem; font-weight: 500; opacity: 0.9; }

  /* ———— Bulles de navigation (soins, « pour qui », infos pratiques) ———— */
  .coquille :global(.g-bulles) { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .coquille :global(.g-bulle) { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 6px 18px 6px 8px; border-radius: 999px; background: var(--g-bulle); color: var(--g-bulle-texte); font-weight: 600; font-size: 1rem; line-height: 1.2; text-decoration: none; transition: box-shadow var(--duree-court), background var(--duree-court); }
  .coquille :global(.g-bulle:hover) { color: var(--g-bulle-texte); box-shadow: inset 0 0 0 var(--filet-fort) var(--g-plein-bord); }
  .coquille :global(.g-bulle--texte) { padding-left: 18px; }
  .coquille :global(.g-bulle__picto) { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--g-carte); color: var(--g-encre); flex: none; }
  .coquille :global(.g-bulle__picto .icone) { width: 24px; height: 24px; }

  /* ———— En-tête : nom du cabinet, menu calculé (thèmes principaux · Soins · Le cabinet · Infos pratiques · Rendez-vous) ———— */
  .c-entete { padding-block: 10px 0; }
  .c-entete__ligne { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; min-height: 64px; }
  .c-entete :global(.logo small) { font-family: var(--police-texte); text-transform: none; letter-spacing: 0; font-size: 0.85rem; color: var(--g-encre-douce); }
  .coquille :global(.logo), .coquille :global(.logo:hover) { color: var(--g-encre); }
  .c-nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 4px; }
  .c-nav a { display: inline-flex; align-items: center; min-height: var(--cible-tactile); padding: 0 14px; border-radius: 999px; color: var(--g-encre); font-weight: 600; font-size: 1rem; text-decoration: none; }
  .c-nav a:hover { color: var(--g-encre); background: var(--g-bulle); }
  /* Rubrique courante : graisse et trait de la couleur du cabinet sous le libellé (net, pas une simple nuance) */
  .c-nav a { position: relative; }
  .c-nav a[aria-current='page'] { color: var(--g-encre); font-weight: 750; background: none; }
  .c-nav a[aria-current='page']::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 6px; height: 3px; border-radius: 2px; background: var(--g-accent-texte); }
  @media (max-width: 759px) { .c-nav a.c-nav__actif-large[aria-current='page'] { font-weight: inherit; } .c-nav a.c-nav__actif-large[aria-current='page']::after { display: none; } }
  @media (min-width: 760px) { .c-nav a.c-nav__actif-mobile[aria-current='page'] { font-weight: inherit; } .c-nav a.c-nav__actif-mobile[aria-current='page']::after { display: none; } }
  .c-nav .c-nav__rdv a { margin-left: 8px; min-height: 48px; padding-inline: 20px; background: var(--g-vif); color: var(--g-vif-texte); box-shadow: none; white-space: nowrap; }
  /* Le nom cède la place au menu : il se réduit et passe sur deux lignes au plus */
  .c-entete__ligne :global(.logo) { min-width: 0; }
  .coquille--nom-long .c-entete__ligne :global(.logo strong) { font-size: min(var(--logo-nom), 1.05rem); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c-nav .c-nav__rdv a:hover { background: var(--g-vif); color: var(--g-vif-texte); text-decoration: underline; }
  /* Téléphone : le menu passe en une ligne sous le nom ; « Rendez-vous » est dans la barre du bas */
  /* Repli (règles de construireNavigation) : thèmes n° 2 et 3 sous 1200 px, menu « téléphone » seulement sous 760 px */
  @media (max-width: 1199px) { .c-nav .c-nav__repli { display: none; } }
  @media (max-width: 759px) { .c-nav .c-nav__large { display: none; } }
  @media (max-width: 759px) {
    .coquille--tableau .c-nav { flex-basis: 100%; }
    .coquille--tableau .c-nav ul { justify-content: space-between; }
