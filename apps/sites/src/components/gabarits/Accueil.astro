---
// Accueil des gabarits tableau et village (règles de clarté) : premier écran, puis les sections de la fiche du modèle dans
// son ordre — Soins (trois rangées de bulles), Venir au cabinet (horaires, adresse, volets repliés), Équipe (fiches courtes),
// Lieu (une ligne et quatre pastilles), Questions (accordéon), Actualités (deux liens). Chaque section est rendue par la
// variante choisie par la fiche. Mêmes intertitres (H2) et mêmes clés de textes modifiables que le gabarit classique :
// SEO identique (npm run controle:seo). Tableau : une carte blanche par section ; village : sections séparées par un filet.
import FaqListe from './Faq.astro';
import PremierEcran from './PremierEcran.astro';
import HerosPhoto from './HerosPhoto.astro';
import { varianteHeros, accueilGabarit } from '../../lib/heros-photo';
import Soins from './Soins.astro';
import Praticiens from './Praticiens.astro';
import VenirAuCabinet from './VenirAuCabinet.astro';
import Actus from './Actus.astro';
import SujetsAccueil from '../SujetsAccueil.astro';
import { soinsAccueilAllege } from '../../lib/navigation';
import { site } from '../../lib/site';
import { texte, champ } from '../../lib/edition';
import { titreCompetences, titrePraticiens, adresseLieu, lieu, aAdresse } from '../../lib/textes';
import { photoResponsive } from '../../lib/visuels';
import { variantes, titreLieu, pastillesLieu } from '../../lib/gabarits';
import type { Article } from '@plateforme/core';

interface Props { articles: Article[] }
const { articles } = Astro.props;
const m = site.modele;
const metier = site.titreMetier.toLowerCase();
// Recette du studio : « Venir au cabinet » juste sous le premier écran, avant les sujets (même contenu, mêmes H2).
const infosEnTete = Boolean(site.modele.accueil.infosEnTete) && site.modele.accueil.sections.includes('acces');
const blocsAccueil = [...(infosEnTete ? ['acces' as const] : []), 'sujets' as const, ...site.modele.accueil.sections.filter((s) => !(infosEnTete && s === 'acces'))];
---
{varianteHeros ? <HerosPhoto /> : <PremierEcran variante={accueilGabarit(variantes.accueil)} />}
{blocsAccueil.map((section) => (
  <>
    {section === 'sujets' && <SujetsAccueil />}
    {section === 'competences' && (
      <section class="g-section g-bloc" id="competences" aria-label={titreCompetences}>
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete">
            <h2>Une prise en charge <span class="pale" {...champ('competences.deco')}>{texte('competences.deco', 'du pied, à tout âge.')}</span></h2>
            <p class="g-chapo">Choisissez un soin ou votre situation.</p>
          </div>
          <Soins variante={variantes.soins} accueil />
          {soinsAccueilAllege && <a class="g-suite" href="/soins">Voir tous les soins</a>}
        </div>
      </section>
    )}

    {section === 'acces' && (
      <section class="g-section g-bloc" id="infos">
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete"><h2>Venir <span class="pale" {...champ('acces.deco')}>{texte('acces.deco', 'au cabinet.')}</span></h2></div>
          <VenirAuCabinet variante={variantes.infos} />
        </div>
      </section>
    )}

    {section === 'praticiens' && site.praticiens.length > 0 && (
      <section class="g-section g-bloc" id="praticiens" aria-label={titrePraticiens}>
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete">
            <h2>{site.praticiens.length > 1 ? <>Une équipe{' '}<span class="pale" {...champ('praticiens.deco')}>{texte('praticiens.deco', `de ${site.praticiens.length} praticiens.`)}</span></> : <>Votre {metier}{' '}<span class="pale" {...champ('praticiens.deco')}>{texte('praticiens.deco', `à ${site.cabinet.ville}.`)}</span></>}</h2>
          </div>
          <Praticiens variante={variantes.praticiens} />
        </div>
      </section>
    )}

    {section === 'panorama' && (
      <section class="g-section g-bloc">
        <div class="g-cadre g-bloc__dedans lieu">
          <h2 {...champ('panorama.titre')}>{texte('panorama.titre', titreLieu)}</h2>
          <p class="g-doux">{lieu.nom && aAdresse ? `${lieu.adresse}${lieu.complement ? `, ${lieu.complement}` : ''}, ${lieu.codePostal} ${lieu.ville}` : adresseLieu}.</p>
          {pastillesLieu.length > 0 && <ul class="lieu__pastilles">{pastillesLieu.map((p) => <li>{p}</li>)}</ul>}
        </div>
      </section>
    )}

    {section === 'galerie' && site.photos.cabinet.length > 0 && (
      <section class="g-section g-bloc">
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete"><h2>En images</h2></div>
          <ul class:list={['galerie', `galerie--${variantes.galerie}`]}>
            {site.photos.cabinet.slice(0, 4).map((src) => <li><img src={src} {...photoResponsive(src, '(min-width: 900px) 280px, 50vw')} alt="" width="800" height="600" loading="lazy" decoding="async" /></li>)}
          </ul>
        </div>
      </section>
    )}

    {section === 'faq' && (
      <section class="g-section g-bloc">
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete"><h2>Bon à savoir <span class="pale" {...champ('faq.deco')}>{texte('faq.deco', 'avant de venir.')}</span></h2></div>
          <FaqListe items={site.faqGenerale} cle="faq" />
        </div>
      </section>
    )}

    {section === 'actualites' && articles.length > 0 && (
      <section class="g-section g-bloc">
        <div class="g-cadre g-bloc__dedans">
          <div class="g-tete"><h2>Conseils <span class="pale" {...champ('actualites.deco')}>{texte('actualites.deco', 'et actualités.')}</span></h2></div>
          <Actus articles={articles.slice(0, 2)} variante={variantes.actualites} />
          <a class="g-suite" href="/actualites">Tous les conseils</a>
        </div>
      </section>
    )}
  </>
))}

<style>
  .lieu { display: grid; gap: 12px; }
  .lieu__pastilles { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lieu__pastilles li { padding: 8px 14px; border-radius: 999px; background: var(--g-duo-doux); color: var(--g-duo-texte); font-size: 0.95rem; font-weight: 600; }
  .galerie { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  /* Revue : lieu en colonnes de journal (chiffre romain, titre et adresse à gauche ; pastilles à filet à droite) */
  :global(.coquille--revue) .lieu__pastilles li { background: transparent; color: var(--g-encre); font-weight: 400; font-size: 1rem; box-shadow: inset 0 0 0 var(--filet) var(--g-ligne); }
  :global(.coquille--revue) .lieu > p { font-style: italic; }
  @media (min-width: 900px) {
    :global(.coquille--revue) .lieu { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: 64px; align-items: start; }
    :global(.coquille--revue) .lieu > :not(.lieu__pastilles) { grid-column: 1; }
    :global(.coquille--revue) .lieu__pastilles { grid-column: 2; grid-row: 1 / span 3; margin: 0; }
  }
  /* Galerie : défilement horizontal au doigt (scroll-snap, sans script) ; grande photo et vignettes */
  .galerie--defilement { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; padding-bottom: 8px; }
  .galerie--defilement li { flex: 0 0 min(80%, 360px); scroll-snap-align: start; }
  @media (min-width: 700px) { .galerie--grande { grid-template-columns: repeat(3, minmax(0, 1fr)); } .galerie--grande li:first-child { grid-column: 1 / -1; } .galerie--grande li:first-child img { aspect-ratio: 16 / 7; } }
  .galerie img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--rayon-carte); }
  /* Bande : quatre photos serrées en portrait (deux sur téléphone), bord à bord */
  .galerie--bande { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
  @media (min-width: 700px) { .galerie--bande { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .galerie--bande img { aspect-ratio: 3 / 4; border-radius: 0; }
</style>
