---
// Illustration décorative du hero, selon le style d'images choisi par le praticien.
// Remplacée par la photo du cabinet quand le praticien en fournit une.
import { site } from '../lib/site';

const style = site.theme.style_images;
const initiales = `${site.praticien.prenom[0]}${site.praticien.nom[0]}`;
---
<div class="decor" aria-hidden="true">
  {style === 'organique' && (
    <svg viewBox="0 0 480 480">
      <path fill="var(--brand-soft)" d="M402 285c-18 92-111 160-205 140S30 318 47 220 150 47 250 58s170 135 152 227Z" />
      <path fill="var(--brand-line)" opacity=".55" d="M360 140c40 50 32 140-30 180s-150 30-180-30-10-150 60-175 110-25 150 25Z" />
      <circle cx="372" cy="98" r="26" fill="var(--brand)" opacity=".85" />
      <circle cx="96" cy="388" r="14" fill="var(--brand)" opacity=".5" />
      <g fill="var(--brand-ink)" opacity=".9">
        <ellipse cx="214" cy="292" rx="44" ry="70" transform="rotate(-12 214 292)" />
        <circle cx="178" cy="196" r="13" /><circle cx="203" cy="185" r="11" /><circle cx="226" cy="183" r="10" />
        <circle cx="247" cy="188" r="9" /><circle cx="265" cy="198" r="8" />
      </g>
      <g fill="var(--brand)" opacity=".75">
        <ellipse cx="300" cy="250" rx="34" ry="54" transform="rotate(14 300 250)" />
        <circle cx="282" cy="176" r="10" /><circle cx="301" cy="171" r="8.5" /><circle cx="318" cy="174" r="7.5" />
        <circle cx="333" cy="182" r="7" /><circle cx="345" cy="193" r="6" />
      </g>
    </svg>
  )}
  {style === 'lignes' && (
    <svg viewBox="0 0 480 480" fill="none" stroke="var(--brand-ink)" stroke-width="2">
      <circle cx="240" cy="240" r="200" stroke="var(--brand-line)" />
      <circle cx="240" cy="240" r="150" stroke="var(--brand-line)" />
      <circle cx="240" cy="240" r="100" stroke="var(--brand)" />
      <path d="M120 330c40-60 80-90 120-90s80 30 120 90" />
      <path d="M150 360c30-40 60-60 90-60s60 20 90 60" stroke="var(--brand)" />
      <circle cx="240" cy="170" r="30" fill="var(--brand-soft)" />
    </svg>
  )}
  {style === 'minimal' && (
    <svg viewBox="0 0 480 480">
      <circle cx="240" cy="240" r="190" fill="var(--brand-soft)" />
      <text x="240" y="275" text-anchor="middle" font-size="110" font-family="var(--font-head)" font-weight="600" fill="var(--brand-ink)">{initiales}</text>
    </svg>
  )}
</div>

<style>
  .decor { width: 100%; max-width: 460px; margin-inline: auto; }
</style>
