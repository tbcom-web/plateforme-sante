---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="Fil d’Ariane">
  <ol>
    {items.map((it, i) =>
      i < items.length - 1 ? <li><a href={it.path}>{it.name}</a></li> : <li aria-current="page">{it.name}</li>,
    )}
  </ol>
</nav>
