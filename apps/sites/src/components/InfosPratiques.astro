---
import { site, adresseComplete, telLien, rdvHref } from '../lib/site';
import Icone from './Icone.astro';

const { cabinet } = site;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(adresseComplete)}`;
---
<section id="infos" class="section section--alt" aria-labelledby="infos-titre">
  <div class="wrap">
    <span class="eyebrow">Infos pratiques</span>
    <h2 id="infos-titre">Venir au cabinet</h2>
    <div class="grid grid--3 infos">
      <div class="card">
        <h3><Icone nom="lucide:map-pin" />Adresse et accès</h3>
        <p>{cabinet.adresse}<br />{cabinet.codePostal} {cabinet.ville}</p>
        <ul>
          {cabinet.acces.map((a) => <li>{a}</li>)}
          {cabinet.pmr && <li class="pmr"><Icone nom="healthicons:wheelchair-outline" />Cabinet accessible aux personnes à mobilité réduite</li>}
        </ul>
        <a href={mapsUrl} rel="noopener" target="_blank">Itinéraire</a>
      </div>
      <div class="card">
        <h3><Icone nom="lucide:clock" />Horaires</h3>
        <table>
          <tbody>
            {cabinet.horaires.map((h) => (
              <tr><th scope="row">{h.jour}</th><td>{h.heures}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {cabinet.tarifs.length > 0 && (
        <div class="card">
          <h3><Icone nom="lucide:receipt-euro" secours="lucide:euro" />Tarifs indicatifs</h3>
          <table>
            <tbody>
              {cabinet.tarifs.map((t) => (
                <tr><th scope="row">{t.acte}</th><td>{t.prix}</td></tr>
              ))}
            </tbody>
          </table>
          {site.praticien.conventionnement && <p class="note">{site.praticien.conventionnement}.</p>}
        </div>
      )}
    </div>
    <div class="cta">
      <a class="btn btn--primary" href={rdvHref('infos-pratiques')}>Prendre rendez-vous sur {site.rdv.plateforme}</a>
      <a class="btn btn--ghost" href={telLien}><Icone nom="lucide:phone" />Appeler le {cabinet.telephone}</a>
    </div>
  </div>
</section>

<style>
  .infos { margin-top: 8px; }
  .card h3 { margin-bottom: 0.8em; display: flex; align-items: center; gap: 0.5em; }
  .card h3 :global(.icone) { color: var(--brand-ink); }
  .pmr { list-style: none; margin-left: -1.1em; display: flex; gap: 0.4em; align-items: flex-start; }
  .pmr :global(.icone) { color: var(--brand-ink); font-size: 1.25em; }
  .btn :global(.icone) { margin-right: 0.45em; }
  ul { padding-left: 1.1em; margin: 0 0 1em; color: var(--ink-soft); font-size: 0.95rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th { text-align: left; font-weight: 600; padding: 6px 12px 6px 0; vertical-align: top; }
  td { color: var(--ink-soft); padding: 6px 0; text-align: right; }
  tr + tr { border-top: 1px solid var(--line); }
  .note { font-size: 0.875rem; color: var(--ink-mute); margin: 1em 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
</style>
