---
// Compétences en grille « bento » : même gabarit que la liste des compétences (Expertises) et les « autres
// compétences » d'une fiche — filet en tête, numéro en mono, visuel sur surface grille (dessin technique ; photo
// du soin seulement en style « Photos », source unique lib/visuels-soins.ts), titre et résumé. Pas de carte
// blanche : la première tuile est simplement plus grande. Classes forme-* : la « forme des cartes » de la recette s'y applique
// (formes.ts, <html data-forme>), comme aux cartes des sujets et des gabarits nouveaux.
import Dessin from '../dessins/Dessin.astro';
import { site } from '../../lib/site';
import { texte, champ } from '../../lib/edition';
import { visuelSoin } from '../../lib/visuels-soins';
import { modeVisuel, photoResponsive } from '../../lib/visuels';
import { rendreCase, type Soin } from '@plateforme/core';

// Soins montrés : tous ceux du site, ou ceux d'un groupe de la page « Compétences » (thème du praticien, lib/navigation.ts)
interface Props { soins?: Soin[] }
const { soins = site.soins } = Astro.props;
const n = soins.length;
/** Format de chaque tuile selon le nombre de soins, pour une grille toujours pleine sur 4 colonnes */
const format = (i: number): 'vedette' | 'moyen' | 'petit' | 'large' => {
  if (n === 1) return 'large';
  if (n === 2) return 'moyen';
  if (i === 0) return 'vedette';
  if (n === 3) return 'moyen';
  if (n === 4) return i === 1 ? 'moyen' : 'petit';
  if (i <= 4) return 'petit';
  const reste = n - 5;
  return reste % 2 === 1 && i === n - 1 ? 'large' : 'moyen';
};
const num = (i: number) => String(i + 1).padStart(2, '0');
// Listes : illustrations (homogènes) ; photos seulement si le praticien a choisi le style « Photos » (rendreCase, core).
const visuels = soins.map((s) => {
  const v = visuelSoin(s.slug);
  return { ...v, avecPhoto: rendreCase(v, modeVisuel, 'liste').type === 'photo' };
});
---
<ul class="bento forme-grille">
  {soins.map((s, i) => (
    <li class:list={['tuile', `tuile--${format(i)}`, 'apparait']} style={`--i:${i}`}>
      <a class="forme-carte" href={`/soins/${s.slug}`}>
        <span class="tuile__num mono" aria-hidden="true">{num(i)} / {String(n).padStart(2, '0')}</span>
        <span class:list={['tuile__visuel', 'forme-visuel', { 'surface-grille': !visuels[i].avecPhoto, 'tuile__visuel--photo': visuels[i].avecPhoto }]} aria-hidden="true">
          {visuels[i].avecPhoto && <img class="tuile__photo" src={visuels[i].photo} {...photoResponsive(visuels[i].photo, '(min-width: 1000px) 30vw, (min-width: 640px) 50vw, 100vw')} alt="" width="800" height="500" loading="lazy" decoding="async" style={`object-position:${visuels[i].cadrage}`} />}
          {!visuels[i].avecPhoto && <Dessin nom={visuels[i].dessin} />}
        </span>
        <span class="tuile__corps">
          <span class="tuile__titre forme-texte">{s.titreCourt}</span>
          <span class="tuile__texte forme-texte" {...champ(`soin.${s.slug}.resume`)}>{texte(`soin.${s.slug}.resume`, s.resume)}</span>
          <span class="tuile__lien">En savoir plus<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" /></svg></span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .bento { list-style: none; padding: 0; margin: 0; display: grid; gap: 36px 20px; grid-template-columns: minmax(0, 1fr); }
  .tuile.apparait.pret { transition-delay: calc(var(--i) * var(--duree-decalage)); }
  /* Une tuile : filet fort en tête (comme les listes), numéro mono, visuel sur grille, texte sans cadre */
  a { position: relative; display: grid; height: 100%; grid-template-rows: auto auto 1fr; gap: 12px; padding-top: 12px; border-top: var(--filet-fort) solid var(--encre); text-decoration: none; color: var(--encre); }
  a:hover { color: var(--encre); }
  .tuile__num { color: var(--encre-pale); }

  .tuile__visuel { position: relative; display: grid; place-items: center; padding: 18px 22px; aspect-ratio: 16 / 10; border-radius: var(--rayon); overflow: hidden; box-shadow: inset 0 0 0 var(--filet) var(--ligne); transition: box-shadow var(--duree-court); }
  a:hover .tuile__visuel { box-shadow: inset 0 0 0 var(--filet) var(--accent-ligne); }
  .tuile__visuel :global(.dessin) { width: min(100%, 360px); transition: transform var(--duree-moyen) var(--courbe-sortie); }
  .tuile:hover .tuile__visuel :global(.dessin) { transform: scale(1.035); }
  /* Photo du soin (style « Photos ») : pleine tuile, fond d'attente doux, traitement de teinte du modèle (Gabarit) */
  .tuile__visuel--photo { background: var(--doux); }
  .tuile__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--duree-long) var(--courbe-sortie); }
  .tuile:hover .tuile__photo { transform: scale(1.04); }

  .tuile__corps { display: grid; align-content: start; gap: 8px; }
  .tuile__titre { font-family: var(--police-titres); font-weight: var(--graisse-titres, 600); font-size: 1.32rem; line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
  .tuile__texte { color: var(--encre-douce); font-size: 0.95rem; line-height: 1.55; }
  .tuile__lien { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; font-weight: 600; font-size: 0.92rem; color: var(--accent-vif); }
  .tuile__lien svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; transition: transform var(--duree-court); }
  .tuile:hover .tuile__lien svg { transform: translateX(4px); }
  /* Filet de pression qui se trace au survol, comme la liste des compétences */
  a::after { content: ''; position: absolute; left: 0; right: 0; top: calc(var(--filet-fort) * -1); height: 2px; background: linear-gradient(90deg, var(--degrade-donnees)); transform: scaleX(0); transform-origin: left; transition: transform var(--duree-moyen) var(--courbe-sortie); }
  a:hover::after, a:focus-visible::after { transform: scaleX(1); }

  @media (min-width: 640px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tuile--vedette, .tuile--large { grid-column: span 2; }
  }
  @media (min-width: 1000px) {
    .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 44px 24px; }
    .tuile--vedette { grid-column: span 2; grid-row: span 2; }
    .tuile--vedette a { grid-template-rows: auto 1fr auto; }
    .tuile--vedette .tuile__visuel { aspect-ratio: auto; min-height: 320px; padding: 36px; }
    .tuile--vedette .tuile__visuel :global(.dessin) { width: min(100%, 470px); }
    .tuile--vedette .tuile__titre { font-size: clamp(1.8rem, 2.6vw, 2.5rem); line-height: 1; letter-spacing: -0.04em; }
    .tuile--vedette .tuile__texte { font-size: 1.02rem; max-width: 46ch; }
    .tuile--moyen, .tuile--large { grid-column: span 2; }
    .tuile--moyen a, .tuile--large a { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: 24px; }
    .tuile--moyen .tuile__num, .tuile--large .tuile__num { grid-column: 1 / -1; }
    .tuile--large { grid-column: span 4; }
    .tuile--large a { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .tuile--moyen .tuile__visuel, .tuile--large .tuile__visuel { aspect-ratio: auto; min-height: 200px; }
    .tuile--moyen .tuile__corps, .tuile--large .tuile__corps { align-content: center; }
    .tuile--large .tuile__titre { font-size: 1.7rem; }
    .tuile--petit .tuile__titre { font-size: 1.18rem; }
    .tuile--petit .tuile__texte { font-size: 0.9rem; }
  }
  /* Téléphone (≤ 759 px, TELEPHONE de la charte) */
  @media (max-width: 759px) {
    .bento { row-gap: var(--espace-bloc); }
    .tuile__texte { font-size: var(--taille-texte-telephone); line-height: 1.6; }

  }
</style>
