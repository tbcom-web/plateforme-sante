---
// Informations pratiques : seules les tuiles renseignées sont affichées (jamais de tuile vide).
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { lieu, telLien, itineraire, horairesRegroupes, libelleJours, rdvEnLigne, TYPES_LIEU } from '../../lib/textes';

const horaires = horairesRegroupes();
const ouvert = lieu.horaires.some((h) => /\d/.test(h.heures));
// Plages horaires en heures décimales, pour la frise graphique (aria-hidden : le texte reste la référence).
const plages = (heures: string) =>
  [...heures.matchAll(/(\d{1,2})\s*h\s*(\d{2})?\s*[–—-]\s*(\d{1,2})\s*h\s*(\d{2})?/g)].map((r) => [+r[1] + (+(r[2] ?? 0)) / 60, +r[3] + (+(r[4] ?? 0)) / 60]);
const toutes = horaires.flatMap((h) => plages(h.heures)).flat();
const debut = toutes.length ? Math.min(8, Math.floor(Math.min(...toutes))) : 8;
const fin = toutes.length ? Math.max(20, Math.ceil(Math.max(...toutes))) : 20;
const pos = (h: number) => `${(((h - debut) / (fin - debut)) * 100).toFixed(2)}%`;
const reperes = Array.from({ length: Math.floor((fin - debut) / 4) + 1 }, (_, k) => debut + k * 4).filter((h) => h <= fin);
const acces = [
  site.accesDetail.parking,
  site.accesDetail.pmr ? 'Accès facile pour les personnes à mobilité réduite' : '',
  site.accesDetail.transports,
  ...site.accesDetail.autres,
].filter(Boolean);
---
<div class="infos">
  {ouvert && (
    <div class="info info--horaires">
      <h3><Icone nom="lucide:clock" />Horaires</h3>
      <div class="frise__ligne frise__ligne--axe" aria-hidden="true"><span></span><span class="frise__axe mono">{reperes.map((h) => <span style={`left:${pos(h)}`}>{h}h</span>)}</span></div>
      <dl class="frise">
        {horaires.map((h) => (
          <div class="frise__ligne">
            <dt>{libelleJours(h.jours)}</dt>
            <dd>
              <span class="frise__piste" aria-hidden="true">
                {reperes.map((r) => <i class="frise__repere" style={`left:${pos(r)}`}></i>)}
                {plages(h.heures).map(([a, b]) => <b style={`left:${pos(a)};width:calc(${pos(b)} - ${pos(a)})`}></b>)}
              </span>
              <span class="frise__heures">{h.heures}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )}
  <div class="info">
    <h3><Icone nom="lucide:calendar" />Prise de rendez-vous</h3>
    {rdvEnLigne && <p>En ligne sur {site.rdv.plateforme}, 24h/24{site.praticiens.length > 1 ? ', pour chaque praticien' : ''}.</p>}
    {site.rdvMode !== 'en_ligne' && <p>Par téléphone au <a href={telLien}>{site.cabinet.telephone}</a>.</p>}
  </div>
  <div class="info">
    <h3><Icone nom="lucide:map-pin" />Adresse</h3>
    <p>
      {lieu.nom ? <>{lieu.nom}<br /></> : lieu.type !== 'cabinet' && <>{TYPES_LIEU[lieu.type]}<br /></>}
      {lieu.adresse}{lieu.complement && `, ${lieu.complement}`}<br />{lieu.codePostal} {lieu.ville}
    </p>
    <a href={itineraire} target="_blank" rel="noopener">Plan d’accès</a>
  </div>
  {acces.length > 0 && (
    <div class="info">
      <h3><Icone nom="healthicons:wheelchair-outline" />Accès</h3>
      <ul>{acces.map((a) => <li>{a}</li>)}</ul>
    </div>
  )}
  {site.domicile.actif && (
    <div class="info">
      <h3><Icone nom="healthicons:home-outline" />Visites à domicile</h3>
      {site.domicile.creneaux && <p>{site.domicile.creneaux}.</p>}
      {site.domicile.secteurs.length > 0 ? (
        <><p>Secteurs d’intervention :</p><ul>{site.domicile.secteurs.map((s) => <li>{s}</li>)}</ul></>
      ) : <p>Sur demande, contactez le cabinet.</p>}
    </div>
  )}
  {site.paiements.length > 0 && (
    <div class="info">
      <h3><Icone nom="lucide:wallet" secours="lucide:credit-card" />Moyens de règlement acceptés</h3>
      <ul class="pastilles">{site.paiements.map((m) => <li>{m}</li>)}</ul>
      {site.praticien.conventionnement && <p class="note">{site.praticien.conventionnement}.</p>}
    </div>
  )}
</div>
{site.communes.length > 0 && (
  <p class="communes">Le cabinet accueille les patients de {site.communes.join(', ')} et des communes alentour.</p>
)}

<style>
  .infos { display: grid; gap: 0 28px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); counter-reset: info; }
  .info { padding: 18px 0 22px; border-top: var(--filet-fort) solid var(--encre); }
  .info--horaires { grid-column: 1 / -1; }
  h3 { display: flex; align-items: center; gap: 10px; font-size: 1.02rem; margin-bottom: 12px; font-family: var(--police-texte); font-weight: 650; letter-spacing: -0.01em; }
  h3::after { counter-increment: info; content: counter(info, decimal-leading-zero); margin-left: auto; font-family: var(--police-mono); font-size: 0.7rem; font-weight: 450; color: var(--encre-pale); }
  h3 :global(.icone) { color: var(--accent-vif); font-size: 1.15rem; }
  p { margin: 0 0 8px; color: var(--encre-douce); font-size: 0.95rem; }
  ul { margin: 0; padding-left: 1.1em; color: var(--encre-douce); font-size: 0.95rem; }
  /* Frise des horaires : une piste par groupe de jours, plages d'ouverture en barres */
  .frise { display: grid; gap: 0; margin: 0; }
  .frise__ligne { display: grid; grid-template-columns: minmax(9em, 0.42fr) minmax(0, 1fr); align-items: center; column-gap: 18px; row-gap: 2px; padding: 9px 0; border-bottom: var(--filet) solid var(--ligne); font-size: 0.92rem; }
  .frise__ligne--axe { padding: 0 0 4px; border-bottom: 0; }
  .frise__axe { position: relative; height: 16px; color: var(--encre-pale); font-size: 0.64rem; }
  .frise__axe span { position: absolute; translate: -50% 0; }
  dt { grid-column: 1; grid-row: 1; font-weight: 600; }
  dd { display: contents; }
  .frise__heures { grid-column: 1; grid-row: 2; color: var(--encre-douce); font-family: var(--police-mono); font-size: 0.7rem; letter-spacing: 0.01em; }
  .frise__piste { grid-column: 2; grid-row: 1 / span 2; position: relative; height: 10px; border-radius: 2px; background: color-mix(in srgb, var(--encre) 6%, transparent); }
  .frise__piste b { position: absolute; top: 0; bottom: 0; border-radius: 2px; background: linear-gradient(90deg, var(--accent-vif), color-mix(in srgb, var(--accent-vif), var(--blanc) 25%)); }
  .frise__repere { position: absolute; top: -3px; bottom: -3px; width: 1px; background: var(--ligne); }
  .pastilles { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pastilles li { padding: 5px 12px; border-radius: 999px; box-shadow: inset 0 0 0 var(--filet) var(--ligne); font-size: 0.85rem; color: var(--encre); }
  .communes { margin-top: 20px; padding-top: 16px; border-top: var(--filet) solid var(--ligne); font-size: 0.9rem; }
</style>
