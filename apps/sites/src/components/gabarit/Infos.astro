---
// Informations pratiques : seules les tuiles renseignées sont affichées (jamais de tuile vide).
// `sansAdresse` : à côté du plan d'accès, qui donne déjà l'adresse (pas de doublon).
// `colonnes` : horaires dans la colonne de gauche, autres blocs empilés à droite (page « Le cabinet »).
// `niveau` : titres des tuiles en h2 quand la page n'a pas d'autre intertitre (plan d'accès : ordre des titres).
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { lieu, telLien, itineraire, rdvEnLigne, TYPES_LIEU } from '../../lib/textes';

interface Props { sansAdresse?: boolean; colonnes?: boolean; niveau?: 2 | 3 }
const { sansAdresse = false, colonnes = false, niveau = 3 } = Astro.props;
const Titre = niveau === 2 ? 'h2' : 'h3';

// Horaires jour par jour, en clair (jours fermés en retrait, jour courant mis en évidence par le script).
const horaires = lieu.horaires;
const ouvert = horaires.some((h) => /\d/.test(h.heures));
// Plages d'un jour (« 9h00–12h30, 14h00–19h00 » → deux lignes) ; vide = fermé.
const plagesDuJour = (heures: string) => (/\d/.test(heures) ? heures.split(/\s*,\s*/) : []);
const acces = [
  site.accesDetail.parking,
  site.accesDetail.pmr ? 'Accès facile pour les personnes à mobilité réduite' : '',
  site.accesDetail.transports,
  ...site.accesDetail.autres,
].filter(Boolean);
---
<div class:list={['infos', { 'infos--colonnes': colonnes }]}>
  {ouvert && (
    <div class="info info--horaires">
      <Titre class="info__titre"><Icone nom="picto:horaires" secours="lucide:clock" />Horaires</Titre>
      <table class="horaires">
        <tbody>
          {horaires.map((h, i) => (
            <tr class:list={{ ferme: plagesDuJour(h.heures).length === 0 }} data-jour={(i + 1) % 7}>
              <th scope="row">{h.jour}</th>
              <td>{plagesDuJour(h.heures).length ? plagesDuJour(h.heures).map((p) => <span>{p}</span>) : 'Fermé'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <script is:inline>document.querySelectorAll('.horaires tr[data-jour="' + new Date().getDay() + '"]').forEach((l) => { l.classList.add('aujourdhui'); var e = document.createElement('span'); e.className = 'horaires__jour'; e.textContent = 'aujourd’hui'; l.querySelector('th').appendChild(e); });</script>
    </div>
  )}
  <div class="info">
    <Titre class="info__titre"><Icone nom="picto:rendez-vous" secours="lucide:calendar" />Prise de rendez-vous</Titre>
    {rdvEnLigne && <p>En ligne sur {site.rdv.plateforme}, 24h/24{site.praticiens.length > 1 ? ', pour chaque praticien' : ''}.</p>}
    {(site.rdvMode !== 'en_ligne' || !rdvEnLigne) && <p>Par téléphone au <a href={telLien}>{site.cabinet.telephone}</a>.</p>}
  </div>
  {!sansAdresse && (
    <div class="info">
      <Titre class="info__titre"><Icone nom="picto:itineraire" secours="lucide:map-pin" />Adresse</Titre>
      <p>
        {lieu.nom ? <>{lieu.nom}<br /></> : lieu.type !== 'cabinet' && <>{TYPES_LIEU[lieu.type]}<br /></>}
        {lieu.adresse}{lieu.complement && `, ${lieu.complement}`}<br />{lieu.codePostal} {lieu.ville}
      </p>
      <a href={itineraire} target="_blank" rel="noopener">Itinéraire</a>
    </div>
  )}
  {acces.length > 0 && (
    <div class="info">
      <Titre class="info__titre"><Icone nom="picto:accessibilite" secours="healthicons:wheelchair-outline" />Accès</Titre>
      <ul>{acces.map((a) => <li>{a}</li>)}</ul>
    </div>
  )}
  {site.domicile.actif && (
    <div class="info">
      <Titre class="info__titre"><Icone nom="picto:soins-domicile" secours="healthicons:home-outline" />Visites à domicile</Titre>
      {site.domicile.creneaux && <p>{site.domicile.creneaux}.</p>}
      {site.domicile.secteurs.length > 0 ? (
        <><p>Secteurs d’intervention :</p><ul>{site.domicile.secteurs.map((s) => <li>{s}</li>)}</ul></>
      ) : <p>Sur demande, contactez le cabinet.</p>}
    </div>
  )}
  {site.paiements.length > 0 && (
    <div class="info">
      <Titre class="info__titre"><Icone nom="picto:honoraires" secours="lucide:wallet" />Moyens de règlement acceptés</Titre>
      <ul class="pastilles">{site.paiements.map((m) => <li>{m}</li>)}</ul>
      {site.praticien.conventionnement && <p class="note">{site.praticien.conventionnement}.</p>}
    </div>
  )}
</div>
{site.communes.length > 0 && (
  <p class="communes">Le cabinet accueille les patients de {site.communes.join(', ')} et des communes alentour.</p>
)}

<style>
  .infos { display: grid; gap: 0 28px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); counter-reset: info; }
  /* Deux colonnes : horaires à gauche sur toute la hauteur, autres blocs empilés à droite */
  @media (min-width: 760px) {
    .infos--colonnes { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 clamp(28px, 4vw, 56px); align-items: start; }
    .infos--colonnes > .info--horaires { grid-column: 1; grid-row: 1 / span 8; }
    .infos--colonnes > .info:not(.info--horaires) { grid-column: 2; }
  }
  .info { padding: 18px 0 22px; border-top: var(--filet-fort) solid var(--encre); }
  .info__titre { display: flex; align-items: center; gap: 10px; font-size: 1.02rem; line-height: 1.2; margin: 0 0 12px; font-family: var(--police-texte); font-weight: 650; letter-spacing: -0.01em; }
  .info__titre::after { counter-increment: info; content: counter(info, decimal-leading-zero); margin-left: auto; font-family: var(--police-mono); font-size: var(--taille-donnees-petit); font-weight: 450; color: var(--encre-pale); }
  .info__titre :global(.icone) { color: var(--accent-vif); font-size: 1.15rem; }
  p { margin: 0 0 8px; color: var(--encre-douce); font-size: 0.95rem; }
  ul { margin: 0; padding-left: 1.1em; color: var(--encre-douce); font-size: 0.95rem; }
  /* Horaires : tableau simple, une ligne par jour */
  .horaires { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .horaires th, .horaires td { padding: 7px 0; border-bottom: var(--filet) solid var(--ligne); text-align: left; vertical-align: top; }
  .horaires th { font-weight: 600; width: 40%; padding-right: 12px; }
  .horaires td { color: var(--encre-douce); font-variant-numeric: tabular-nums; }
  .horaires td span { display: block; white-space: nowrap; }
  .horaires .ferme th, .horaires .ferme td { color: var(--encre-pale); font-weight: 400; }
  /* Jour courant : fond doux et libellé « aujourd'hui » (pas de couleur d'accent, qui ressemblerait à un lien) */
  .horaires :global(.aujourdhui) :is(th, td) { background: var(--doux); color: var(--encre); }
  .horaires :global(.aujourdhui) th { padding-left: 10px; }
  .horaires :global(.horaires__jour) { display: block; font-family: var(--police-mono); font-size: var(--taille-donnees-petit); font-weight: 450; letter-spacing: var(--interlettrage-donnees); text-transform: uppercase; color: var(--encre-douce); }
  .pastilles { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pastilles li { padding: 5px 12px; border-radius: 999px; box-shadow: inset 0 0 0 var(--filet) var(--ligne); font-size: 0.85rem; color: var(--encre); }
  .communes { margin-top: 20px; padding-top: 16px; border-top: var(--filet) solid var(--ligne); font-size: 0.9rem; }
  /* Téléphone (≤ 759 px, TELEPHONE de la charte) */
  @media (max-width: 759px) {
    .info { padding: 22px 0 var(--espace-element); }
    .info__titre { margin-bottom: 16px; }
    p, ul, .horaires, .communes { font-size: var(--taille-texte-telephone); }
    ul:not(.pastilles) li + li { margin-top: 6px; }
    .horaires th, .horaires td { padding-block: var(--espace-ligne); }
    .horaires :global(.horaires__jour) { margin-top: 2px; }
    .pastilles { gap: 10px; }
    .pastilles li { padding: 8px 14px; }
    .communes { margin-top: var(--espace-element); }
    .info > a { display: inline-flex; align-items: center; min-height: var(--cible-tactile); }
  }
</style>
