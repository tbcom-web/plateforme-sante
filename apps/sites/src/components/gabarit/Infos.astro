---
// Informations pratiques : seules les tuiles renseignées sont affichées (jamais de tuile vide).
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { lieu, telLien, itineraire, rdvEnLigne, TYPES_LIEU } from '../../lib/textes';

// Horaires jour par jour, en clair (jours fermés en retrait, jour courant mis en évidence par le script).
const horaires = lieu.horaires;
const ouvert = horaires.some((h) => /\d/.test(h.heures));
// Plages d'un jour (« 9h00–12h30, 14h00–19h00 » → deux lignes) ; vide = fermé.
const plagesDuJour = (heures: string) => (/\d/.test(heures) ? heures.split(/\s*,\s*/) : []);
const acces = [
  site.accesDetail.parking,
  site.accesDetail.pmr ? 'Accès facile pour les personnes à mobilité réduite' : '',
  site.accesDetail.transports,
  ...site.accesDetail.autres,
].filter(Boolean);
---
<div class="infos">
  {ouvert && (
    <div class="info info--horaires">
      <h3><Icone nom="lucide:clock" />Horaires</h3>
      <table class="horaires">
        <tbody>
          {horaires.map((h, i) => (
            <tr class:list={{ ferme: plagesDuJour(h.heures).length === 0 }} data-jour={(i + 1) % 7}>
              <th scope="row">{h.jour}</th>
              <td>{plagesDuJour(h.heures).length ? plagesDuJour(h.heures).map((p) => <span>{p}</span>) : 'Fermé'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <script is:inline>document.querySelectorAll('.horaires tr[data-jour="' + new Date().getDay() + '"]').forEach((l) => l.classList.add('aujourdhui'));</script>
    </div>
  )}
  <div class="info">
    <h3><Icone nom="lucide:calendar" />Prise de rendez-vous</h3>
    {rdvEnLigne && <p>En ligne sur {site.rdv.plateforme}, 24h/24{site.praticiens.length > 1 ? ', pour chaque praticien' : ''}.</p>}
    {site.rdvMode !== 'en_ligne' && <p>Par téléphone au <a href={telLien}>{site.cabinet.telephone}</a>.</p>}
  </div>
  <div class="info">
    <h3><Icone nom="lucide:map-pin" />Adresse</h3>
    <p>
      {lieu.nom ? <>{lieu.nom}<br /></> : lieu.type !== 'cabinet' && <>{TYPES_LIEU[lieu.type]}<br /></>}
      {lieu.adresse}{lieu.complement && `, ${lieu.complement}`}<br />{lieu.codePostal} {lieu.ville}
    </p>
    <a href={itineraire} target="_blank" rel="noopener">Plan d’accès</a>
  </div>
  {acces.length > 0 && (
    <div class="info">
      <h3><Icone nom="healthicons:wheelchair-outline" />Accès</h3>
      <ul>{acces.map((a) => <li>{a}</li>)}</ul>
    </div>
  )}
  {site.domicile.actif && (
    <div class="info">
      <h3><Icone nom="healthicons:home-outline" />Visites à domicile</h3>
      {site.domicile.creneaux && <p>{site.domicile.creneaux}.</p>}
      {site.domicile.secteurs.length > 0 ? (
        <><p>Secteurs d’intervention :</p><ul>{site.domicile.secteurs.map((s) => <li>{s}</li>)}</ul></>
      ) : <p>Sur demande, contactez le cabinet.</p>}
    </div>
  )}
  {site.paiements.length > 0 && (
    <div class="info">
      <h3><Icone nom="lucide:wallet" secours="lucide:credit-card" />Moyens de règlement acceptés</h3>
      <ul class="pastilles">{site.paiements.map((m) => <li>{m}</li>)}</ul>
      {site.praticien.conventionnement && <p class="note">{site.praticien.conventionnement}.</p>}
    </div>
  )}
</div>
{site.communes.length > 0 && (
  <p class="communes">Le cabinet accueille les patients de {site.communes.join(', ')} et des communes alentour.</p>
)}

<style>
  .infos { display: grid; gap: 0 28px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); counter-reset: info; }
  .info { padding: 18px 0 22px; border-top: var(--filet-fort) solid var(--encre); }
  h3 { display: flex; align-items: center; gap: 10px; font-size: 1.02rem; margin-bottom: 12px; font-family: var(--police-texte); font-weight: 650; letter-spacing: -0.01em; }
  h3::after { counter-increment: info; content: counter(info, decimal-leading-zero); margin-left: auto; font-family: var(--police-mono); font-size: 0.7rem; font-weight: 450; color: var(--encre-pale); }
  h3 :global(.icone) { color: var(--accent-vif); font-size: 1.15rem; }
  p { margin: 0 0 8px; color: var(--encre-douce); font-size: 0.95rem; }
  ul { margin: 0; padding-left: 1.1em; color: var(--encre-douce); font-size: 0.95rem; }
  /* Horaires : tableau simple, une ligne par jour */
  .horaires { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .horaires th, .horaires td { padding: 7px 0; border-bottom: var(--filet) solid var(--ligne); text-align: left; vertical-align: top; }
  .horaires th { font-weight: 600; width: 40%; padding-right: 12px; }
  .horaires td { color: var(--encre-douce); font-variant-numeric: tabular-nums; }
  .horaires td span { display: block; white-space: nowrap; }
  .horaires .ferme th, .horaires .ferme td { color: var(--encre-pale); font-weight: 400; }
  .horaires .aujourdhui th, .horaires .aujourdhui td { color: var(--accent-vif); font-weight: 650; }
  .pastilles { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pastilles li { padding: 5px 12px; border-radius: 999px; box-shadow: inset 0 0 0 var(--filet) var(--ligne); font-size: 0.85rem; color: var(--encre); }
  .communes { margin-top: 20px; padding-top: 16px; border-top: var(--filet) solid var(--ligne); font-size: 0.9rem; }
</style>
