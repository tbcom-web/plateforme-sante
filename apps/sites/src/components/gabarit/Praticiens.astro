---
// Fiches praticiens, mise en page éditoriale. Sans portrait : un « relevé » sur fond plan d'architecte
// (empreintes en trame de points et monogramme), quel que soit le style visuel ; jamais un visage de banque
// d'images ni une photo de lieu qui pourrait passer pour le praticien.
// Mise en page : chaque fiche est un conteneur (container-type) ; sa grille intérieure (.praticien__carte)
// passe en deux colonnes quand la fiche dépasse 620 px (praticien seul, fiche pleine largeur).
import Empreintes from '../dessins/Empreintes.astro';
import type { Appui } from '../dessins/trame';
import { site } from '../../lib/site';
import { zonePhoto } from '../../lib/edition';
import { imagePortrait } from '../../lib/portraits';
import { lienRdv, rdvEnLigne, viaPlateforme, libelleContact } from '../../lib/textes';
import { presentationPortraits } from '../../lib/portraits';
import PortraitsPraticiens from '../PortraitsPraticiens.astro';

const STATUTS: Record<string, string> = { titulaire: 'Titulaire du cabinet', collaborateur: 'En collaboration', remplacant: 'En remplacement' };
// Profil d'appui illustratif selon l'orientation du praticien (pure variation graphique).
const appui = (orientations: string[]): Appui => {
  const t = orientations.join(' ').toLowerCase();
  if (/enfant/.test(t)) return 'enfant';
  if (/sport/.test(t)) return 'avant';
  if (/postur|équilibre|semelle/.test(t)) return 'reparti';
  return 'normal';
};
// Pastilles des orientations : niveaux de la palette de données de l'univers (charte).
const PASTILLES = [1, 2, 3, 4, 5].map((n) => `var(--donnee-${n})`);
const seul = site.praticiens.length === 1;
---
{/* Présentation des portraits choisie par la recette (autre que « sobre ») : HTML partagé du core, mêmes contenus */}
{presentationPortraits !== 'sobre' ? <PortraitsPraticiens classique /> : (
<div class:list={['praticiens', { 'praticiens--seul': seul }]}>
  {site.praticiens.map((p, i) => (
    <article class="praticien apparait">
     <div class="praticien__carte">
      <div class:list={['praticien__portrait', { 'surface-plan': !p.photo }]}>
        {p.photo
          ? <img class="praticien__photo" {...imagePortrait(p, 'portrait')} loading="lazy" decoding="async" {...zonePhoto(`praticien.${i}.photo`)} />
          : (
            <div class="praticien__releve" aria-hidden="true">
              <Empreintes appui={appui(p.orientations)} scan={false} legende={false} class="praticien__empreintes" />
              <span class="praticien__monogramme">{p.prenom.charAt(0)}{p.nom.charAt(0)}</span>
            </div>
          )}
      </div>
      <div class="praticien__texte">
        <p class="praticien__statut mono">{p.photo ? `${String(i + 1).padStart(2, '0')} — ` : ''}{STATUTS[p.statut]}</p>
        <h3>{`${p.prenom} ${p.nom}`.trim()}</h3>
        <p class="praticien__titre">{p.titre}{site.cabinet.ville && ` à ${site.cabinet.ville}`}</p>
        {p.orientations.length > 0 && (
          <ul class="praticien__orientations" aria-label="Orientations">
            {p.orientations.map((o, k) => <li><i style={`background:${PASTILLES[(k * 2 + i) % PASTILLES.length]}`} aria-hidden="true"></i>{o}</li>)}
          </ul>
        )}
        {p.bio && <p class="praticien__bio">{p.bio}</p>}
        <dl class="praticien__fiche">
          {p.diplome && <><dt class="mono">Diplôme</dt><dd>{p.diplome}</dd></>}
          {p.presence && <><dt class="mono">Au cabinet</dt><dd>{p.presence}</dd></>}
          {p.sports.length > 0 && <><dt class="mono">Sports suivis</dt><dd>{p.sports.join(', ')}</dd></>}
          {p.formations.length > 0 && <><dt class="mono">Formations</dt><dd><ul>{p.formations.map((f) => <li>{f}</li>)}</ul></dd></>}
          {p.identifiants.length > 0 && <><dt class="mono">Inscription</dt><dd class="praticien__id">{p.identifiants.map((id) => <span>{id}</span>)}</dd></>}
        </dl>
        <a class="bouton bouton--plein" href={lienRdv(`praticien-${i}`, rdvEnLigne && site.praticiens.length > 1 ? i : undefined)}>
          {rdvEnLigne ? (site.praticiens.length > 1 ? `Prendre rendez-vous avec ${p.prenom || p.nom}` : 'Prendre rendez-vous') : libelleContact}
          {viaPlateforme && <span class="via">{viaPlateforme}</span>}
        </a>
      </div>
     </div>
    </article>
  ))}
</div>
)}

<style>
  .praticiens { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .praticien { container-type: inline-size; min-width: 0; background: var(--fond); border-radius: var(--rayon-grand); padding: 14px; box-shadow: inset 0 0 0 var(--filet) var(--ligne), var(--ombre); }
  .praticien__carte { display: grid; grid-template-columns: minmax(0, 1fr); }
  .praticien__carte > * { min-width: 0; }
  .praticien__portrait { position: relative; aspect-ratio: 4 / 3; border-radius: calc(var(--rayon-grand) * 0.7); overflow: hidden; }
  .praticien__portrait:not(.surface-plan) { background-color: var(--doux); }
  .praticien__photo { width: 100%; height: 100%; object-fit: cover; }
  .praticien__releve { position: absolute; inset: 0; display: grid; }
  .praticien__repere { position: absolute; top: 14px; left: 16px; right: 16px; padding-bottom: 8px; border-bottom: var(--filet) solid var(--sur-sombre-filet); display: flex; justify-content: space-between; gap: 12px; color: var(--signal); text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--taille-donnees-petit); }
  .praticien__releve :global(.praticien__empreintes) { position: absolute; right: 6%; bottom: -14%; width: 52%; color: var(--sur-sombre-doux); }
  /* Monogramme plein, en papier sur le plan, posé sur un filet (pas de lettres détourées) */
  .praticien__monogramme { position: absolute; left: 16px; bottom: 16px; padding-top: 8px; border-top: var(--filet-fort) solid var(--signal); font-family: var(--police-titres); font-weight: var(--graisse-titres, 600); font-size: clamp(2.6rem, 12cqi, 4rem); line-height: 0.9; letter-spacing: -0.04em; color: var(--papier); }
  /* Colonne unique bornée : un nom ou un statut très long ne peut pas élargir la fiche (testeur, noms longs à 768-1024 px) */
  .praticien__texte { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; align-content: start; padding: 22px 12px 10px; }
  @container (min-width: 620px) {
    .praticien__carte { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 8px; }
    .praticien__portrait { aspect-ratio: auto; height: 100%; min-height: 320px; }
    .praticien__texte { padding: 22px 22px 18px; }
  }
  p { margin: 0; }
  .praticien__statut { min-width: 0; overflow-wrap: anywhere; color: var(--accent-vif); text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--taille-donnees-petit); margin-bottom: 4px; }
  h3 { font-family: var(--police-titres); font-size: clamp(1.6rem, 6cqi, 2.2rem); letter-spacing: -0.04em; line-height: 1; }
  /* Nom composé très long (« Delacroix-Montgolfier ») : jamais coupé (mot lié), réduit juste assez pour tenir dans la colonne */
  .praticien__texte h3 { container-type: inline-size; }
  h3 :global(mot-lie[style]) { font-size: min(1em, calc(100cqi / (var(--n) * 0.6))); }
  .praticien__titre { color: var(--encre-douce); }
  .praticien__orientations { list-style: none; padding: 0; margin: 10px 0 2px; display: flex; flex-wrap: wrap; gap: 6px; }
  .praticien__orientations li { display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; font-weight: 600; padding: 6px 12px 6px 10px; border-radius: 999px; box-shadow: inset 0 0 0 var(--filet) var(--ligne); color: var(--encre); }
  .praticien__orientations i { width: 8px; height: 8px; border-radius: 50%; }
  .praticien__bio { margin-top: 8px; color: var(--encre-douce); }
  .praticien__fiche { display: grid; grid-template-columns: minmax(0, 1fr); margin: 14px 0 0; border-top: var(--filet-fort) solid var(--encre); }
  .praticien__fiche dt { padding-top: 10px; color: var(--encre-pale); text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--taille-donnees-petit); }
  .praticien__fiche dd { margin: 2px 0 0; padding-bottom: 10px; border-bottom: var(--filet) solid var(--ligne); font-size: 0.9rem; color: var(--encre-douce); }
  .praticien__fiche ul { margin: 0; padding-left: 1.1em; }
  .praticien__id { display: grid; gap: 2px; font-size: 0.84rem !important; }
  @container (min-width: 480px) {
    .praticien__fiche { grid-template-columns: 9.5em minmax(0, 1fr); }
    .praticien__fiche dt { padding: 11px 12px 11px 0; border-bottom: var(--filet) solid var(--ligne); }
    .praticien__fiche dd { margin: 0; padding: 10px 0; }
  }
  .bouton { margin-top: 16px; justify-self: start; white-space: normal; text-align: center; }
  /* Téléphone (≤ 759 px, TELEPHONE de la charte) */
  @media (max-width: 759px) {
    .praticiens { gap: var(--espace-bloc); }
    .praticien__texte { gap: 8px; padding-top: 26px; }
    .praticien__orientations { gap: 8px; }
    .praticien__fiche dt { padding-top: 14px; }
    .praticien__fiche dd { margin-top: 4px; padding-bottom: 14px; font-size: var(--taille-texte-telephone); }
    .praticien__id { font-size: var(--taille-note) !important; }
    .bouton { margin-top: 22px; width: 100%; }
  }
</style>
