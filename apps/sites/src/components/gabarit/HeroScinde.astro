---
// Accueil « scindé » : titre à gauche, grande photo à droite avec badges. Selon le style visuel, la photo
// cède la place à l'animation de la spécialité ou à une planche technique sur fond plan (lib/visuels).
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { discipline } from '../../lib/pack';
import { texte, champ, zonePhoto } from '../../lib/edition';
import AnimationAccueil from '../animations/AnimationAccueil.astro';
import Planche from '../dessins/Planche.astro';
import { photoResponsive, photoAccueilAffichee, fondAnime, visuelAccueil, dessinSpecialite } from '../../lib/visuels';
import { packVisuel } from '@plateforme/core';
import { titreMetierAffiche, phraseAccueil, lieu, telLien, lienRdv, libelleRdv, TYPES_LIEU, rdvEnLigne, localisation, viaPlateforme, aLaVille, suffixeVille, aTelephone, contactRdv } from '../../lib/textes';

const ouverts = lieu.horaires.filter((h) => /\d/.test(h.heures)).map((h) => h.jour.toLowerCase());
const jours = ouverts.length > 1 ? `Du ${ouverts[0]} au ${ouverts.at(-1)}` : 'Sur rendez-vous';
const specialite = discipline;
const rdvAccueil = site.praticiens.length > 1 && rdvEnLigne ? '#praticiens' : lienRdv('accueil');
const choix = visuelAccueil([photoAccueilAffichee]);
// Texte alternatif seulement pour la photo du praticien (son cabinet) ; une photo d'illustration reste décorative.
const altAccueil = site.photos.accueil && photoAccueilAffichee === site.photos.accueil ? `Le cabinet de ${site.titreMetier.toLowerCase()}${suffixeVille}` : '';
---
<section class="cadre accueil">
  <div>
    <p class="sur">{[titreMetierAffiche, localisation].filter(Boolean).join(' · ')}</p>
    <h1>Cabinet de {specialite} {aLaVille && <span class="pale">{aLaVille}</span>}</h1>
    <p class="chapo" {...champ('accueil.chapo')}>{texte('accueil.chapo', phraseAccueil)}</p>
    <div class="actions appel-groupe">
      <a class="bouton bouton--plein" href={rdvAccueil}>
        {libelleRdv}{rdvAccueil !== '#praticiens' && viaPlateforme && <span class="via">{viaPlateforme}</span>}
        <svg class="fleche" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" /></svg>
      </a>
      {rdvEnLigne && aTelephone && <a class="bouton bouton--ligne" href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>}
    </div>
  </div>
  <figure class="visuel">
    {choix === 'animation' && <div class="visuel__anim" style={`background:${fondAnime}`} aria-hidden="true"><AnimationAccueil /></div>}
    {choix === 'photo' && <img src={photoAccueilAffichee} {...photoResponsive(photoAccueilAffichee, '(min-width: 960px) 46vw, calc(100vw - 40px)')} alt={altAccueil} width="1200" height="1500" fetchpriority="high" {...zonePhoto('photos.accueil')} />}
    {choix === 'illustration' && <div class="visuel__planche" {...zonePhoto('photos.accueil')}><Planche nom={dessinSpecialite} fond="plan" legende={packVisuel(site.visuels.specialite).label} /></div>}
    <figcaption class="flottant flottant--haut">
      <span class="pastille" aria-hidden="true"></span>
      {rdvEnLigne ? 'Réservation en ligne 24h/24' : aTelephone ? 'Rendez-vous par téléphone' : contactRdv === 'email' ? 'Rendez-vous par e-mail' : 'Rendez-vous au cabinet'}
    </figcaption>
    <div class="flottant flottant--bas">
      <Icone nom="lucide:map-pin" />
      <span><strong>{lieu.nom || TYPES_LIEU[lieu.type]}</strong><br />{jours}, sur rendez-vous</span>
    </div>
  </figure>
</section>

<style>
  .accueil { display: grid; gap: clamp(32px, 5vw, 64px); align-items: center; padding-block: clamp(40px, 6vw, 88px) clamp(32px, 5vw, 56px); }
  @media (min-width: 960px) { .accueil { grid-template-columns: 1.08fr 0.92fr; } }
  .chapo { margin: 26px 0 34px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .fleche { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; transition: transform var(--duree-court); }
  .bouton:hover .fleche { transform: translateX(3px); }
  .visuel { position: relative; margin: 0; }
  .visuel__anim { height: clamp(360px, 64vh, 640px); border-radius: var(--rayon-grand); overflow: hidden; }
  .visuel__anim :global(canvas), .visuel__anim :global(svg) { background: none !important; }
  /* La scène animée s'arrête au-dessus de la carte d'adresse (et sous le badge sur téléphone) : coureur et pieds jamais masqués.
     Réserve = marge de la carte + sa hauteur (deux lignes à 0,86 rem et marges intérieures, ≈ 62 px) + un filet d'air. */
  .visuel { --reserve-bas: calc(18px + 62px + 12px); --reserve-haut: calc(18px + 44px + 8px); }
  .visuel__anim { display: grid; padding-bottom: var(--reserve-bas); }
  @media (min-width: 960px) { .visuel { --reserve-bas: calc(44px + 62px + 12px); } }
  @media (max-width: 759px) { .visuel__anim { padding-top: var(--reserve-haut); } }
  /* Registre pédagogique (planche sans cartouches) : le dessin se centre entre le badge et la carte d'adresse */
  :global(html[data-registre='pedagogique']) .visuel__planche :global(.planche) { padding-block: var(--reserve-haut) var(--reserve-bas); }
  .visuel__planche { height: clamp(360px, 64vh, 640px); }
  .visuel__planche :global(.planche) { height: 100%; }
  .visuel img { width: 100%; height: clamp(360px, 64vh, 640px); object-fit: cover; border-radius: var(--rayon-grand); background: var(--doux); }
  .flottant { position: absolute; display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 16px; background: rgb(var(--blanc-rgb) / 0.86); backdrop-filter: blur(14px) saturate(1.5); box-shadow: var(--ombre); font-size: 0.86rem; line-height: 1.35; color: var(--encre); }
  .flottant--haut { top: 18px; right: 18px; }
  .flottant--bas { bottom: 18px; left: 18px; color: var(--encre-douce); }
  .flottant--bas :global(.icone) { color: var(--accent-vif); font-size: 1.3rem; }
  .flottant strong { color: var(--encre); }
  @media (min-width: 960px) { .flottant--bas { bottom: 44px; } }
  .pastille { width: 8px; height: 8px; border-radius: 50%; background: var(--disponible); box-shadow: 0 0 0 0 color-mix(in srgb, var(--disponible) 50%, transparent); animation: pouls var(--cycle-pouls) infinite; }
  @keyframes pouls { 70% { box-shadow: 0 0 0 9px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
</style>
