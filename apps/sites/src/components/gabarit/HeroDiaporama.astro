---
// Accueil immersif : diaporama plein écran (fondu enchaîné + zoom lent), titre posé sur l'image.
// Sans JavaScript ; animations coupées si le visiteur réduit les mouvements.
// Selon le style visuel : animation de la spécialité, diaporama, ou dessin technique sur fond plan (lib/visuels).
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { texte, champ, zonePhoto } from '../../lib/edition';
import AnimationAccueil from '../animations/AnimationAccueil.astro';
import Dessin from '../dessins/Dessin.astro';
import { diaporamaAffiche as diapos, fondAnime, visuelAccueil, dessinSpecialite } from '../../lib/visuels';
import { MENTION_ILLUSTRATIVE } from '@plateforme/core';
import { CYCLES } from '@plateforme/core';
import { titreMetierAffiche, phraseAccueil, telLien, lienRdv, libelleRdv, rdvEnLigne, lieu, TYPES_LIEU } from '../../lib/textes';

const choix = visuelAccueil(diapos);
// Animation ou illustration : titre à gauche, visuel à droite
const anime = choix !== 'photo';
const duree = CYCLES.diapo; // ms par photo (charte)
const specialite = site.pays === 'FR' ? 'pédicurie-podologie' : 'podologie';
const rdvAccueil = site.praticiens.length > 1 && rdvEnLigne ? '#praticiens' : lienRdv('accueil');
---
<section class:list={['hero', { 'hero--anime': anime }]} style={`--n:${diapos.length};--d:${duree}ms;${choix === 'animation' ? `background:${fondAnime}` : ''}`}>
  {choix === 'animation' && <div class="hero__anim" aria-hidden="true"><AnimationAccueil /></div>}
  {choix === 'illustration' && (
    <div class="hero__illus surface-plan" aria-hidden="true" {...zonePhoto('photos.accueil')}>
      <span class="hero__dessin"><Dessin nom={dessinSpecialite} /></span>
      <span class="hero__mention mono">{MENTION_ILLUSTRATIVE}</span>
    </div>
  )}
  {choix === 'photo' && (
    <div class="hero__diapos" aria-hidden="true" {...zonePhoto('photos.accueil')}>
      {diapos.map((src, i) => (
        <img src={src} alt="" style={`--i:${i}`} width="2000" height="1300" fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      ))}
    </div>
  )}
  <div class="cadre hero__contenu">
    <p class="sur hero__sur">{titreMetierAffiche} · {site.cabinet.quartier || site.cabinet.ville}</p>
    <h1>Cabinet de {specialite} <span class="pale">à {site.cabinet.ville}</span></h1>
    <p class="hero__chapo" {...champ('accueil.chapo')}>{texte('accueil.chapo', phraseAccueil)}</p>
    <div class="hero__actions">
      <a class="bouton bouton--clair" href={rdvAccueil}>
        {libelleRdv}
        <svg class="fleche" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" /></svg>
      </a>
      <a class="bouton bouton--verre" href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>
    </div>
    <p class="hero__lieu"><Icone nom="lucide:map-pin" />{lieu.nom || TYPES_LIEU[lieu.type]} · {lieu.adresse}, {lieu.ville}</p>
  </div>
  {!anime && diapos.length > 1 && <div class="hero__points" aria-hidden="true">{diapos.map((_, i) => <span style={`--i:${i}`}></span>)}</div>}
  <a class="hero__suite" href="#competences" aria-label="Découvrir le cabinet">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
  </a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; color: var(--blanc); overflow: hidden; isolation: isolate; background: var(--nuit-haut); }
  .hero__diapos { position: absolute; inset: 0; z-index: -2; }
  .hero__diapos img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; animation: diapo calc(var(--n) * var(--d)) infinite; animation-delay: calc(var(--i) * var(--d)); }
  /* Une seule photo (celle du praticien) : fixe */
  .hero__diapos img:only-child { animation: none; opacity: 1; }
  /* 4 photos : chacune visible un quart du cycle, avec un fondu d'entrée et de sortie. */
  @keyframes diapo {
    0% { opacity: 0; transform: scale(1.12); }
    5% { opacity: 1; }
    25% { opacity: 1; }
    31% { opacity: 0; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background:
      linear-gradient(180deg, rgb(var(--nuit-rgb) / var(--voile, 0.55)) 0%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.55) * 0.1)) 30%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.55) * 0.45)) 55%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.55) * 1.55)) 100%); }
  .hero__contenu { padding-block: 140px clamp(80px, 12vh, 140px); }
  /* Accueil animé : l'animation occupe la droite, le titre reste à gauche (en fond atténué sur mobile). */
  .hero--anime::after { background: linear-gradient(90deg, rgb(var(--nuit-rgb) / 0.7) 0%, rgb(var(--nuit-rgb) / 0) 60%); }
  .hero__anim { position: absolute; inset: 0; z-index: -2; opacity: 0.35; }
  .hero__anim :global(canvas), .hero__anim :global(svg) { background: none !important; }
  @media (min-width: 900px) { .hero__anim { left: 50%; opacity: 1; } }
  /* Illustration : fond plan d'architecte plein cadre, dessin de la spécialité à droite */
  .hero__illus { position: absolute; inset: 0; z-index: -2; }
  .hero__dessin { position: absolute; inset: 18% 6% 16% 6%; display: grid; place-items: center; opacity: 0.3; }
  .hero__dessin :global(.dessin) { width: 100%; height: 100%; }
  .hero__mention { position: absolute; right: clamp(20px, 4vw, 56px); bottom: 28px; font-size: var(--taille-donnees-petit); color: var(--sur-sombre-pale); letter-spacing: 0.02em; display: none; }
  @media (min-width: 900px) { .hero__dessin { left: 60%; right: 4%; opacity: 1; } .hero__mention { display: block; } }
  .hero__sur { color: var(--sur-sombre-doux); }
  h1 { color: var(--blanc); font-size: clamp(2.8rem, 7.4vw, 6.6rem); max-width: 14ch; line-height: 0.98; }
  h1 .pale { color: var(--sur-sombre-doux) !important; }
  .hero__chapo { max-width: 52ch; margin: 26px 0 36px; font-size: 1.15rem; color: var(--sur-sombre-doux); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .fleche { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; transition: transform var(--duree-court); }
  .bouton:hover .fleche { transform: translateX(3px); }
  .bouton--verre { color: var(--blanc); background: var(--sur-sombre-verre); box-shadow: inset 0 0 0 var(--filet) var(--sur-sombre-pale); backdrop-filter: blur(10px); }
  .bouton--verre:hover { color: var(--blanc); background: var(--sur-sombre-filet); }
  .hero__lieu { display: flex; align-items: center; gap: 8px; margin: 32px 0 0; font-size: 0.9rem; color: var(--sur-sombre-doux); }
  .hero__points { position: absolute; right: clamp(20px, 4vw, 56px); bottom: clamp(32px, 6vh, 56px); display: flex; gap: 8px; }
  .hero__points span { width: 28px; height: 3px; border-radius: 2px; background: var(--sur-sombre-filet); overflow: hidden; position: relative; }
  .hero__points span::after { content: ''; position: absolute; inset: 0; background: var(--blanc); transform: scaleX(0); transform-origin: left; animation: point calc(var(--n) * var(--d)) linear infinite; animation-delay: calc(var(--i) * var(--d)); }
  @keyframes point { 0% { transform: scaleX(0); } 25% { transform: scaleX(1); } 25.01%, 100% { transform: scaleX(0); } }
  .hero__suite { position: absolute; left: 50%; bottom: 22px; translate: -50% 0; width: 44px; height: 44px; display: none; place-items: center; border-radius: 50%; color: var(--blanc); box-shadow: inset 0 0 0 var(--filet) var(--sur-sombre-pale); animation: rebond var(--cycle-pouls) ease-in-out infinite; }
  @media (min-width: 900px) { .hero__suite { display: grid; } }
  .hero__suite svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; }
  @keyframes rebond { 50% { translate: -50% 6px; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__diapos img { animation: none; }
    .hero__diapos img:not(:first-child) { display: none; }
    .hero__points { display: none; }
  }
</style>
