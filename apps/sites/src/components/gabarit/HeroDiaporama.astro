---
// Accueil immersif : diaporama plein écran (fondu enchaîné + zoom lent), titre posé sur l'image.
// Sans JavaScript ; animations coupées si le visiteur réduit les mouvements.
// Image principale : celle du sujet n° 1 du praticien (lib/vitrine.ts) — photo en style « photos », sinon son animation
// validée (sport : coureur ; enfant : premiers pas ; semelles…) ou son dessin technique sur fond plan. Sur téléphone, l'image
// est un vrai bloc en haut du premier écran (pleine opacité), le titre dessous ; sur ordinateur, à droite du titre.
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { texte, champ, zonePhoto } from '../../lib/edition';
import VisuelTheme from '../accueil/VisuelTheme.astro';
import { fondAnime, registre } from '../../lib/visuels';
import { visuelPremierEcran } from '../../lib/vitrine';
import { titreMetierAffiche, phraseAccueil, telLien, lienRdv, libelleRdv, rdvEnLigne, lieu, TYPES_LIEU, localisation, viaPlateforme, aLaVille, suffixeVille, aTelephone, aAdresse, adresseLieu } from '../../lib/textes';

// Animation choisie par le praticien (proposition : celle du sujet n° 1, ou du n° 2 en nuance) ; sinon celle du sujet n° 1 ;
// sujet sans animation propre (diabète, ongles, seniors…) : l'animation de points de pression (podoscope), ADN du relevé.
const visuel = visuelPremierEcran.type === 'dessin' ? { ...visuelPremierEcran, animation: site.visuels.animationAccueil ?? visuelPremierEcran.animation ?? 'podoscope' as const } : visuelPremierEcran;
const choix: 'photo' | 'animation' | 'illustration' = visuel.type === 'photo' ? 'photo' : visuel.animation && registre === 'releve' && site.visuels.animation !== null ? 'animation' : 'illustration';
// Animation ou illustration : titre à gauche, visuel à droite
const anime = choix !== 'photo';
const specialite = site.pays === 'FR' ? 'pédicurie-podologie' : 'podologie';
const rdvAccueil = site.praticiens.length > 1 && rdvEnLigne ? '#praticiens' : lienRdv('accueil');
---
<section class:list={['hero', `hero--${choix}`, { 'hero--anime': anime }]} style={choix === 'animation' ? `background:${fondAnime}` : undefined}>
  {choix === 'photo' ? (
    <div class="hero__diapos" {...zonePhoto('photos.accueil')}><VisuelTheme visuel={visuel} prioritaire sizes="100vw" /></div>
  ) : (
    <div class:list={['hero__illus', { 'surface-plan': choix === 'illustration' }]} aria-hidden="true" {...zonePhoto('photos.accueil')}>
      <span class="hero__dessin"><VisuelTheme visuel={visuel} animer={choix === 'animation'} /></span>
    </div>
  )}
  <div class="cadre hero__contenu">
    <p class="sur hero__sur">{[titreMetierAffiche, localisation].filter(Boolean).join(' · ')}</p>
    <h1>Cabinet de {specialite} {aLaVille && <span class="pale">{aLaVille}</span>}</h1>
    <p class="hero__chapo" {...champ('accueil.chapo')}>{texte('accueil.chapo', phraseAccueil)}</p>
    <div class="hero__actions">
      <a class="bouton bouton--clair" href={rdvAccueil}>
        {libelleRdv}{rdvAccueil !== '#praticiens' && viaPlateforme && <span class="via">{viaPlateforme}</span>}
        <svg class="fleche" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" /></svg>
      </a>
      {aTelephone && <a class="bouton bouton--verre" href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>}
    </div>
    <p class="hero__lieu"><Icone nom="lucide:map-pin" />{lieu.nom || TYPES_LIEU[lieu.type]} · {aAdresse ? `${lieu.adresse}, ${lieu.ville}` : adresseLieu}</p>
  </div>
  <a class="hero__suite" href="#competences" aria-label="Découvrir le cabinet">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
  </a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; color: var(--blanc); overflow: hidden; isolation: isolate; background: var(--nuit-haut); }
  /* Photo du sujet n° 1 : plein cadre, sous un voile */
  .hero__diapos { position: absolute; inset: 0; z-index: -2; }
  .hero__diapos :global(.vt) { position: absolute; inset: 0; }
  .hero__diapos :global(.vt::after) { display: none; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background:
      linear-gradient(180deg, rgb(var(--nuit-rgb) / var(--voile, 0.55)) 0%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.55) * 0.1)) 30%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.55) * 0.45)) 55%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.55) * 1.55)) 100%); }
  .hero__contenu { padding-block: 140px clamp(80px, 12vh, 140px); }
  /* Animation ou dessin du sujet n° 1 : à droite du titre sur ordinateur ; sur téléphone, un vrai bloc en haut du premier
     écran (pleine opacité), le titre dessous. */
  .hero--anime::after { background: linear-gradient(90deg, rgb(var(--nuit-rgb) / 0.7) 0%, rgb(var(--nuit-rgb) / 0) 60%); }
  .hero__illus { position: absolute; inset: 0; z-index: -2; }
  .hero__illus :global(canvas), .hero__illus :global(svg) { background: none !important; }
  .hero__dessin { position: absolute; inset: 14% 4% 10% 52%; display: grid; place-items: stretch; }
  .hero--illustration .hero__dessin { inset: 18% 4% 16% 58%; }
  /* Ordinateur : bord gauche de l'animation fondu (gros plans comme le meulage : jamais de coupe franche près du titre) */
  @media (min-width: 900px) { .hero--animation .hero__dessin { -webkit-mask-image: linear-gradient(90deg, transparent 0, var(--blanc) 14%); mask-image: linear-gradient(90deg, transparent 0, var(--blanc) 14%); } }
  @media (max-width: 899px) {
    .hero--anime { min-height: auto; align-items: start; grid-template-rows: auto auto; }
    .hero--anime .hero__illus { position: relative; inset: auto; z-index: 0; height: min(52svh, 440px); margin-top: 74px; }
    .hero--anime .hero__dessin { inset: 0 4%; }
    .hero--illustration .hero__dessin { inset: 6% 10%; }
    .hero--anime::after { background: linear-gradient(180deg, rgb(var(--nuit-rgb) / 0) 40%, rgb(var(--nuit-rgb) / 0.35) 100%); }
    .hero--anime .hero__contenu { position: relative; padding-block: 8px 56px; }
  }
  .hero__sur { color: var(--sur-sombre-doux); }
  /* Titre ajusté : le plus long mot insécable (--mot-long, Gabarit.astro) tient sur une ligne, à gauche de l'image sur ordinateur */
  .hero__contenu { container-type: inline-size; }
  h1 { color: var(--blanc); font-size: min(6.6rem, calc(100cqi / (var(--mot-long, 14) * 0.55))) !important; max-width: none; line-height: 0.98; }
  /* Ordinateur : le titre reste dans la moitié gauche du cadre (50cqi), l'animation ou le dessin commence à 52 % de l'écran :
     jamais de chevauchement (retour du 2026-10-07 : la semelle animée recouvrait « à Lyon » en grand écran). */
  @media (min-width: 900px) { h1 { font-size: min(6.6rem, calc(50cqi / (var(--mot-long, 14) * 0.55))) !important; max-width: 50cqi !important; } }
  h1 .pale { color: var(--sur-sombre-doux) !important; }
  .hero__chapo { max-width: 52ch; margin: 26px 0 36px; font-size: 1.15rem; color: var(--sur-sombre-doux); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .fleche { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; transition: transform var(--duree-court); }
  .bouton:hover .fleche { transform: translateX(3px); }
  .bouton--verre { color: var(--blanc); background: var(--sur-sombre-verre); box-shadow: inset 0 0 0 var(--filet) var(--sur-sombre-pale); backdrop-filter: blur(10px); }
  .bouton--verre:hover { color: var(--blanc); background: var(--sur-sombre-filet); }
  .hero__lieu { display: flex; align-items: center; gap: 8px; margin: 32px 0 0; font-size: 0.9rem; color: var(--sur-sombre-doux); }
  .hero__suite { position: absolute; left: 50%; bottom: 22px; translate: -50% 0; width: 44px; height: 44px; display: none; place-items: center; border-radius: 50%; color: var(--blanc); box-shadow: inset 0 0 0 var(--filet) var(--sur-sombre-pale); animation: rebond var(--cycle-pouls) ease-in-out infinite; }
  @media (min-width: 900px) { .hero__suite { display: grid; } }
  .hero__suite svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; }
  @keyframes rebond { 50% { translate: -50% 6px; } }
  @media (prefers-reduced-motion: reduce) { .hero__suite { animation: none; } }
</style>
