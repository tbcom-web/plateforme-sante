---
// Plan d'accès : carte OpenStreetMap (sans cookie) + adresse + bouton itinéraire.
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { carteUrl } from '../../lib/visuels';
import { lieu, itineraire } from '../../lib/textes';
---
<div class="carte">
  {carteUrl ? (
    <iframe
      src={carteUrl}
      title={`Plan d’accès au cabinet de ${site.cabinet.ville}`}
      loading="lazy"
      referrerpolicy="no-referrer"
    ></iframe>
  ) : (
    <div class="carte__vide"><Icone nom="lucide:map-pin" /></div>
  )}
  <div class="carte__adresse">
    <p class="carte__titre">{lieu.nom || 'Le cabinet'}</p>
    <p>{lieu.adresse}{lieu.complement && <><br />{lieu.complement}</>}<br />{lieu.codePostal} {lieu.ville}</p>
    <a class="bouton bouton--plein bouton--petit" href={itineraire} target="_blank" rel="noopener"><Icone nom="lucide:navigation" secours="lucide:map-pin" />Itinéraire</a>
  </div>
</div>

<style>
  .carte { position: relative; border-radius: var(--rayon-grand); overflow: hidden; background: var(--doux); min-height: 380px; display: grid; grid-template-columns: minmax(0, 1fr); }
  iframe, .carte__vide { width: 100%; height: 100%; min-height: 380px; border: 0; grid-area: 1 / 1; filter: saturate(0.85); }
  .carte__vide { display: grid; place-items: center; font-size: 3rem; color: var(--accent-vif); }
  .carte__adresse { grid-area: 1 / 1; align-self: end; justify-self: start; margin: 16px; padding: 18px 20px; border-radius: 16px; background: rgb(255 255 255 / 0.92); backdrop-filter: blur(10px); box-shadow: var(--ombre); max-width: 300px; }
  .carte__adresse p { margin: 0 0 12px; font-size: 0.93rem; color: var(--encre-douce); }
  .carte__titre { font-weight: 650; color: var(--encre) !important; margin-bottom: 4px !important; }
</style>
