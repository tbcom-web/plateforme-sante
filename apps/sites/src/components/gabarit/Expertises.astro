---
// Liste éditoriale numérotée des compétences, chaque ligne illustrée selon le style visuel (VignetteSoin) :
// dessin technique, photo, ou dessin avec la photo du soin qui apparaît au survol (ordinateur, sauf en mode
// illustrations). Au survol, un filet aux couleurs de la pression se trace.
import VignetteSoin from './VignetteSoin.astro';
import { site } from '../../lib/site';
import { texte, champ } from '../../lib/edition';
import { modeVisuel, photoResponsive } from '../../lib/visuels';
import { visuelSoin } from '../../lib/visuels-soins';
import { rendreCase, type Soin } from '@plateforme/core';

// Soins montrés : tous ceux du site, ou ceux que les cartes des sujets ne portent pas déjà (accueil, lib/navigation.ts)
interface Props { soins?: Soin[] }
const { soins = site.soins } = Astro.props;

// Vignette photo (mobile) : seulement si la règle des listes donne une photo (style « Photos », rendreCase).
const vignette = (slug: string) => {
  const r = rendreCase(visuelSoin(slug), modeVisuel, 'liste');
  return r.type === 'photo' ? r : null;
};
---
<ol class="expertises forme-grille">
  {soins.map((s, i) => (
    <li class="apparait">
      <a href={`/soins/${s.slug}`} class="expertise forme-carte">
        <span class="expertise__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="expertise__dessin surface-grille forme-visuel" aria-hidden="true"><VignetteSoin slug={s.slug} /></span>
        {vignette(s.slug) && <img class="expertise__vignette" src={vignette(s.slug)!.src} {...photoResponsive(vignette(s.slug)!.src, '230px')} alt="" loading="lazy" width="320" height="240" style={`object-position:${vignette(s.slug)!.cadrage}`} />}
        <span class="expertise__titre forme-texte">{s.titreCourt}</span>
        <span class="expertise__resume forme-texte" {...champ(`soin.${s.slug}.resume`)}>{texte(`soin.${s.slug}.resume`, s.resume)}</span>
        <span class="expertise__fleche" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M6 14 14 6M7 6h7v7" /></svg></span>
      </a>
    </li>
  ))}
</ol>

<style>
  .expertises { list-style: none; margin: 0; padding: 0; border-top: var(--filet-fort) solid var(--encre); }
  li { position: relative; border-bottom: var(--filet) solid var(--ligne); }
  /* Filet de pression qui se trace au survol */
  li::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: linear-gradient(90deg, var(--degrade-donnees)); transform: scaleX(0); transform-origin: left; transition: transform var(--duree-moyen) var(--courbe-sortie); }
  li:hover::after { transform: scaleX(1); }
  .expertise { position: relative; display: grid; grid-template-columns: 92px 1fr 40px; grid-template-areas: 'dessin titre fleche' 'dessin resume fleche'; column-gap: 16px; align-items: center; padding: 20px 0; text-decoration: none; color: var(--encre); }
  .expertise__num { display: none; }
  .expertise__dessin { grid-area: dessin; position: relative; overflow: hidden; display: grid; place-items: center; width: 92px; aspect-ratio: 4 / 3; padding: 6px; border-radius: calc(var(--rayon) * 0.6); box-shadow: inset 0 0 0 var(--filet) var(--ligne); }
  .expertise__vignette { display: none; object-fit: cover; background: var(--doux); }
  .expertise__titre { grid-area: titre; font-family: var(--police-titres); font-size: clamp(1.2rem, 2.4vw, 2rem); font-weight: var(--graisse-titres, 560); letter-spacing: -0.035em; line-height: 1.05; transition: transform var(--duree-moyen) var(--courbe-sortie); }
  .expertise__resume { grid-area: resume; font-size: 0.93rem; color: var(--encre-douce); margin-top: 4px; transition: opacity var(--duree-court); }
  .expertise__fleche { grid-area: fleche; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: var(--filet) solid var(--ligne); color: var(--encre); transition: background var(--duree-court), border-color var(--duree-court), color var(--duree-court); }
  .expertise__fleche svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; }
  .expertise:hover .expertise__fleche { background: var(--accent); border-color: var(--accent); color: var(--blanc); }
  @media (max-width: 520px) {
    .expertise { grid-template-columns: 76px 1fr; grid-template-areas: 'dessin titre' 'dessin resume'; }
    .expertise__dessin { width: 76px; }
    .expertise__fleche { display: none; }
  }
  @media (min-width: 900px) {
    .expertise { grid-template-columns: 52px 148px 1fr 1.05fr 56px; grid-template-areas: 'num dessin titre resume fleche'; column-gap: 28px; padding: 26px 0; }
    .expertise__num { display: block; grid-area: num; color: var(--encre-pale); }
    .expertise__dessin { width: 148px; padding: 8px 10px; }
    .expertise__resume { margin: 0; max-width: 46ch; }
    .expertise__vignette { display: block; position: absolute; z-index: 2; right: 110px; top: 50%; width: 230px; height: 165px; object-fit: cover; border-radius: var(--rayon); opacity: 0; pointer-events: none; transform: translateY(-50%) scale(0.92) rotate(-2deg); transition: opacity var(--duree-court), transform var(--duree-moyen) var(--courbe-sortie); box-shadow: var(--ombre); }
    .expertise:hover .expertise__vignette { opacity: 1; transform: translateY(-50%) scale(1) rotate(-2deg); }
    .expertise:hover .expertise__titre { transform: translateX(8px); }
    .expertise:hover .expertise__resume { opacity: 0.2; }
  }
  /* Téléphone (≤ 759 px, TELEPHONE de la charte) */
  @media (max-width: 759px) {
    /* Dessin plus grand à côté du titre, résumé sur toute la largeur en dessous (16 px) */
    .expertise { grid-template-columns: 104px minmax(0, 1fr); grid-template-areas: 'dessin titre' 'resume resume'; row-gap: 14px; padding: var(--espace-element) 0; }
    .expertise__dessin { width: 104px; }
    .expertise__fleche { display: none; }
    .expertise__resume { margin-top: 0; font-size: var(--taille-texte-telephone); line-height: 1.6; }
  }
</style>
