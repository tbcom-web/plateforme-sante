---
// Accueil « plein » : une grande photo plein écran, titre centré, voile réglé par le modèle.
// Léger effet de profondeur au défilement (coupé si le visiteur réduit les mouvements).
// Selon le style visuel : animation de la spécialité, photo, ou dessin technique sur fond plan (lib/visuels).
import Icone from '../Icone.astro';
import { site } from '../../lib/site';
import { texte, champ, zonePhoto } from '../../lib/edition';
import AnimationAccueil from '../animations/AnimationAccueil.astro';
import Dessin from '../dessins/Dessin.astro';
import { photoResponsive, photoAccueilAffichee, fondAnime, visuelAccueil, dessinSpecialite } from '../../lib/visuels';
import { titreMetierAffiche, phraseAccueil, telLien, lienRdv, libelleRdv, rdvEnLigne, lieu, TYPES_LIEU, localisation, viaPlateforme, aLaVille, aTelephone, aAdresse, adresseLieu } from '../../lib/textes';

const specialite = site.pays === 'FR' ? 'pédicurie-podologie' : 'podologie';
const rdvAccueil = site.praticiens.length > 1 && rdvEnLigne ? '#praticiens' : lienRdv('accueil');
const choix = visuelAccueil([photoAccueilAffichee]);
// Animation ou illustration : titre à gauche, visuel à droite
const anime = choix !== 'photo';
---
<section class:list={['plein', { 'plein--anime': anime }]} style={choix === 'animation' ? `background:${fondAnime}` : undefined}>
  {choix === 'animation' && <div class="plein__anim" aria-hidden="true"><AnimationAccueil /></div>}
  {choix === 'photo' && <img class="plein__image" src={photoAccueilAffichee} {...photoResponsive(photoAccueilAffichee, '100vw')} alt={site.photos.accueil && photoAccueilAffichee === site.photos.accueil ? `Le cabinet de ${site.titreMetier.toLowerCase()} à ${site.cabinet.ville}` : ''} width="2000" height="1300" fetchpriority="high" decoding="async" {...zonePhoto('photos.accueil')} />}
  {choix === 'illustration' && (
    <div class="plein__illus surface-plan" aria-hidden="true" {...zonePhoto('photos.accueil')}>
      <span class="plein__dessin"><Dessin nom={dessinSpecialite} /></span>
    </div>
  )}
  <div class="cadre plein__contenu">
    <p class="sur plein__sur">{[titreMetierAffiche, localisation].filter(Boolean).join(' · ')}</p>
    <h1>Cabinet de {specialite} {aLaVille && <span class="pale">{aLaVille}</span>}</h1>
    <p class="plein__chapo" {...champ('accueil.chapo')}>{texte('accueil.chapo', phraseAccueil)}</p>
    <div class="plein__actions appel-groupe">
      <a class="bouton bouton--clair" href={rdvAccueil}>
        {libelleRdv}{rdvAccueil !== '#praticiens' && viaPlateforme && <span class="via">{viaPlateforme}</span>}
        <svg class="fleche" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" /></svg>
      </a>
      {aTelephone && <a class="bouton bouton--verre" href={telLien}><Icone nom="lucide:phone" />{site.cabinet.telephone}</a>}
    </div>
  </div>
  <p class="plein__lieu"><Icone nom="lucide:map-pin" />{lieu.nom || TYPES_LIEU[lieu.type]} · {aAdresse ? `${lieu.adresse}, ${lieu.ville}` : adresseLieu}</p>
</section>

<script>
  const image = document.querySelector<HTMLElement>('.plein__image');
  if (image && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const maj = () => { if (scrollY < innerHeight) image.style.transform = `translateY(${scrollY * 0.3}px) scale(1.06)`; };
    maj();
    addEventListener('scroll', maj, { passive: true });
  }
</script>

<style>
  .plein { position: relative; min-height: 100svh; display: grid; place-items: center; text-align: center; color: var(--blanc); overflow: hidden; isolation: isolate; background: var(--nuit-haut); }
  .plein__image { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); will-change: transform; }
  .plein::after { content: ''; position: absolute; inset: 0; z-index: -1; background:
      linear-gradient(180deg, rgb(var(--nuit-rgb) / calc(var(--voile, 0.4) * 0.9)) 0%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.4) * 0.6)) 50%, rgb(var(--nuit-rgb) / calc(var(--voile, 0.4) * 1.2)) 100%); }
  .plein__contenu { display: grid; justify-items: center; padding-block: 140px 120px; }
  /* Accueil animé : titre aligné à gauche, animation à droite (en fond atténué sur mobile). */
  .plein--anime { text-align: left; place-items: center stretch; }
  .plein--anime::after { background: linear-gradient(90deg, rgb(var(--nuit-rgb) / 0.6) 0%, rgb(var(--nuit-rgb) / 0) 60%); }
  .plein--anime .plein__contenu { justify-items: start; }
  .plein--anime .plein__actions { justify-content: flex-start; }
  .plein__anim { position: absolute; inset: 0; z-index: -2; opacity: 0.35; }
  .plein__anim :global(canvas), .plein__anim :global(svg) { background: none !important; }
  @media (min-width: 900px) { .plein__anim { left: 50%; opacity: 1; } }
  /* Illustration : fond plan d'architecte plein cadre, dessin de la spécialité à droite */
  .plein__illus { position: absolute; inset: 0; z-index: -2; }
  .plein__dessin { position: absolute; inset: 18% 6% 16% 6%; display: grid; place-items: center; opacity: 0.3; }
  .plein__dessin :global(.dessin) { width: 100%; height: 100%; }
  @media (min-width: 900px) { .plein__dessin { left: 60%; right: 4%; opacity: 1; } }
  /* Téléphone : l'animation ou le dessin en pleine opacité dans le haut du premier écran, le titre dessous (jamais d'image fantôme) */
  @media (max-width: 899px) {
    .plein--anime { place-items: end stretch; }
    .plein__anim { inset: 70px 0 auto; height: 44svh; opacity: 1; }
    .plein__dessin { inset: 90px 10% auto; height: 40svh; opacity: 1; }
    .plein--anime::after { background: linear-gradient(180deg, rgb(var(--nuit-rgb) / 0) 45%, rgb(var(--nuit-rgb) / 0.5) 100%); }
    .plein--anime .plein__contenu { padding-top: calc(70px + 46svh); padding-bottom: 72px; }
  }
  .plein__sur { color: var(--sur-sombre-doux); }
  .plein__sur::before { display: none; }
  h1 { color: var(--blanc); font-size: clamp(2.6rem, 6.6vw, 5.8rem); max-width: 16ch; line-height: 1; }
  h1 .pale { color: var(--sur-sombre-doux) !important; }
  .plein__chapo { max-width: 54ch; margin: 26px 0 36px; font-size: 1.15rem; color: var(--sur-sombre-doux); }
  .plein__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .fleche { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: var(--trait-normal); stroke-linecap: round; stroke-linejoin: round; transition: transform var(--duree-court); }
  .bouton:hover .fleche { transform: translateX(3px); }
  .bouton--verre { color: var(--blanc); background: var(--sur-sombre-verre); box-shadow: inset 0 0 0 var(--filet) var(--sur-sombre-pale); backdrop-filter: blur(10px); }
  .bouton--verre:hover { color: var(--blanc); background: var(--sur-sombre-filet); }
  .plein__lieu { position: absolute; left: 0; right: 0; bottom: 28px; display: flex; justify-content: center; align-items: center; gap: 8px; margin: 0; font-size: 0.88rem; color: var(--sur-sombre-doux); }
</style>
