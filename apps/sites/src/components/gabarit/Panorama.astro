---
// Bandeau photo pleine largeur (photo panoramique du cabinet, sinon photo d'illustration).
// En mode illustrations sans photo du praticien : relevé d'empreintes en trame de points sur fond plan,
// même hauteur et même texte.
import { site } from '../../lib/site';
import { texte, champ, zonePhoto } from '../../lib/edition';
import Empreintes from '../dessins/Empreintes.astro';
import { photoPanoramaAffichee, photoResponsive } from '../../lib/visuels';
import { MENTION_ILLUSTRATIVE, resumeHygiene } from '@plateforme/core';
import { lieu, TYPES_LIEU, rdvEnLigne } from '../../lib/textes';

const atouts = [
  // Hygiène : mention précise si le cabinet a coché son matériel de stérilisation (rubrique « Matériel et hygiène »).
  { titre: 'Hygiène', texte: resumeHygiene(site.equipements ?? []) || 'Instruments stérilisés après chaque patient' },
  site.accesDetail.pmr || site.accesDetail.parking
    ? { titre: 'Accès', texte: [site.accesDetail.pmr && 'Accessible PMR', site.accesDetail.parking].filter(Boolean).join(' · ') }
    : null,
  { titre: 'Rendez-vous', texte: !rdvEnLigne ? `Par téléphone au ${site.cabinet.telephone}` : `En ligne sur ${site.rdv.plateforme}, 24h/24` },
  site.domicile.actif ? { titre: 'Domicile', texte: site.domicile.creneaux || 'Visites à domicile sur demande' } : null,
].filter(Boolean) as { titre: string; texte: string }[];
const lieuNom = lieu.nom || TYPES_LIEU[lieu.type];
// Titre factuel (lieu d'exercice et ville), jamais de formule commerciale.
const titreStandard = `${lieuNom} à ${lieu.ville || site.cabinet.ville}`;
---
<section class:list={['panorama', { 'panorama--illus': !photoPanoramaAffichee }]}>
  {photoPanoramaAffichee
    ? <img src={photoPanoramaAffichee} {...photoResponsive(photoPanoramaAffichee, '100vw')} alt={[site.photos.panorama, ...site.photos.cabinet].includes(photoPanoramaAffichee) ? `${lieuNom} à ${lieu.ville || site.cabinet.ville}` : ''} loading="lazy" width="2000" height="1100" {...zonePhoto('photos.panorama')} />
    : (
      <div class="panorama__illus surface-plan" aria-hidden="true" {...zonePhoto('photos.panorama')}>
        <span class="panorama__releve anime-visible"><Empreintes appui="reparti" /></span>
        <span class="panorama__mention mono">{MENTION_ILLUSTRATIVE}</span>
      </div>
    )}
  <div class="cadre panorama__texte apparait">
    <p class="sur sur--clair sur--num">Le lieu d’exercice</p>
    <h2 {...champ('panorama.titre')}>{texte('panorama.titre', titreStandard)}</h2>
    <ul>
      {atouts.map((a) => <li><strong>{a.titre}</strong>{a.texte}</li>)}
    </ul>
  </div>
</section>

<style>
  .panorama { position: relative; min-height: clamp(520px, 78vh, 800px); display: grid; align-items: end; color: var(--blanc); overflow: hidden; isolation: isolate; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; background: var(--nuit-haut); }
  /* Zoom lié au défilement : seulement là où il est pris en charge (sinon image fixe, iOS < 26). */
  @supports (animation-timeline: view()) { img { animation: zoom linear both; animation-timeline: view(); animation-range: cover 0% cover 100%; } }
  .panorama::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(var(--nuit-rgb) / 0) 25%, rgb(var(--nuit-rgb) / 0.82)); }
  /* Illustration : plan d'architecte plein cadre, relevé d'empreintes à droite */
  .panorama__illus { position: absolute; inset: 0; z-index: -2; }
  .panorama__releve { position: absolute; top: 8%; bottom: 8%; right: 4%; width: min(60%, 520px); display: grid; place-items: center; opacity: 0.35; color: var(--sur-sombre-doux); }
  .panorama__releve :global(.empreintes) { width: 100%; height: 100%; }
  .panorama__mention { position: absolute; right: clamp(20px, 4vw, 56px); top: 24px; font-size: var(--taille-donnees-petit); color: var(--sur-sombre-pale); letter-spacing: 0.02em; }
  @media (min-width: 900px) { .panorama__releve { opacity: 1; width: min(42%, 520px); right: 6%; } }
  .panorama--illus::after { background: linear-gradient(90deg, rgb(var(--nuit-rgb) / 0.55) 0%, rgb(var(--nuit-rgb) / 0) 65%); }
  .panorama__texte { padding-block: clamp(48px, 8vw, 104px); }
  h2 { color: var(--blanc); max-width: 16ch; }
  .sur--clair { color: var(--sur-sombre-doux); }
  ul { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 0; }
  @media (min-width: 760px) { ul { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); } }
  li { display: grid; gap: 4px; padding: 18px 20px 0 0; border-top: var(--filet) solid var(--sur-sombre-filet); font-size: 0.93rem; color: var(--sur-sombre-doux); }
  strong { color: var(--blanc); font-weight: 600; }
  @keyframes zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
</style>
