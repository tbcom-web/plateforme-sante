---
// Visuel d'en-tête des pages internes (fiche d'un soin, liste des compétences), selon le style visuel :
// - photos : grande photo 16:9, dimensions fixes, traitement de teinte du modèle (Gabarit) ;
// - illustrations : planche du dessin, ou animation du soin quand elle existe, sur fond plan ;
// - mixte : photo 16:9 et planche technique en encart, posée sur l'angle de la photo.
// Le choix suit rendreCase (packages/core/src/jeux.ts), la même règle que l'aperçu de l'admin.
// Décoratif : aria-hidden. AUCUN texte incrusté (ni cartouche, ni légende, ni mention : règle de Paul du 2026-10-06) ;
// legende et repere restent acceptés (rétrocompatibilité des appels) mais ne sont plus affichés.
import Dessin from '../dessins/Dessin.astro';
import Animation from '../animations/Animation.astro';
import { rendreCase, type Animation as NomAnimation, type NomDessin } from '@plateforme/core';
import { modeVisuel, photoResponsive, pedagogique } from '../../lib/visuels';

interface Props {
  photo: string;
  /** Cadrage de la photo (object-position) */
  cadrage?: string;
  dessin: NomDessin;
  animation?: NomAnimation | null;
  /** Légende en mono (nom du soin…) et repère (« Fig. 05 ») */
  legende?: string;
  repere?: string;
  /** Photo assez forte pour un en-tête ; sinon, en mode mélange, l'illustration la remplace */
  photoBonne?: boolean;
  /** Page de liste (compétences) : en mode mélange, illustration plutôt que photo */
  liste?: boolean;
  /** Photo fournie par le praticien pour ce soin : affichée quel que soit le style visuel */
  photoPraticien?: string;
  /** Texte alternatif de la photo du praticien (porteuse d'information) ; une photo d'illustration reste décorative */
  altPraticien?: string;
}
const { photo, cadrage = '50% 50%', dessin, animation = null, photoBonne = true, liste = false, photoPraticien, altPraticien = '' } = Astro.props;
// Règle : illustrations dans les listes ; photo sur la fiche d'un soin si elle est bonne (mode mélange).
const choix = rendreCase({ photo, cadrage, dessin, animation, photoBonne }, modeVisuel, liste ? 'liste' : 'page', { photoPraticien, animationActive: true });
const image = choix.type === 'photo' ? choix : { src: photo, cadrage };
// Photo : seule (style photos, ou photo du praticien en style illustrations) ou avec la planche en encart (mélange).
const rendu = choix.type === 'photo' ? (modeVisuel === 'mixte' ? 'mixte' : 'photos') : 'illustrations';
// Registre pédagogique : le dessin du soin (schéma explicatif) plutôt que l'image calme de l'animation.
const anime = choix.type === 'animation' && !pedagogique ? choix.animation : null;
const alt = photoPraticien && image.src === photoPraticien ? altPraticien : '';
---
{rendu === 'photos' && (
  <figure class="ve ve--photo" aria-hidden={alt ? undefined : 'true'}>
    <img src={image.src} {...photoResponsive(image.src, '(min-width: 960px) 52vw, calc(100vw - 40px)')} alt={alt} width="1600" height="900" fetchpriority="high" decoding="async" style={`object-position:${image.cadrage}`} />
  </figure>
)}

{rendu === 'illustrations' && (
  <figure class:list={['ve', 've--plan', 'surface-plan', { 've--anime': anime }]} aria-hidden="true">
    <span class="ve__scene">{anime ? <Animation nom={anime} fond="sombre" /> : <Dessin nom={dessin} />}</span>
  </figure>
)}

{rendu === 'mixte' && (
  <figure class="ve ve--mixte">
    <span class="ve__cadre">
      <img src={image.src} {...photoResponsive(image.src, '(min-width: 960px) 52vw, calc(100vw - 40px)')} alt={alt} width="1600" height="900" fetchpriority="high" decoding="async" style={`object-position:${image.cadrage}`} />
    </span>
    <span class="ve__encart surface-grille" aria-hidden="true">
      <Dessin nom={dessin} />
    </span>
  </figure>
)}

<style>
  .ve { position: relative; width: 100%; margin: 0; }
  .ve img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* Photo seule : 16:9, coins de la gamme */
  .ve--photo { aspect-ratio: 16 / 9; border-radius: var(--rayon-grand); overflow: hidden; background: var(--doux); }

  /* Illustrations : cartouche sur fond plan d'architecte, scène 16:9 */
  .ve--plan { display: grid; grid-template-rows: auto; padding: 14px 16px; border-radius: var(--rayon-grand); overflow: hidden; box-shadow: var(--ombre); }
  .ve__scene { display: grid; place-items: center; aspect-ratio: 16 / 9; min-height: 0; padding: clamp(10px, 2vw, 22px); color: var(--sur-sombre-doux); }
  .ve__scene :global(.dessin) { height: 100%; width: auto; max-width: 100%; }
  .ve--anime .ve__scene { padding: 0; }
  .ve--anime .ve__scene :global(canvas), .ve--anime .ve__scene :global(svg) { width: 100%; height: 100%; background: none !important; }

  /* Mixte : photo 16:9 et planche en encart sur l'angle bas droit */
  .ve--mixte { display: grid; gap: 10px; }
  .ve__cadre { display: block; aspect-ratio: 16 / 9; border-radius: var(--rayon-grand); overflow: hidden; background: var(--doux); }
  .ve__encart { position: absolute; right: 14px; bottom: 14px; width: min(42%, 250px); display: grid; gap: 6px; padding: 10px 12px 12px; border-radius: var(--rayon); background-color: var(--fond); box-shadow: var(--ombre); }
  @media (min-width: 960px) {
    .ve__encart { right: auto; left: -28px; bottom: 28px; width: min(40%, 260px); }
  }
  @media (max-width: 520px) {
    .ve__encart { width: 46%; padding: 8px 9px 9px; }
  }
</style>
